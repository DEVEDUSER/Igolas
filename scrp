-- Unboxing Ultra Collector v2.0.0 - read-only data collector (single file, generated by tools/build.js)
-- Do not edit: edit src/*.lua and rebuild. Plain Lua syntax for mobile executors.
local Modules = {}
local cache = {}
local Core
local function R(name)
	local hit = cache[name]
	if hit ~= nil then return hit end
	if name == "Core" then return Core end
	local factory = Modules[name]
	if not factory then error("modulo ausente: " .. tostring(name)) end
	local result = factory(Core, R)
	cache[name] = result
	return result
end

Modules["AnimationObserver"] = function(...)
-- AnimationObserver: which animation TRACKS the local character plays (name, length, priority, looped, speed) and which visual effects appear.
-- Animation ids, files, sounds and textures are NOT read or copied.
local Core, R = ...
local U = R("Util")
local Exporter = R("DataExporter")
local A = {}

A.tracks = {}      -- track name -> { count, length, priority, looped, speed, first_seen }
A.effects = {}     -- class|name -> { count, ... }
A.running = false
A.conns = {}

local function noteTrack(track)
	local name = track.Name
	local rec = A.tracks[name]
	if not rec then
		rec = { name = name, count = 0, length = U.num(U.get(track, "Length")), priority = U.enumName(U.get(track, "Priority")), looped = U.get(track, "Looped"), speed = U.num(U.get(track, "Speed")), first_seen = U.nowIso(), note = "animation id deliberately not read" }
		A.tracks[name] = rec
	end
	rec.count = rec.count + 1
	local okI, I = pcall(R, "InteractionObserver")
	if okI then I.record("animation_played", { track = name, length = rec.length, priority = rec.priority }, "animation_observer") end
end

local function hookCharacter(char)
	local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 5)
	if not hum then return end
	local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 5)
	if animator then
		A.conns[#A.conns + 1] = animator.AnimationPlayed:Connect(function(track) pcall(noteTrack, track) end)
	end
end

local EFFECT_CLASSES = { ParticleEmitter = true, Beam = true, Trail = true, Sparkles = true, Fire = true, Smoke = true, Explosion = true }
local function noteEffect(d)
	local key = d.ClassName .. "|" .. d.Name
	local rec = A.effects[key]
	if not rec then
		rec = { class = d.ClassName, name = d.Name, count = 0, first_seen = U.nowIso(), first_path = U.path(d), enabled_when_seen = U.get(d, "Enabled") }
		if d:IsA("ParticleEmitter") then
			rec.rate = U.num(d.Rate) rec.lifetime = { U.num(d.Lifetime.Min), U.num(d.Lifetime.Max) } rec.speed = { U.num(d.Speed.Min), U.num(d.Speed.Max) }
		end
		A.effects[key] = rec
	end
	rec.count = rec.count + 1
end

function A.start()
	if A.running then return end
	A.running = true
	local lp = Core.LocalPlayer
	if lp then
		if lp.Character then task.spawn(hookCharacter, lp.Character) end
		A.conns[#A.conns + 1] = lp.CharacterAdded:Connect(function(c) task.spawn(hookCharacter, c) end)
	end
	-- effects that APPEAR after the tool started (attack hits, box breaks, hatches)
	A.conns[#A.conns + 1] = Core.Workspace.DescendantAdded:Connect(function(d)
		if EFFECT_CLASSES[d.ClassName] then pcall(noteEffect, d) end
	end)
end
function A.stop()
	A.running = false
	for _, c in ipairs(A.conns) do pcall(function() c:Disconnect() end) end
	A.conns = {}
end

function A.write()
	local tracks, effects = {}, {}
	for _, v in pairs(A.tracks) do tracks[#tracks + 1] = v end
	for _, v in pairs(A.effects) do effects[#effects + 1] = v end
	if #tracks == 0 and #effects == 0 then return end
	Exporter.writeJson("Observations/animations_effects_" .. tostring(Exporter.session) .. ".json", {
		collector_version = Core.Config.Version, session = Exporter.session, kind = "animation_effect_observation", tracks = tracks, effects_appeared = effects,
		notes = { "only the local player's own animations are observable from the client", "effects listed are those that appeared while the observer was running" },
	}, { kind = "animations", overwrite = true })
end

return A
end

Modules["AreaCollector"] = function(...)
-- AreaCollector: assigns every measured object to a world / area / lobby, accumulates bounding boxes and writes the per-area files
--   Worlds/<World>/Areas/<Area>/geometry.json, objects.json, shops.json, boxes.json, eggs.json, chests.json, portals.json, machines.json, decoration.json
-- Files from earlier sessions are merged (union by object id), never replaced silently.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local A = {}

A.stats = {}     -- key -> stats table
A.order = {}     -- keys in discovery order
local ctxCache = setmetatable({}, { __mode = "k" })

local WORLD_ROOT = "Worlds"

local function folderName(s) return U.sanitize(s) end

-- context of an instance, derived from its place in the hierarchy (no guessing: names are copied as found)
function A.contextOf(inst)
	local parent = inst.Parent
	if parent and ctxCache[parent] then return ctxCache[parent] end
	local names = {}
	local cur = parent
	local guard = 0
	while cur and cur ~= game and guard < 60 do
		table.insert(names, 1, cur.Name)
		cur = cur.Parent
		guard = guard + 1
	end
	-- names[1] is the service ("Workspace")
	local ctx = { world = nil, area = nil, zone = "workspace_misc", dir = WORLD_ROOT .. "/_unassigned" }
	if names[1] == "Workspace" and names[2] == "Worlds" and names[3] then
		ctx.world = names[3]
		ctx.zone = "world_misc"
		ctx.dir = WORLD_ROOT .. "/" .. folderName(ctx.world)
		local fourth = names[4]
		if fourth == "Areas" or fourth == "EventAreas" then
			if names[5] then
				ctx.area = names[5]
				ctx.zone = "area"
				ctx.dir = ctx.dir .. "/Areas/" .. folderName(ctx.area)
			end
		elseif fourth == "Lobby" then
			ctx.zone = "lobby"
			ctx.dir = ctx.dir .. "/lobby"
		end
	end
	ctx.key = (ctx.world or "_unassigned") .. "/" .. (ctx.area or ctx.zone)
	if parent then ctxCache[parent] = ctx end
	return ctx
end

local function statsFor(ctx)
	local s = A.stats[ctx.key]
	if not s then
		s = { key = ctx.key, world = ctx.world, area = ctx.area, zone = ctx.zone, dir = ctx.dir, parts = 0, models = 0, objects = {},
			min = { math.huge, math.huge, math.huge }, max = { -math.huge, -math.huge, -math.huge }, largest = nil }
		A.stats[ctx.key] = s
		A.order[#A.order + 1] = ctx.key
	end
	return s
end

function A.observePart(part, ctx)
	local s = statsFor(ctx)
	s.parts = s.parts + 1
	local ok, x0, y0, z0, x1, y1, z1 = pcall(U.aabb, part.CFrame, part.Size)
	if ok then
		if x0 < s.min[1] then s.min[1] = x0 end
		if y0 < s.min[2] then s.min[2] = y0 end
		if z0 < s.min[3] then s.min[3] = z0 end
		if x1 > s.max[1] then s.max[1] = x1 end
		if y1 > s.max[2] then s.max[2] = y1 end
		if z1 > s.max[3] then s.max[3] = z1 end
	end
	local vol = part.Size.X * part.Size.Y * part.Size.Z
	if not s.largest or vol > s.largest.vol then
		s.largest = { vol = vol, name = part.Name, cf = U.cf(part.CFrame), size = U.v3(part.Size) }
	end
end

function A.addObject(row, ctx)
	local s = statsFor(ctx)
	s.models = s.models + 1
	s.objects[#s.objects + 1] = row
end

-- ---------------------------------------------------------------- merge with previous sessions
local function readDoc(rel)
	local text = Exporter.FS.read(Core.Config.Root .. "/" .. rel)
	if not text then return nil end
	local ok, doc = pcall(function() return Core.HttpService:JSONDecode(text) end)
	if ok then return doc end
	return nil
end

local GROUPS = {
	shops = { weapon_stand = true, shop = true },
	boxes = { box = true, gift = true },
	eggs = { egg = true },
	chests = { chest = true },
	portals = { portal = true },
	machines = { machine = true },
	decoration = { decoration = true, tree = true, rock = true, building = true, scenery = true },
}

local function center(s)
	return { (s.min[1] + s.max[1]) / 2, (s.min[2] + s.max[2]) / 2, (s.min[3] + s.max[3]) / 2 }
end

function A.writeFor(s)
	if s.parts == 0 and #s.objects == 0 then return end
	local hasBox = s.min[1] ~= math.huge
	local c = hasBox and center(s) or nil
	local geometry = {
		collector_version = Core.Config.Version, session = Exporter.session, world = s.world, area = s.area, zone = s.zone, key = s.key,
		bbox = hasBox and { min = { U.num(s.min[1]), U.num(s.min[2]), U.num(s.min[3]) }, max = { U.num(s.max[1]), U.num(s.max[2]), U.num(s.max[3]) } } or "unknown",
		center = c and { U.num(c[1]), U.num(c[2]), U.num(c[3]) } or "unknown",
		length_x = hasBox and U.num(s.max[1] - s.min[1]) or "unknown", height_y = hasBox and U.num(s.max[2] - s.min[2]) or "unknown", width_z = hasBox and U.num(s.max[3] - s.min[3]) or "unknown",
		parts_measured = s.parts, models_measured = s.models,
		orientation = s.largest and { source = "largest part of the region (heuristic)", part = s.largest.name, cf = s.largest.cf, size = s.largest.size } or "unknown",
		notes = { "bbox is computed from the parts loaded by the client; parts that were not streamed in are not included", "rotation of the region itself is not defined by the game: see 'orientation' for the largest part" },
	}
	-- merge geometry with an earlier session: the union of both boxes
	local oldGeo = readDoc(s.dir .. "/geometry.json")
	if oldGeo and type(oldGeo.bbox) == "table" and type(geometry.bbox) == "table" then
		for i = 1, 3 do
			geometry.bbox.min[i] = math.min(geometry.bbox.min[i], oldGeo.bbox.min[i])
			geometry.bbox.max[i] = math.max(geometry.bbox.max[i], oldGeo.bbox.max[i])
		end
		geometry.center = { U.num((geometry.bbox.min[1] + geometry.bbox.max[1]) / 2), U.num((geometry.bbox.min[2] + geometry.bbox.max[2]) / 2), U.num((geometry.bbox.min[3] + geometry.bbox.max[3]) / 2) }
		geometry.length_x = U.num(geometry.bbox.max[1] - geometry.bbox.min[1])
		geometry.height_y = U.num(geometry.bbox.max[2] - geometry.bbox.min[2])
		geometry.width_z = U.num(geometry.bbox.max[3] - geometry.bbox.min[3])
		geometry.merged_with_sessions = oldGeo.merged_with_sessions or {}
		table.insert(geometry.merged_with_sessions, oldGeo.session)
		geometry.parts_measured = geometry.parts_measured + (oldGeo.parts_measured or 0)
	end
	Exporter.writeJson(s.dir .. "/geometry.json", geometry, { versioned = true, kind = "area_geometry" })

	local centerVec = geometry.center ~= "unknown" and geometry.center or nil
	local rows = {}
	for _, o in ipairs(s.objects) do
		local row = {}
		for k, v in pairs(o) do row[k] = v end
		if centerVec and o.pos then row.pos_rel_to_area_center = { U.num(o.pos[1] - centerVec[1]), U.num(o.pos[2] - centerVec[2]), U.num(o.pos[3] - centerVec[3]) } end
		row.first_seen_session = Exporter.session
		rows[#rows + 1] = row
	end
	local function mergeAndWrite(rel, newRows, kind)
		local merged, seen = {}, {}
		local old = readDoc(rel)
		if old and type(old.objects) == "table" then
			for _, o in ipairs(old.objects) do
				merged[#merged + 1] = o
				if o.id then seen[o.id] = true end
			end
		end
		local added = 0
		for _, o in ipairs(newRows) do
			if not (o.id and seen[o.id]) then
				merged[#merged + 1] = o
				added = added + 1
			end
		end
		Exporter.writeJson(rel, { collector_version = Core.Config.Version, session = Exporter.session, kind = kind, key = s.key, count = #merged, added_this_session = added, objects = merged }, { versioned = true, kind = kind, records = #merged })
	end
	mergeAndWrite(s.dir .. "/objects.json", rows, "area_objects")
	for fileName, cats in pairs(GROUPS) do
		local subset = {}
		for _, o in ipairs(rows) do if cats[o.category] then subset[#subset + 1] = o end end
		if #subset > 0 then mergeAndWrite(s.dir .. "/" .. fileName .. ".json", subset, "area_" .. fileName) end
	end
end

function A.finalize()
	for _, key in ipairs(A.order) do
		local ok, err = pcall(A.writeFor, A.stats[key])
		if not ok then Core.err("area " .. key .. ": " .. tostring(err)) end
	end
end

function A.reset()
	A.stats, A.order = {}, {}
	ctxCache = setmetatable({}, { __mode = "k" })
end

return A

end


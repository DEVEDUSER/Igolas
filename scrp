local function collectMerchantItems(data, found)
    found = found or {}

    if type(data) ~= "table" then
        return found
    end

    local itemId = data.ItemId or data.ItemID or data.Id or data.ID

    if itemId then
        table.insert(found, data)
    end

    for _, v in pairs(data) do
        if type(v) == "table" then
            collectMerchantItems(v, found)
        end
    end

    return found
end

local function merchantItemAvailable(item)
    if type(item) ~= "table" then return false end

    if item.SoldOut == true then return false end
    if item.IsSoldOut == true then return false end
    if item.Purchased == true then return false end
    if item.Bought == true then return false end

    local stock = item.Stock or item.Amount or item.Quantity or item.Remaining or item.Left

    if stock ~= nil and tonumber(stock) ~= nil and tonumber(stock) <= 0 then
        return false
    end

    return true
end

local function shouldBuyMerchantItem(item)
    local itemId = tostring(item.ItemId or item.ItemID or item.Id or item.ID or "")
    local lower = string.lower(itemId)

    if itemId == "" then return false end

    if merchantAutoBuyAllCrates and lower:find("crate") then
        return true
    end

    return merchantSelectedItems[itemId] == true
end

local function merchantSignature(item)
    local itemId = tostring(item.ItemId or item.ItemID or item.Id or item.ID or "")
    local stock = tostring(item.Stock or item.Amount or item.Quantity or item.Remaining or item.Left or "")
    local price = tostring(item.Price or item.Cost or item.CostAmount or "")
    local reset = tostring(item.RefreshAt or item.ResetAt or item.RestockAt or "")

    return itemId .. "|" .. stock .. "|" .. price .. "|" .. reset
end

local function buyMerchantSelectedOnce()
    local data = getMerchantData()
    if not data then return end

    local items = collectMerchantItems(data)

    for _, item in ipairs(items) do
        local itemId = tostring(item.ItemId or item.ItemID or item.Id or item.ID or "")

        if itemId ~= "" and merchantItemAvailable(item) and shouldBuyMerchantItem(item) then
            local sig = merchantSignature(item)

            if not merchantBoughtCache[sig] then
                merchantBoughtCache[sig] = true

                task.spawn(function()
                    local ok = pcall(function()
                        RF.PurchaseMerchantItem:InvokeServer({
                            ItemId = itemId,
                            MerchantId = "MoleMerchant",
                        })
                    end)

                    if ok then
                        Stats.merchantBought += 1
                    end
                end)
            end
        end
    end
end

local function sendWebhook(message)
    if webhookUrl == "" then
        notify("Webhook", "Coloque a URL primeiro.", 3)
        return
    end

    local req = http_request or request or syn and syn.request or fluxus and fluxus.request

    if not req then
        notify("Webhook", "Executor sem request/http_request.", 4)
        return
    end

    pcall(function()
        req({
            Url = webhookUrl,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = HttpService:JSONEncode({ content = tostring(message) }),
        })
    end)
end

local function buildWebhookReport()
    local lines = {}

    table.insert(lines, "Unboxing Hub - Relatorio")
    table.insert(lines, "Player: " .. tostring(player.Name))
    table.insert(lines, "Tempo: " .. formatTime(os.clock() - Stats.startedAt))
    table.insert(lines, "Easter Rush: " .. tostring(Stats.rushesByName["Easter Rush"] or 0))
    table.insert(lines, "Gold Rush: " .. tostring(Stats.rushesByName["Gold Rush"] or 0))
    table.insert(lines, "Caixas quebradas: " .. tostring(Stats.boxesBroken))
    table.insert(lines, "Crates abertas: " .. tostring(Stats.cratesOpened))
    table.insert(lines, "EggRain: " .. tostring(Stats.eggRainGained))
    table.insert(lines, "BombRain: " .. tostring(Stats.bombRainGained))
    table.insert(lines, "Tickets: " .. tostring(Stats.ticketsGained))
    table.insert(lines, "Merchant comprados: " .. tostring(Stats.merchantBought))
    table.insert(lines, "Vendidos: " .. tostring(Stats.itemsSold))
    table.insert(lines, "Hats vendidos: " .. tostring(Stats.hatsSold))
    table.insert(lines, "Pets vendidos: " .. tostring(Stats.petsSold))
    table.insert(lines, "Perks vendidos: " .. tostring(Stats.perksSold))
    table.insert(lines, "Crates:")

    local hasCrate = false

    for crateName, count in pairs(Stats.cratesByName) do
        hasCrate = true
        table.insert(lines, "- " .. tostring(crateName) .. ": " .. tostring(count))
    end

    if not hasCrate then
        table.insert(lines, "- nenhuma")
    end

    return table.concat(lines, "\n")
end


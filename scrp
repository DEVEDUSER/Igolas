-- toggles the damage session; returns "started" / "stopped"
function Main.ops.damage(note)
	local D = R("DamageObserver")
	if D.isActive() then
		local ok, res = D.stop()
		return ok, res, "stopped"
	end
	local ok, res = D.start({ note = note })
	return ok, res, "started"
end

function Main.ops.event(kind, text)
	local I = R("InteractionObserver")
	local data = { note = text }
	-- "hatch: Egg Name = Result" feeds the sampled egg statistics (manual, never automatic)
	local egg, result = tostring(text or ""):match("^%s*(.-)%s*=%s*(.-)%s*$")
	if kind == "hatch" and egg and result and egg ~= "" and result ~= "" then data = { egg = egg, result = result, note = text } end
	return I.record(kind or "manual", data, "manual")
end


local function ancestorTokens(inst, n)
	local tok, names = {}, {}
	local cur, i = inst, 0
	while cur and i <= n and cur ~= PlayerGui and cur ~= game do
		for t in pairs(Tok.of(cur.Name)) do tok[t] = true end
		names[#names + 1] = cur.Name
		cur = cur.Parent
		i = i + 1
	end
	return tok, names
end


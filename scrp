addModule("interface", function(inst, ctx)
	if ctx.rootTag ~= "playergui" then return end
	local isLayer = inst:IsA("LayerCollector")
	if not (ctx.isGuiObj or isLayer) then return end
	local P = { class = ctx.cls, path = ctx:path() }
	if ctx.phase == "dynamic" then P.loaded_dynamically = true else P.loaded_dynamically = false end
	if isLayer then
		P.role_guess = "screen_gui"
		P.enabled = get(inst, "Enabled")
		P.display_order = get(inst, "DisplayOrder")
		P.reset_on_spawn = get(inst, "ResetOnSpawn")
	else
		P.visible = get(inst, "Visible")
		P.effective_visible = Hooks.effectiveVisible(inst)
		P.position = plain(get(inst, "Position"))
		P.size = plain(get(inst, "Size"))
		P.absolute_position = plain(get(inst, "AbsolutePosition"))
		P.absolute_size = plain(get(inst, "AbsoluteSize"))
		P.z_index = get(inst, "ZIndex")
		P.layout_order = get(inst, "LayoutOrder")
		P.background_color = plain(get(inst, "BackgroundColor3"))
		P.background_transparency = plain(get(inst, "BackgroundTransparency"))
		local role = "frame"
		if inst:IsA("GuiButton") then role = "button"
		elseif ctx.isText then role = "text"
		elseif inst:IsA("ImageLabel") then role = "image"
		elseif inst:IsA("ScrollingFrame") then role = "scroll" end
		P.role_guess = role
		if ctx.isText then
			P.text = trunc(tostring(get(inst, "Text") or ""))
			P.text_color = plain(get(inst, "TextColor3"))
		end
		if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
			P.image = plain(get(inst, "Image"))
			P.image_color = plain(get(inst, "ImageColor3"))
		end
		if role == "button" and hit(ctx.nameTok, KW.tab) then P.tab_guess = true end
		if hit(ctx.nameTok, KW.menu) then P.menu_guess = hit(ctx.nameTok, KW.menu) end
	end
	local a = ctx:attrs()
	if next(a) ~= nil then P.attributes = a end
	local rec = Store.upsert("ui", inst, inst.Name, P, "client_instance:" .. P.path .. " (" .. ctx.phase .. ")", "high")
	if rec then Watch.ui(inst, rec, ctx) end
end)


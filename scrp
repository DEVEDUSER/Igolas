local tokCache, tokN = {}, 0
local function sing(w)
	if #w > 3 then
		if w:sub(-3) == "xes" or w:sub(-4) == "ches" or w:sub(-4) == "shes" then return w:sub(1, -3) end
		if w:sub(-1) == "s" and w:sub(-2) ~= "ss" then return w:sub(1, -2) end
	end
	return w
end
Util.sing = sing

function Tok.of(name)
	local c = tokCache[name]
	if c then return c end
	local s = tostring(name)
	s = s:gsub("(%l)(%u)", "%1 %2")
	s = s:gsub("(%u)(%u%l)", "%1 %2")
	local out = {}
	for w in s:lower():gmatch("%a+") do out[sing(w)] = true end
	tokN = tokN + 1
	if tokN > 6000 then tokCache = {}; tokN = 0 end
	tokCache[name] = out
	return out
end


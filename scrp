		P.observed_lifetime_seconds = NO
		P.observed_time_to_destroy_seconds = NO
		P.destroyed_observed = false
		P.lifetime_basis = "since_first_observed_by_this_client"
		P.state_changes = L({})
	end,
})

function Boxes.onChange(rec, oldHealth, what, old, new)
	local P = rec.properties
	local a = Store.aux[rec]
	local st = P.state_changes
	if type(st) == "table" and #st < 40 then
		st[#st + 1] = { session_seconds = r2(clock() - Session.t0), what = what, old = plain(old), new = plain(new), health = P.health_current }
	end
	local nh = P.health_current
	if type(nh) == "number" and a then
		local dropped = (type(oldHealth) == "number" and nh < oldHealth) or (type(P.health_max) == "number" and nh < P.health_max)
		if dropped and not a.t_damage then
			a.t_damage = clock()
			P.first_damage_seen_session_seconds = r2(a.t_damage - Session.t0)
		end
	end
end

function Boxes.onRemoved(rec, tRemoved)
	local P = rec.properties
	local a = Store.aux[rec]
	P.destroyed_observed = true
	if a then
		P.observed_lifetime_seconds = r2(tRemoved - a.t_first)
		if a.t_damage then P.observed_time_to_destroy_seconds = r2(tRemoved - a.t_damage) end
	end
end


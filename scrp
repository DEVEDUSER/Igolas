	pcall(function()
		if CAP.isfolder then
			if not isfolder(CFG.OUT) then makefolder(CFG.OUT) end
			if not isfolder(dir) then makefolder(dir) end
		else
			makefolder(CFG.OUT); makefolder(dir)
		end
	end)
end
local function doExport(silent)
	if exporting then return end
	exporting = true
	local files = Core.planFiles(D, SID, summaryDoc())
	local dir = CFG.OUT .. "/" .. SID
	local okCount, bad, printed = 0, 0, 0
	if CAP.writefile then
		ensureDirs(dir)
		for _, f in ipairs(files) do
			if f.static and exportedStatic[f.name] then
				okCount = okCount + 1 -- final file already written and verified
			else
				local js, err = encode(f.doc)
				if not js then
					bad = bad + 1
					Stats.write_errors[#Stats.write_errors + 1] = f.name .. ": encode " .. tostring(err)
				else
					local okw, errw = pcall(function() writefile(dir .. "/" .. f.name, js) end)
					if not okw then
						bad = bad + 1
						Stats.write_errors[#Stats.write_errors + 1] = f.name .. ": " .. tostring(errw)
					else
						local verified = true
						if CAP.readfile then
							local okr, back = pcall(function() return readfile(dir .. "/" .. f.name) end)
							verified = okr and type(back) == "string" and #back == #js
						end
						if verified then
							okCount = okCount + 1
							if f.static then exportedStatic[f.name] = true end
						else
							bad = bad + 1
							Stats.write_errors[#Stats.write_errors + 1] = f.name .. ": readback differs"
						end
					end
				end
			end
			Stats.writes = Stats.writes + 1
			slice()
		end
	else
		for _, f in ipairs(files) do
			local js = encode(f.doc)
			if js and printed < 200 then
				local n = math.ceil(#js / 3500)
				for i = 1, n do
					if printed < 200 then
						print("UBG|" .. f.name .. "|" .. i .. "/" .. n .. "|" .. string.sub(js, (i - 1) * 3500 + 1, i * 3500))
						printed = printed + 1
					end
				end
			end
		end
	end
	lastExportCount = totalCount()
	Stats.lastSave = os.clock()
	exporting = false
	if CAP.writefile then
		if not silent or bad > 0 then log("salvo: " .. okCount .. "/" .. #files .. " arquivos em " .. dir .. (bad > 0 and (" | falhas: " .. bad) or "")) end
	else
		log("sem writefile: " .. printed .. " linhas UBG| no console (limite 200)")
	end
	refreshGui()
end


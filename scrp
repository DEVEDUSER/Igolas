	TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left }, main)
local logLabel = mk("TextLabel", { Position = UDim2.fromOffset(8, 104), Size = UDim2.new(1, -16, 1, -112), BackgroundColor3 = PANEL, BorderSizePixel = 0,
	TextColor3 = Color3.fromRGB(215, 220, 235), Font = Enum.Font.Gotham, TextSize = 12, TextWrapped = true, Text = "pronto. Abra os menus do jogo e toque em MEDIR TUDO.",

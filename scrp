local function safeFileName(name)
    name = tostring(name or "Save1")
    name = name:gsub("[^%w_%-%s]", "")
    if name == "" then name = "Save1" end
    return name
end

local function ensureSaveFolder()
    if makefolder then
        pcall(function()
            if not isfolder("UnboxingHub") then makefolder("UnboxingHub") end
            if not isfolder(saveFolder) then makefolder(saveFolder) end
        end)
    end
end

local function getSavePath(name)
    return saveFolder .. "/" .. safeFileName(name) .. ".json"
end

local function buildSaveData()
    return {
        State = State,
        sellRarities = sellRarities,
        crateAmount = crateAmount,
        autoRushWorld = autoRushWorld,
        autoAttackDelay = autoAttackDelay,
        autoSellDelay = autoSellDelay,
        webhookUrl = webhookUrl,
        webhookDelayMinutes = webhookDelayMinutes,
        autoFavoriteRareDrops = autoFavoriteRareDrops,
        autoFavoriteGoodPerks = autoFavoriteGoodPerks,
        perkFavoriteMinStat = perkFavoriteMinStat,
        wheelDelay = wheelDelay,
        wheelBurst = wheelBurst,
        selectedWheelId = selectedWheelId,
        farmAreaIndex = farmAreaIndex,
        farmAreaRadius = farmAreaRadius,
        farmAreaStep = farmAreaStep,
    }
end

local function applySaveData(data)
    if type(data) ~= "table" then return end

    if type(data.State) == "table" then
        for k, v in pairs(data.State) do
            if State[k] ~= nil then State[k] = v end
        end
    end

    if type(data.sellRarities) == "table" then
        for category, rarities in pairs(data.sellRarities) do
            if sellRarities[category] and type(rarities) == "table" then
                for rarity, value in pairs(rarities) do
                    if sellRarities[category][rarity] ~= nil then
                        sellRarities[category][rarity] = value
                    end
                end
            end
        end
    end

    crateAmount = tonumber(data.crateAmount) or crateAmount
    autoRushWorld = tonumber(data.autoRushWorld) or autoRushWorld
    autoAttackDelay = tonumber(data.autoAttackDelay) or autoAttackDelay
    autoSellDelay = tonumber(data.autoSellDelay) or autoSellDelay
    webhookUrl = tostring(data.webhookUrl or webhookUrl)
    webhookDelayMinutes = tonumber(data.webhookDelayMinutes) or webhookDelayMinutes
    autoFavoriteRareDrops = data.autoFavoriteRareDrops == true
    autoFavoriteGoodPerks = data.autoFavoriteGoodPerks == true
    perkFavoriteMinStat = tonumber(data.perkFavoriteMinStat) or perkFavoriteMinStat
    wheelDelay = tonumber(data.wheelDelay) or wheelDelay
    wheelBurst = tonumber(data.wheelBurst) or wheelBurst
    selectedWheelId = tostring(data.selectedWheelId or selectedWheelId)
    farmAreaIndex = tonumber(data.farmAreaIndex) or farmAreaIndex
    farmAreaRadius = tonumber(data.farmAreaRadius) or farmAreaRadius
    farmAreaStep = tonumber(data.farmAreaStep) or farmAreaStep
end

local function saveProfile(name)
    if not writefile then
        notify(I.save .. " Save", "Executor nao suporta writefile.", 4)
        return
    end

    ensureSaveFolder()

    local ok, err = pcall(function()
        writefile(getSavePath(name), HttpService:JSONEncode(buildSaveData()))
    end)

    if ok then
        notify(I.save .. " Save", "Config salva: " .. safeFileName(name), 3)
    else
        notify(I.x .. " Save", "Erro: " .. tostring(err), 4)
    end
end

local function loadProfile(name)
    if not readfile or not isfile then
        notify(I.save .. " Save", "Executor nao suporta readfile/isfile.", 4)
        return
    end

    local path = getSavePath(name)

    if not isfile(path) then
        notify(I.x .. " Save", "Nao encontrado: " .. safeFileName(name), 4)
        return
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)

    if ok and type(data) == "table" then
        applySaveData(data)
        notify(I.check .. " Save", "Config carregada: " .. safeFileName(name), 3)
    else
        notify(I.x .. " Save", "Erro ao carregar.", 4)
    end
end


	for i = 1, math.min(15, #g) do out[#out + 1] = string.format("  [%s] %s", tostring(g[i].area), g[i].displayed_text) end
	out[#out + 1] = "Rebirth: nunca executado; so o texto do menu Rebirth, se voce o abrir (MEDIR UI)."
	return lines(out)
end
RENDER.ui = function()
	local UIc = R("UICollector")

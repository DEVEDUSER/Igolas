		for i, id in ipairs(tab.actions) do
			local b = mk("TextButton", { LayoutOrder = i, BackgroundColor3 = ACCENT, Text = BUTTON_LABEL[id] or id, TextColor3 = TEXT, Font = Enum.Font.GothamBold, TextSize = 12, TextWrapped = true }, actions)

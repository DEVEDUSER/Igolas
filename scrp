local TABS = {
	{ "Buscar", "search" }, { "Console", "console" }, { "Estrutura", "objects" }, { "Mundos", "worlds" }, { "Caixas", "boxes" }, { "Armas", "weapons" },
	{ "Pets", "pets" }, { "Ovos", "eggs" }, { "Economia", "economy" }, { "Progress\u{E3}o", "progression" },
	{ "Invent\u{E1}rio", "inventory" }, { "Interface", "ui" }, { "Eventos", "observed_events" },
}
local SUMMARY_KEYS = {
	boxes = { "health_current", "health_max", "world_kind" }, weapons = { "damage", "rarity", "attack_speed" }, pets = { "rarity", "category" },
	eggs = { "price", "currency" }, worlds = { "world_kind", "unlock_requirements" }, economy = { "kind", "value", "text" },
	progression = { "kind", "value", "text" }, inventory = { "kind", "count_text", "value", "location" },
	ui = { "class", "text", "visible" }, objects = { "class", "kind" }, observed_events = { "event", "property", "old_value", "new_value" },
}

local function shortVal(v)
	local t = type(v)
	if t == "table" then return "{..}" end
	local s = tostring(v)
	if #s > 40 then s = s:sub(1, 37) .. "..." end
	return s
end

function GUI.lineFor(cat, rec)
	local P = rec.properties
	local bits = {}
	for _, k in ipairs(SUMMARY_KEYS[cat] or {}) do
		local v = P[k]
		if v ~= nil and v ~= NO and v ~= NULL then bits[#bits + 1] = k .. "=" .. shortVal(v) end
	end
	local nm = rec.name
	if #nm > 32 then nm = nm:sub(1, 29) .. "..." end
	return string.format("%s %s | %s | %s", rec.id, nm, rec.confidence, table.concat(bits, " "))
end

function GUI.render()
	local g = GUI.refs
	if not g or not g.main.Visible then return end
	local S = Session
	local total = Store.total()
	local filled = Store.filled()
	local pct = 0
	if S.scanState == "complete" then pct = 1 elseif S.scanState == "scanning" then pct = math.min(S.stats.visited / math.max(S.stats.total, 1), 0.99) end
	g.fill.Size = UDim2.new(pct, 0, 1, 0)
	local phase = S.scanState == "complete" and "monitorando" or (S.scanState == "scanning" and "escaneando" or S.scanState)
	g.progress.Text = string.format("%s %d%%  (estado: %s)", phase, floor(pct * 100), S.state)
	if Dump.busy then
		g.fill.Size = UDim2.new(math.min(Dump.nodes / math.max(Dump.total, 1), 0.99), 0, 1, 0)
		g.progress.Text = string.format("salvando \u{E1}rvore: %d/~%d n\u{F3}s, %d arquivo(s)", Dump.nodes, Dump.total, Dump.files)
	end
	g.stats.Text = string.format("Objetos registrados: %d | Categorias preenchidas: %d/%d | Eventos: %d | Watchers: %d", total, filled, #DATA_CATS,
		#Store.lists.observed_events, Watch.count)
	if GUI.tab == "search" then return end
	local lines = {}
	if GUI.tab == "console" then
		local from = math.max(1, #Log.lines - 80)
		for i = from, #Log.lines do lines[#lines + 1] = Log.lines[i] end
	else
		local list = Store.lists[GUI.tab]
		lines[1] = string.format("%d registros (mostrando os %d mais recentes)", #list, math.min(#list, 70))
		for i = #list, math.max(1, #list - 69), -1 do lines[#lines + 1] = GUI.lineFor(GUI.tab, list[i]) end
	end
	local text = table.concat(lines, "\n")
	if #text > 15000 then text = text:sub(1, 15000) end
	g.body.Text = text
end


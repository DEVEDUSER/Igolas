local Watch = { count = 0, last = {}, seen = {} }
local WATCH_WORDS = { "wallet", "currenc", "weather", "boost", "quest", "rebirth", "event", "multiplier", "luck", "gem", "coin", "ticket", "candy", "damage" }
local function parsedPair(old, new)
	local po, pn = U.parseDisplay(old, Stats.suffix_seen), U.parseDisplay(new, Stats.suffix_seen)
	return { o = po and po.approx, n = pn and pn.approx }
end
local function registerText(label)
	if Watch.seen[label] or Watch.count >= CFG.WATCH_CAP or isMine(label) then return end
	Watch.seen[label] = true
	Watch.count = Watch.count + 1
	local key = relPath(label, PlayerGui)
	local old = rd(label, "Text")
	Watch.last[key] = U.clean(old)
	connect(label:GetPropertyChangedSignal("Text"), function()
		local new = rd(label, "Text")
		if new ~= old then
			Ledger.add("hud", key, U.clean(old), U.clean(new), { a = parsedPair(old, new), pos = rootPos() })
			old = new
			Watch.last[key] = U.clean(new)
		end
	end)
end
local function labelMatches(inst)
	local cur, n = inst, 0
	while cur and cur ~= PlayerGui and n < 9 do
		local nm = string.lower(cur.Name)
		for _, w in ipairs(WATCH_WORDS) do
			if string.find(nm, w, 1, true) then return true end
		end
		cur = cur.Parent; n = n + 1
	end
	return false
end
local function registerValue(vo)
	if Watch.seen[vo] or Watch.count >= CFG.WATCH_CAP then return end
	Watch.seen[vo] = true
	Watch.count = Watch.count + 1
	local key = "player." .. relPath(vo, LocalPlayer)
	local old = rd(vo, "Value")
	Watch.last[key] = U.encodeSimple(old)
	connect(vo:GetPropertyChangedSignal("Value"), function()
		local new = rd(vo, "Value")
		Ledger.add("value", key, U.encodeSimple(old), U.encodeSimple(new), { pos = rootPos() })
		old = new
		Watch.last[key] = U.encodeSimple(new)
	end)
end
local function scanWatchers()
	for _, d in ipairs(LocalPlayer:GetDescendants()) do
		if d:IsA("ValueBase") then registerValue(d) end
		slice()
	end
	for _, d in ipairs(PlayerGui:GetDescendants()) do
		if d:IsA("TextLabel") and labelMatches(d) then registerText(d) end
		slice()
	end
end
local evalGui -- forward declaration: defined in the boxes section
local playerAttrOld = {}
local function startPlayerAttrs()
	for k, v in pairs(LocalPlayer:GetAttributes()) do playerAttrOld[k] = v end
	connect(LocalPlayer.AttributeChanged, function(name)
		local new = LocalPlayer:GetAttribute(name)

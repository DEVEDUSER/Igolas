local exporting, lastExportCount = false, -1
local exportedStatic = {}
local function totalCount()
	return #D.ui + #Ledger.events + #D.tags + #D.inputs + #D.boxes + Map.count + #D.board + boxTotal
end
local function summaryDoc()
	local check = {}
	for _, c in ipairs(CHECK) do
		local s = Core.checkState[c[1]]
		check[c[1]] = { label = c[2], done = Core.isDone(c[1]), auto_hits = s.auto, manual = s.manual, samples = s.samples }
	end
	return { started_clock0 = "os.clock()==0 at script start", exported = U.nowIso(), capabilities = CAP, config = CFG, checklist = check,
		counters = { ui_snapshots = #D.ui, ledger = #Ledger.events, ledger_dropped = Ledger.dropped, ledger_cap_hit = Ledger.capHit, tags = #D.tags, inputs = #D.inputs,
			boxes = #D.boxes, boxes_destroyed = destroyedCount, box_events = boxTotal, map_parts = Map.count, map_cap_hit = Map.capHit or false,
			prompts = #Map.prompts, board_texts = #D.board, watchers = Watch.count }, scans = Stats.scans, map_saturated_cells = Stats.map_saturated_cells or 0,
		suffix_seen_unknown_or_listed = Stats.suffix_seen, write_errors = Stats.write_errors,
		limitations = { "Only what this client displays or replicates is recorded; server rules are not visible.", "Streaming: only loaded parts are measured; walk each area.",
			"Asset ids (images, meshes, textures, sounds, animations) are never read.", "Rotation is Euler degrees (rx, ry, rz) from CFrame:ToOrientation." } }
end
local function encode(doc)
	local ok, js = pcall(function() return HttpService:JSONEncode(doc) end)
	if ok then return js end
	return nil, js
end
local function ensureDirs(dir)
	if not CAP.makefolder then return end
	pcall(function()
		if CAP.isfolder then
			if not isfolder(CFG.OUT) then makefolder(CFG.OUT) end
			if not isfolder(dir) then makefolder(dir) end
		else
			makefolder(CFG.OUT); makefolder(dir)
		end
	end)
end
local function doExport(silent)
	if exporting then return end
	exporting = true
	local files = Core.planFiles(D, SID, summaryDoc())
	local dir = CFG.OUT .. "/" .. SID
	local okCount, bad, printed = 0, 0, 0
	if CAP.writefile then
		ensureDirs(dir)
		for _, f in ipairs(files) do
			if f.static and exportedStatic[f.name] then
				okCount = okCount + 1 -- immutable UI snapshot already written and verified
			else
				local js, err = encode(f.doc)
				if not js then
					bad = bad + 1
					Stats.write_errors[#Stats.write_errors + 1] = f.name .. ": encode " .. tostring(err)
				else
					local okw, errw = pcall(function() writefile(dir .. "/" .. f.name, js) end)
					if not okw then
						bad = bad + 1
						Stats.write_errors[#Stats.write_errors + 1] = f.name .. ": " .. tostring(errw)
					else
						local verified = true
						if CAP.readfile then
							local okr, back = pcall(function() return readfile(dir .. "/" .. f.name) end)
							verified = okr and type(back) == "string" and #back == #js
						end
						if verified then
							okCount = okCount + 1
							if f.static then exportedStatic[f.name] = true end
						else
							bad = bad + 1
							Stats.write_errors[#Stats.write_errors + 1] = f.name .. ": readback differs"
						end
					end
				end
			end
			Stats.writes = Stats.writes + 1
			slice()
		end
	else
		for _, f in ipairs(files) do
			local js = encode(f.doc)
			if js and printed < 200 then
				local n = math.ceil(#js / 3500)
				for i = 1, n do
					if printed < 200 then
						print("UBG|" .. f.name .. "|" .. i .. "/" .. n .. "|" .. string.sub(js, (i - 1) * 3500 + 1, i * 3500))
						printed = printed + 1
					end
				end
			end
		end
	end
	lastExportCount = totalCount()
	exporting = false
	if CAP.writefile then
		if not silent or bad > 0 then log("EXPORTAR: " .. okCount .. "/" .. #files .. " arquivos OK em " .. dir .. (bad > 0 and (" | falhas: " .. bad) or "")) end
	else
		log("Sem writefile: " .. printed .. " linhas UBG| no console (limite 200)")
	end
end
local function copySummary()
	if not CAP.setclipboard then log("setclipboard indisponivel"); return end
	local js = encode(summaryDoc())
	if js then pcall(function() setclipboard(js) end); log("resumo copiado (" .. #js .. " chars)") end
end


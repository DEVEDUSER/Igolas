Modules["ProgressionObserver"] = function(...)
-- ProgressionObserver: where the player is (area transitions), what area gates / locked signs SAY, and what the rebirth / level displays show.
-- Rebirth, unlocking and teleporting are NEVER executed.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local P = {}

P.transitions = {}
P.running = false
P.current = nil

-- smallest measured area box that contains the position
local function areaAt(pos)
	local A = R("AreaCollector")
	local best, bestVol = nil, math.huge
	for key, s in pairs(A.stats) do
		if s.min[1] ~= math.huge and s.zone ~= "workspace_misc" and s.zone ~= "world_misc" then
			if pos.X >= s.min[1] and pos.X <= s.max[1] and pos.Z >= s.min[3] and pos.Z <= s.max[3] then
				local vol = (s.max[1] - s.min[1]) * (s.max[3] - s.min[3])
				if vol < bestVol then best, bestVol = key, vol end
			end
		end
	end
	return best
end
P.areaAt = areaAt

function P.start()
	if P.running then return end
	P.running = true
	task.spawn(function()
		while P.running do
			local char = Core.LocalPlayer and Core.LocalPlayer.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			if root then
				local ok, key = pcall(areaAt, root.Position)
				if ok and key ~= P.current then
					P.transitions[#P.transitions + 1] = { t = U.nowIso(), from = P.current, to = key or "outside_measured_areas", position = U.v3(root.Position) }
					local okI, I = pcall(R, "InteractionObserver")
					if okI then I.record("area_changed", { from = P.current, to = key }, "progression") end
					P.current = key
				end
			end
			task.wait(0.5)
		end
	end)
end
function P.stop() P.running = false end

-- texts displayed by objects that look like gates / requirements / rebirth (copied, not interpreted)
function P.gateTexts()
	local out = {}
	local words = { "require", "unlock", "locked", "rebirth", "level", "need", "x%d" }
	for _, row in ipairs(Store.index.models or {}) do
		if row.gui_texts then
			for _, t in ipairs(row.gui_texts) do
				local l = string.lower(t)
				local hit = false
				for _, w in ipairs(words) do
					if string.find(l, w) then hit = true break end
				end
				if hit then out[#out + 1] = { object = row.name, path = row.path, area = row.area, position = row.pos, displayed_text = t } end
			end
		end
	end
	return out
end

function P.write()
	local doc = {
		collector_version = Core.Config.Version, session = Exporter.session, kind = "progression_observation",
		area_transitions = P.transitions, gate_and_requirement_texts = P.gateTexts(),
		unknown = { "unlock requirements that are not written anywhere on screen cannot be observed", "rebirth rules are only recorded as displayed text in the Rebirth menu (open it and run MEDIR UI)" },
		note = "nothing was unlocked, bought or rebirthed by this tool",
	}
	Exporter.writeJson("Observations/progression_" .. tostring(Exporter.session) .. ".json", doc, { kind = "progression", overwrite = true })
end

return P
end

Modules["SessionManager"] = function(...)
-- SessionManager: session id, restoring the state of previous sessions (visited cells, known record ids) and saving it incrementally.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local Session = {}

Session.id = nil
Session.startedAt = nil
Session.resumed = false
Session.previous = {}       -- list of previous session ids found in the state file
Session.history = {}        -- operations of this session { name, state, time }

local STATE_REL = "state/collection_state.json"
local function idsRel(cat) return "state/ids_" .. U.sanitize(cat) .. ".json" end

local function newId()
	return "S" .. tostring(os.time()) .. string.format("%03d", math.random(0, 999))
end

local function readJson(rel)
	local text = Exporter.FS.read(Core.Config.Root .. "/" .. rel)
	if not text then return nil end
	local ok, doc = pcall(function() return Core.HttpService:JSONDecode(text) end)
	if ok then return doc end
	Core.warn("arquivo de estado ilegivel: " .. rel)
	return nil
end

-- start a session. resume = true restores cells and ids from the previous export so a stopped collection can continue
-- and measurements from different sessions are merged without duplicates.
function Session.start(resume)
	Session.id = newId()
	Session.startedAt = U.nowIso()
	Session.resumed = false
	Session.previous = {}
	Exporter.session = Session.id
	if not resume then
		Core.info("sessao " .. Session.id .. " (nova coleta)")
		return Session.id
	end
	local state = readJson(STATE_REL)
	if not state then
		Core.info("sessao " .. Session.id .. " (nenhum estado anterior encontrado: coleta nova)")
		return Session.id
	end
	Session.resumed = true
	Session.previous = state.sessions or {}
	table.insert(Session.previous, state.last_session)
	for key, cell in pairs(state.cells or {}) do
		Store.cells[key] = { status = cell.status, parts = cell.parts or 0, restored = true }
	end
	local restored = 0
	for _, cat in ipairs(state.categories or {}) do
		local doc = readJson(idsRel(cat))
		if doc and type(doc.ids) == "table" then
			local set = Store.ids[cat] or {}
			Store.ids[cat] = set
			for _, id in ipairs(doc.ids) do
				set[id] = true
				restored = restored + 1
			end
			Store.restored[cat] = #doc.ids
		end
	end
	Core.info(string.format("sessao %s retomada: %d celulas e %d ids restaurados de %d sessao(oes) anteriores", Session.id, U.shallowCount(state.cells or {}), restored, #Session.previous))
	return Session.id
end

function Session.recordOperation(name, state)
	Session.history[#Session.history + 1] = { name = name, state = state, time = U.nowIso() }
end

-- saves the state needed to resume (cells + ids). Called after every flush.
function Session.saveState()
	if not Session.id then return end
	local cells = {}
	for key, c in pairs(Store.cells) do cells[key] = { status = c.status, parts = c.parts } end
	local cats = {}
	for cat, set in pairs(Store.ids) do
		local ids = {}
		for id in pairs(set) do ids[#ids + 1] = id end
		table.sort(ids)
		cats[#cats + 1] = cat
		Exporter.writeJson(idsRel(cat), { category = cat, count = #ids, ids = ids }, { versioned = true, kind = "state_ids" })
	end
	local sessions = {}
	for _, s in ipairs(Session.previous) do if s ~= Session.id then sessions[#sessions + 1] = s end end
	Exporter.writeJson(STATE_REL, {
		collector_version = Core.Config.Version, last_session = Session.id, saved_at = U.nowIso(), sessions = sessions,
		cell_size = Core.Config.CellSize, cells = cells, categories = cats, operations = Session.history,
	}, { versioned = true, kind = "state" })
end

function Session.info()
	local cam = Core.Workspace.CurrentCamera
	local place = {}
	pcall(function() place.place_id = game.PlaceId place.game_id = game.GameId place.job_id = game.JobId end)

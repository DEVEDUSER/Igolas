function GUI.showResults(res, nested)
	local g = GUI.refs
	if not g or not g.list then return end
	g.saveAll.Text = string.format("SALVAR LISTA (%d)", #res)
	for _, c in ipairs(g.list:GetChildren()) do
		if c:IsA("TextButton") then c:Destroy() end
	end
	for i, inst in ipairs(res) do
		if i > 200 then break end -- the list shows 200; SALVAR saves all of them
		local row = Instance.new("TextButton")
		row.Size = UDim2.new(1, -8, 0, 36)
		row.LayoutOrder = i
		row.BackgroundColor3 = Color3.fromRGB(46, 50, 64)
		row.BorderSizePixel = 0
		row.TextColor3 = Color3.new(1, 1, 1)
		row.Font = Enum.Font.Code
		row.TextSize = 10
		row.TextWrapped = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		local cnt = Search.counts and Search.counts[inst]
		row.Text = "[" .. inst.ClassName .. "] " .. path(inst) .. (cnt and ("  (" .. cnt .. " itens)") or "") .. "  (toque para salvar)"
		row.Parent = g.list
		row.MouseButton1Click:Connect(function() Control.saveInstance(inst) end)
	end
end

function GUI.loop()
	task.spawn(function()
		while Session.alive do
			task.wait(0.6)
			local ok, err = pcall(GUI.render)
			if not ok then Log.errOnce("gui", "gui render: " .. tostring(err)) end
		end
	end)
end


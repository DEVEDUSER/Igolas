end
RENDER.lighting = function()
	local L = R("LightingCollector")
	local out = { "Capturas de iluminacao: " .. #L.labels }
	for _, l in ipairs(L.labels) do out[#out + 1] = "  " .. l end
	out[#out + 1] = "A iluminacao pode mudar por area: capture em cada area."
	return lines(out)
end
RENDER.events = function()
	local I = R("InteractionObserver")
	local out = { string.format("Eventos: %d (descartados acima do limite: %d)", #I.events, I.dropped) }
	for i = math.max(1, #I.events - 30), #I.events do
		local e = I.events[i]
		local d = e.data
		local txt = ""
		if type(d) == "table" then
			local ok, js = pcall(function() return Core.HttpService:JSONEncode(d) end)
			txt = ok and js or ""
		end
		out[#out + 1] = string.format("  %s [%s] %s", e.t, e.kind, string.sub(txt, 1, 90))
	end
	return lines(out)
end
RENDER.export = function()
	local out = { "Pasta: " .. Core.Config.Root .. "   (writefile: " .. tostring(Exporter.FS.canWrite()) .. ")", "Arquivos gravados nesta sessao: " .. #Exporter.files, "Falhas de gravacao: " .. Exporter.FS.failures, "" }
	for i = math.max(1, #Exporter.files - 20), #Exporter.files do
		local f = Exporter.files[i]
		out[#out + 1] = string.format("  %-9s %6d B  %s", f.kind, f.bytes, string.sub(f.path, 1, 70))
	end
	return lines(out)
end
RENDER.reports = function()
	local rep = R("CollectionReport")
	local out = { "STATUS POR CATEGORIA" }
	for _, c in ipairs(rep.categories()) do
		out[#out + 1] = string.format("  %-34s %s", string.sub(c.category, 1, 34), c.status)
	end
	local V = R("DataValidator").last
	out[#out + 1] = ""
	out[#out + 1] = "VALIDACAO"
	if V then
		for _, c in ipairs(V.checks) do out[#out + 1] = string.format("  %-26s %-7s %s", c.name, c.status, string.sub(c.detail, 1, 70)) end
	else
		out[#out + 1] = "  ainda nao executada"
	end
	return lines(out)
end


Modules["CatalogCommon"] = function(...)
-- CatalogCommon: shared helpers of the catalog collectors (shops, weapons, boxes, pets, eggs, chests/machines).
-- Catalogs are built ONLY from what was measured (models of this session + UI cards the player opened). Nothing is filled in by guess.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local C = {}

function C.readDoc(rel)
	local text = Exporter.FS.read(Core.Config.Root .. "/" .. rel)
	if not text then return nil end
	local ok, doc = pcall(function() return Core.HttpService:JSONDecode(text) end)
	if ok then return doc end
	return nil
end

-- numbers found in displayed texts. They are NOT labelled "price": the collector cannot know what a number means.
function C.numbersOf(texts)
	local out = {}
	if type(texts) ~= "table" then return out end
	for _, t in ipairs(texts) do
		local p = U.parseDisplayNumber(type(t) == "table" and t.text or t)
		if p then out[#out + 1] = p end
	end
	return out
end

-- rows of Store.index.models whose category is in `cats` (set)
function C.modelRows(cats)
	local rows = {}
	for _, row in ipairs(Store.index.models or {}) do
		if cats[row.category] then rows[#rows + 1] = row end
	end
	return rows
end

function C.instanceEntry(row)
	return {
		id = row.id, name = row.name, path = row.path, world = row.world, area = row.area, zone = row.zone, category = row.category,
		position = row.pos or "unknown", size = row.size or "unknown",
		displayed_texts = row.gui_texts or {}, displayed_numbers = C.numbersOf(row.gui_texts), prompt = row.prompt,
		attributes = row.attributes, source = "observed_in_world",
	}
end

-- groups instances by model name: { name, count, size_min, size_max, areas, sample_positions, texts }
function C.group(rows)
	local byName, order = {}, {}
	for _, row in ipairs(rows) do
		local g = byName[row.name]
		if not g then
			g = { name = row.name, category = row.category, count = 0, areas = {}, sample_positions = {}, texts = {}, _t = {}, size_min = nil, size_max = nil, instance_ids = {} }
			byName[row.name] = g
			order[#order + 1] = row.name
		end
		g.count = g.count + 1
		local ak = (row.world or "?") .. "/" .. (row.area or row.zone or "?")
		g.areas[ak] = (g.areas[ak] or 0) + 1
		if #g.sample_positions < 5 and row.pos then g.sample_positions[#g.sample_positions + 1] = row.pos end
		if #g.instance_ids < 50 then g.instance_ids[#g.instance_ids + 1] = row.id end
		if row.size then
			if not g.size_min then
				g.size_min, g.size_max = { row.size[1], row.size[2], row.size[3] }, { row.size[1], row.size[2], row.size[3] }
			else
				for i = 1, 3 do
					if row.size[i] < g.size_min[i] then g.size_min[i] = row.size[i] end
					if row.size[i] > g.size_max[i] then g.size_max[i] = row.size[i] end
				end
			end
		end
		for _, t in ipairs(row.gui_texts or {}) do
			if not g._t[t] then
				g._t[t] = true
				if #g.texts < 20 then g.texts[#g.texts + 1] = t end
			end
		end
		g.attributes = g.attributes or row.attributes
		g.prompt = g.prompt or row.prompt
	end
	local list = {}
	for _, name in ipairs(order) do
		local g = byName[name]
		g._t = nil
		g.displayed_numbers = C.numbersOf(g.texts)
		list[#list + 1] = g
	end
	table.sort(list, function(a, b) return a.name < b.name end)
	return list
end

-- merges `entries` with the catalog already on disk (union by key) and writes Catalogs/<name>.json (previous version kept as .bak)
function C.write(name, entries, extra)
	local rel = "Catalogs/" .. name .. ".json"
	local old = C.readDoc(rel)
	local merged, seen = {}, {}
	local prevSessions = {}
	if old and type(old.entries) == "table" then
		for _, e in ipairs(old.entries) do
			local key = e.key or e.id or e.name
			seen[key] = true
			merged[#merged + 1] = e
		end
		prevSessions = old.sessions or {}
		if old.session then prevSessions[#prevSessions + 1] = old.session end
	end
	local added = 0
	for _, e in ipairs(entries) do
		local key = e.key or e.id or e.name
		if not seen[key] then
			seen[key] = true
			e.first_seen_session = Exporter.session
			merged[#merged + 1] = e
			added = added + 1
		end
	end
	local doc = { collector_version = Core.Config.Version, session = Exporter.session, sessions = prevSessions, kind = "catalog_" .. name, count = #merged, added_this_session = added, entries = merged }
	if extra then for k, v in pairs(extra) do doc[k] = v end end
	local ok, path = Exporter.writeJson(rel, doc, { versioned = true, kind = "catalog_" .. name, records = #merged })
	Store.bump("catalog_" .. name .. "_entries", added)
	return { name = name, total = #merged, added = added, ok = ok, path = path }
end

-- cards of menus whose name contains one of the words: menus open right now (live) and menus captured earlier this session
function C.fromMenus(words)
	local UI = R("UICollector")
	local sources = {}
	local function matches(name)
		local l = string.lower(name)
		for _, w in ipairs(words) do
			if string.find(l, w, 1, true) then return true end
		end
		return false
	end
	for _, m in ipairs(UI.openMenus()) do
		if matches(m.name) then
			local ok, cards = pcall(UI.cards, m.inst)
			if ok then sources[m.path] = { name = m.name, path = m.path, cards = cards, live = true } end
		end
	end
	for name, rec in pairs(UI.cardsByMenu or {}) do
		if matches(name) and not sources[rec.path] then sources[rec.path] = { name = name, path = rec.path, cards = rec.cards, live = false } end
	end
	local entries, menus = {}, {}
	for _, s in pairs(sources) do
		menus[#menus + 1] = { name = s.name, path = s.path, cards = #s.cards, live = s.live }
		for _, c in ipairs(s.cards) do
			local joined = {}
			for _, t in ipairs(c.texts) do joined[#joined + 1] = t.text end
			local pct = {}
			for _, n in ipairs(c.numbers) do if n.unit == "percent" then pct[#pct + 1] = n end end
			entries[#entries + 1] = {
				key = "ui|" .. s.name .. "|" .. c.card .. "|" .. table.concat(joined, "/"),
				id = U.stableId("uicard", s.name .. "|" .. c.card .. "|" .. table.concat(joined, "/")),
				menu = s.name, card = c.card, container = c.container, layout_order = c.layout_order, visible_when_captured = c.visible,
				displayed_texts = c.texts, displayed_numbers = c.numbers, displayed_percentages = pct, image_count = c.image_count, attributes = c.attributes,
				source = "observed_in_ui",
			}
		end
	end
	return entries, menus
end

-- generic catalog run: world instances of `cats` (grouped) + UI cards of menus matching `words`. Returns a result used by the dashboard.
function C.run(name, cats, words, opts)
	opts = opts or {}
	local rows = C.modelRows(cats or {})
	local entries = {}
	if opts.instances then
		for _, row in ipairs(rows) do entries[#entries + 1] = C.instanceEntry(row) end
	else
		for _, g in ipairs(C.group(rows)) do
			g.id = U.stableId("grp", name .. "|" .. g.name)
			g.source = "observed_in_world"
			entries[#entries + 1] = g
		end
	end
	local uiEntries, menus = C.fromMenus(words or {})
	for _, e in ipairs(uiEntries) do entries[#entries + 1] = e end
	if opts.extra then
		for _, e in ipairs(opts.extra()) do entries[#entries + 1] = e end
	end
	local res = C.write(name, entries, { world_instances_seen = #rows, ui_menus_seen = menus, search_words = words,
		notes = { "built only from what was observed in this session; missing items are NOT filled in", "displayed numbers are copied as shown and are not interpreted (price, level, chance...)" } })
	res.world_instances = #rows
	res.ui_menus = #menus
	res.ui_cards = #uiEntries
	res.missing = {}
	if #rows == 0 then res.missing[#res.missing + 1] = "nenhuma instancia no mundo carregada (va ate a area / aguarde o streaming)" end
	if #menus == 0 and words and #words > 0 then res.missing[#res.missing + 1] = "nenhum menu '" .. table.concat(words, "/") .. "' aberto ou capturado (abra o menu no jogo)" end
	C.remember(name, res)
	Core.info(string.format("catalogo %s: %d entradas (%d no mundo, %d cards de UI)", name, res.total, #rows, #uiEntries))
	return res
end
C.results = {}   -- name -> last result (for the dashboard)
function C.remember(name, res) C.results[name] = res end

return C

end


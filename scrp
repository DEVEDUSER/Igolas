-- Panels that are effects/overlays, never menus (first real run: fade bars and a starburst were captured as "menus")
local DENY_PANEL = { "screenfade", "starburst", "shinesweep", "glow" }
function Core.isDeniedPanel(name)
	local l = string.lower(tostring(name))
	for _, w in ipairs(DENY_PANEL) do
		if string.find(l, w, 1, true) then return true end
	end
	return false
end
-- cheap content signature: node count + a rolling checksum over texts; equal signatures = same panel content
function Core.snapSig(nodes)
	local s = #nodes
	for _, r in ipairs(nodes) do
		local t = r.text
		if t then s = (s * 31 + #t + (string.byte(t, 1) or 0)) % 2147483647 end
	end
	return tostring(#nodes) .. ":" .. tostring(s)
end

-- looks at the container path (last segments) and the names of its visible direct children; never at texts, never at the whole HUD
function Core.matchChecklist(pathNames, childNames)
	local keep = {}
	for _, seg in ipairs(pathNames or {}) do
		if not Core.isDeniedPanel(seg) and not string.find(string.lower(seg), "token", 1, true) then keep[#keep + 1] = seg end
	end
	for _, nm in ipairs(childNames or {}) do
		if not Core.isDeniedPanel(nm) then keep[#keep + 1] = nm end
	end
	local hay = string.lower(table.concat(keep, "."))
	local hits = {}
	for _, c in ipairs(CHECK) do
		for _, w in ipairs(c[3]) do
			if string.find(hay, w, 1, true) then hits[#hits + 1] = c[1]; break end
		end
	end
	return hits
end
function Core.markChecklist(keys, label)
	for _, k in ipairs(keys) do
		local s = Core.checkState[k]
		if s then
			s.auto = s.auto + 1
			if #s.samples < 3 then s.samples[#s.samples + 1] = label end
		end
	end
end
function Core.isDone(key)
	local s = Core.checkState[key]
	return s and (s.auto > 0 or s.manual) or false
end

------------------------------------------------------------------------------------------------- ledger (pure)
local Ledger = { events = {}, dropped = 0, rate = {}, windows = {}, capHit = false }
Core.Ledger = Ledger
function Ledger.add(kind, key, old, new, extra)
	local t = Core.clock()
	local sec = math.floor(t)
	local r = Ledger.rate[key]
	if not r or r.sec ~= sec then r = { sec = sec, n = 0 }; Ledger.rate[key] = r end
	r.n = r.n + 1
	if r.n > CFG.RATE_PER_SEC then Ledger.dropped = Ledger.dropped + 1; return nil end
	if #Ledger.events >= CFG.LEDGER_CAP then Ledger.dropped = Ledger.dropped + 1; Ledger.capHit = true; return nil end
	local ev = { c = num(t), k = kind, key = key, old = old, new = new }
	if extra then for k, v in pairs(extra) do ev[k] = v end end
	Ledger.events[#Ledger.events + 1] = ev
	local w, i = Ledger.windows, 1
	while i <= #w do
		if t > w[i].untilT then
			table.remove(w, i)
		else
			if #w[i].list < 200 then w[i].list[#w[i].list + 1] = ev end
			i = i + 1
		end
	end
	return ev
end
function Ledger.openWindow(list)
	Ledger.windows[#Ledger.windows + 1] = { untilT = Core.clock() + CFG.REWARD_WINDOW, list = list }
end

------------------------------------------------------------------------------------------------- UI snapshot (pure over the instance API)
function Core.nodeRecord(n, rel)
	local r = { p = rel, c = rd(n, "ClassName") }
	local lo = rd(n, "LayoutOrder")
	if type(lo) == "number" and lo ~= 0 then r.lo = lo end
	if n:IsA("GuiObject") then
		r.pos = U.v2(rd(n, "AbsolutePosition")); r.sz = U.v2(rd(n, "AbsoluteSize"))
		-- keys "up"/"us" (not P/S): JSON readers that ignore key case would collide with "p" (path)
		r.up = U.ud2(rd(n, "Position")); r.us = U.ud2(rd(n, "Size"))
		local anc = rd(n, "AnchorPoint")
		if typeof(anc) == "Vector2" and (anc.X ~= 0 or anc.Y ~= 0) then r.anc = U.v2(anc) end
		r.bg = U.c3(rd(n, "BackgroundColor3")); r.bgt = U.num(rd(n, "BackgroundTransparency"))
		r.z = rd(n, "ZIndex")
		local rot = rd(n, "Rotation")
		if type(rot) == "number" and rot ~= 0 then r.rot = U.num(rot) end
		if n:IsA("TextLabel") or n:IsA("TextButton") or n:IsA("TextBox") then
			r.text = U.clean(rd(n, "Text")); r.tc = U.c3(rd(n, "TextColor3")); r.ts = rd(n, "TextSize")
			r.font = U.enumName(rd(n, "Font"))
			if rd(n, "TextScaled") == true then r.scaled = true end
			if rd(n, "RichText") == true then r.rich = true end
			r.tsc = U.c3(rd(n, "TextStrokeColor3")); r.tst = U.num(rd(n, "TextStrokeTransparency"))
			r.xa = U.enumName(rd(n, "TextXAlignment")); r.ya = U.enumName(rd(n, "TextYAlignment"))
		end
		if n:IsA("ImageLabel") or n:IsA("ImageButton") then
			local img = rd(n, "Image")
			r.has_image = (type(img) == "string" and img ~= "") -- only whether an image exists; the id is never stored
			r.ic = U.c3(rd(n, "ImageColor3")); r.it = U.num(rd(n, "ImageTransparency")); r.scale = U.enumName(rd(n, "ScaleType"))
		end
		local at = U.attributes(n)
		if at then r.attr = at end
	elseif n:IsA("UICorner") then
		r.radius = U.ud(rd(n, "CornerRadius"))
	elseif n:IsA("UIStroke") then
		r.th = U.num(rd(n, "Thickness")); r.col = U.c3(rd(n, "Color")); r.tr = U.num(rd(n, "Transparency")); r.mode = U.enumName(rd(n, "ApplyStrokeMode"))
	elseif n:IsA("UIGradient") then
		local cs = rd(n, "Color")
		if cs and cs.Keypoints then
			local kp = {}
			for _, k in ipairs(cs.Keypoints) do kp[#kp + 1] = { t = U.num(k.Time), col = U.c3(k.Value) } end
			r.keys = kp
		end
		r.grot = U.num(rd(n, "Rotation"))
	elseif n:IsA("UIListLayout") or n:IsA("UIGridLayout") then
		r.pad = U.ud(rd(n, "Padding")); r.dir = U.enumName(rd(n, "FillDirection")); r.sort = U.enumName(rd(n, "SortOrder"))
		r.ha = U.enumName(rd(n, "HorizontalAlignment")); r.va = U.enumName(rd(n, "VerticalAlignment"))
		if n:IsA("UIGridLayout") then r.cell = U.ud2(rd(n, "CellSize")); r.cpad = U.ud2(rd(n, "CellPadding")) end
	elseif n:IsA("UIPadding") then
		r.pl = U.ud(rd(n, "PaddingLeft")); r.pr = U.ud(rd(n, "PaddingRight")); r.pt = U.ud(rd(n, "PaddingTop")); r.pb = U.ud(rd(n, "PaddingBottom"))
	elseif n:IsA("UIAspectRatioConstraint") then
		r.ratio = U.num(rd(n, "AspectRatio"))
	elseif n:IsA("UIScale") then
		r.scale_v = U.num(rd(n, "Scale"))
	end
	return r
end

-- opts: maxNodes, yield (called per node), covered (weak table: visible nodes get marked)
function Core.snapshotTree(root, opts)
	opts = opts or {}
	local maxNodes = opts.maxNodes or CFG.UI_MAX_NODES
	local nodes, count, truncated, hidden = {}, 0, false, 0
	local stack = { { root, "" } }
	while #stack > 0 do
		local item = table.remove(stack)
		local node, rel = item[1], item[2]
		if count >= maxNodes then truncated = true; break end
		count = count + 1
		local vis = true
		if node:IsA("GuiObject") and rd(node, "Visible") == false then vis = false end
		if vis then
			nodes[#nodes + 1] = Core.nodeRecord(node, rel)
			if opts.covered then opts.covered[node] = true end
			local kids = node:GetChildren()
			for i = #kids, 1, -1 do
				local k = kids[i]
				local nm = k.Name
				stack[#stack + 1] = { k, (rel == "" and nm or (rel .. "/" .. nm)) }
			end
		else
			hidden = hidden + 1
			nodes[#nodes + 1] = { p = rel, c = rd(node, "ClassName"), hidden = true }
		end
		if opts.yield then opts.yield() end
	end
	return { nodes = nodes, node_count = count, hidden_count = hidden, truncated = truncated, unread_in_stack = #stack }
end

------------------------------------------------------------------------------------------------- export planning (pure)
function Core.planFiles(D, sid, extra)
	local files = {}
	local function hdr(kind) return { gap_version = CFG.VERSION, session = sid, kind = kind } end
	local function addChunks(kind, list, per, label)
		local parts = U.chunk(list, per)
		for i, part in ipairs(parts) do
			local doc = hdr(kind)
			doc.part = i; doc.parts = #parts; doc.count = #part; doc.label = label; doc.records = part
			files[#files + 1] = { name = kind .. (label and ("_" .. U.sanitize(label)) or "") .. "_p" .. string.format("%02d", i) .. ".json", doc = doc }
		end
	end
	for i, snap in ipairs(D.ui) do
		files[#files + 1] = { name = "ui_" .. string.format("%03d", i) .. "_" .. U.sanitize(snap.label) .. ".json", doc = snap, static = true }
	end
	addChunks("ledger", D.ledger.events, CFG.CHUNK * 4)
	addChunks("tags", D.tags, CFG.CHUNK)
	addChunks("inputs", D.inputs, CFG.CHUNK * 4)
	addChunks("boxes", D.boxes, 40)
	for label, list in pairs(D.map.byArea) do addChunks("map", list, CFG.MAP_CHUNK, label) end
	addChunks("map_prompts", D.map.prompts, CFG.CHUNK)
	addChunks("map_models", D.map.meta, CFG.CHUNK)
	addChunks("board_texts", D.board, CFG.CHUNK * 4)
	addChunks("log", D.log, 400)
	local pathsDoc = hdr("map_paths"); pathsDoc.paths = D.map.paths
	files[#files + 1] = { name = "map_paths.json", doc = pathsDoc }
	local sum = hdr("summary")
	for k, v in pairs(extra or {}) do sum[k] = v end
	files[#files + 1] = { name = "summary.json", doc = sum }
	return files
end


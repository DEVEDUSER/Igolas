local function Destroy()
	Session.alive = false
	Session.gen = Session.gen + 1
	pcall(Watch.dropAll)
	pcall(Monitor.disconnect)
	for _, c in ipairs(Session.guiConns) do pcall(function() c:Disconnect() end) end
	Session.guiConns = {}
	if GUI.refs and GUI.refs.gui then pcall(function() GUI.refs.gui:Destroy() end) end
	GUI.refs = nil
	if ENV.UBRC_INSTANCE and ENV.UBRC_INSTANCE.Session == Session then ENV.UBRC_INSTANCE = nil end
end


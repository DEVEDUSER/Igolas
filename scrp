local function buildGui()
	local sg = Instance.new("ScreenGui")
	sg.Name = "UBG_GUI"; sg.ResetOnSpawn = false; sg.DisplayOrder = 100000; sg.IgnoreGuiInset = true
	local parentOk = false
	if CAP.gethui then parentOk = pcall(function() sg.Parent = gethui() end) end
	if not parentOk then parentOk = pcall(function() sg.Parent = svc("CoreGui") end) end
	if not parentOk or not sg.Parent then sg.Parent = PlayerGui end
	GUI = sg
	local vp = viewport()
	local w = math.clamp(vp.X * 0.55, 320, 520)
	local h = math.clamp(vp.Y * 0.8, 240, 560)
	local panel = Instance.new("Frame")
	panel.Size = UDim2.fromOffset(w, h); panel.Position = UDim2.fromOffset(8, 8)
	panel.BackgroundColor3 = Color3.fromRGB(24, 28, 40); panel.BorderSizePixel = 0; panel.Parent = sg
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -44, 0, 36); title.Position = UDim2.fromOffset(0, 0); title.BackgroundColor3 = Color3.fromRGB(40, 90, 170)
	title.BorderSizePixel = 0; title.Text = "Unboxing Gap v" .. CFG.VERSION .. " (arraste aqui)"; title.TextColor3 = Color3.new(1, 1, 1)
	title.Font = Enum.Font.GothamBold; title.TextSize = 15; title.Active = true; title.Parent = panel
	local mini = Instance.new("TextButton")
	mini.Size = UDim2.fromOffset(44, 36); mini.Position = UDim2.new(1, -44, 0, 0); mini.BackgroundColor3 = Color3.fromRGB(170, 60, 60)
	mini.BorderSizePixel = 0; mini.Text = "-"; mini.TextColor3 = Color3.new(1, 1, 1); mini.Font = Enum.Font.GothamBold; mini.TextSize = 22; mini.Parent = panel
	local body = Instance.new("ScrollingFrame")
	body.Size = UDim2.new(1, 0, 1, -36); body.Position = UDim2.fromOffset(0, 36); body.BackgroundTransparency = 1; body.BorderSizePixel = 0
	body.ScrollBarThickness = 6; body.CanvasSize = UDim2.new(0, 0, 0, 0); body.AutomaticCanvasSize = Enum.AutomaticSize.Y
	body.ScrollingDirection = Enum.ScrollingDirection.Y; body.Parent = panel
	local lay = Instance.new("UIListLayout")
	lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Padding = UDim.new(0, 6); lay.Parent = body
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 6); pad.PaddingRight = UDim.new(0, 10); pad.PaddingTop = UDim.new(0, 6); pad.PaddingBottom = UDim.new(0, 6); pad.Parent = body
	local order = 0
	local function nextOrder() order = order + 1; return order end
	local function label(text, height, size)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, 0, 0, height); l.BackgroundTransparency = 1; l.Text = text; l.TextColor3 = Color3.fromRGB(220, 226, 240)
		l.Font = Enum.Font.Gotham; l.TextSize = size or 14; l.TextWrapped = true; l.TextXAlignment = Enum.TextXAlignment.Left
		l.TextYAlignment = Enum.TextYAlignment.Top; l.LayoutOrder = nextOrder(); l.Parent = body
		return l
	end
	local function button(parent, text, x, y, cols, color, cb)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(1 / cols, -4, 0, 38); b.Position = UDim2.new(x / cols, 0, 0, y)
		b.BackgroundColor3 = color; b.BorderSizePixel = 0; b.Text = text; b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.GothamBold; b.TextSize = 13; b.TextWrapped = true; b.Parent = parent
		connect(b.Activated, function()
			local ok, err = pcall(cb, b)
			if not ok then log("erro: " .. tostring(err)) end
		end)
		return b
	end
	local function grid(count, cols)
		local f = Instance.new("Frame")
		f.Size = UDim2.new(1, 0, 0, math.ceil(count / cols) * 42); f.BackgroundTransparency = 1; f.LayoutOrder = nextOrder(); f.Parent = body
		return f
	end
	statusLabel = label("...", 44, 13)
	local actions = grid(6, 3)
	local blue, green, orange = Color3.fromRGB(50, 110, 200), Color3.fromRGB(40, 150, 80), Color3.fromRGB(200, 120, 30)
	button(actions, "MAPA AQUI", 0, 0, 3, blue, function() tspawn(scanMap) end)
	button(actions, "MEDIR UI AGORA", 1, 0, 3, blue, function() tspawn(function() scanUI(true) end) end)
	local boxBtn
	boxBtn = button(actions, "CAIXAS: ON", 2, 0, 3, green, function()
		boxOn = not boxOn
		boxBtn.Text = boxOn and "CAIXAS: ON" or "CAIXAS: OFF"
		boxBtn.BackgroundColor3 = boxOn and green or Color3.fromRGB(110, 110, 110)
	end)
	button(actions, "EXPORTAR", 0, 42, 3, orange, function() tspawn(function() doExport(false) end) end)
	button(actions, "COPIAR RESUMO", 1, 42, 3, orange, copySummary)
	button(actions, "PLACAS (textos)", 2, 42, 3, blue, function() tspawn(harvestBoards) end)
	label("Aperte a TAG logo DEPOIS da acao:", 18, 13)
	local TAGS = { "UPGRADE", "REBIRTH", "OVO", "QUEST", "ROLETA", "BAU", "COMPRA", "ENCHANT", "CRAFT", "RESGATE", "OUTRO" }
	local tagGrid = grid(#TAGS, 3)
	for i, nm in ipairs(TAGS) do
		button(tagGrid, nm, (i - 1) % 3, math.floor((i - 1) / 3) * 42, 3, Color3.fromRGB(110, 70, 170), function() addTag(nm) end)
	end
	logLabel = label("", 84, 12)
	label("Checklist (toque para marcar/desmarcar a mao):", 18, 13)
	local rows = {}
	for _, c in ipairs(CHECK) do
		local r = Instance.new("TextButton")
		r.Size = UDim2.new(1, 0, 0, 32); r.BackgroundColor3 = Color3.fromRGB(36, 42, 60); r.BorderSizePixel = 0
		r.TextColor3 = Color3.fromRGB(220, 226, 240); r.Font = Enum.Font.Gotham; r.TextSize = 14; r.TextXAlignment = Enum.TextXAlignment.Left
		r.LayoutOrder = nextOrder(); r.Parent = body
		connect(r.Activated, function()
			local s = Core.checkState[c[1]]
			s.manual = not s.manual
			refreshGui()
		end)
		rows[c[1]] = r
	end
	refreshGui = function()
		local done = 0
		for _, c in ipairs(CHECK) do
			local d = Core.isDone(c[1])
			if d then done = done + 1 end
			local s = Core.checkState[c[1]]
			local r = rows[c[1]]
			if r then
				r.Text = (d and "  [x] " or "  [ ] ") .. c[2] .. (s.auto > 0 and ("  (auto " .. s.auto .. ")") or "")
				r.BackgroundColor3 = d and Color3.fromRGB(30, 80, 50) or Color3.fromRGB(36, 42, 60)
			end
		end
		if statusLabel then
			statusLabel.Text = string.format("UI %d | caixas %d (quebradas %d) | ledger %d | mapa %d | tags %d | menus %d/%d%s", #D.ui, boxCount, destroyedCount,
				#Ledger.events, Map.count, #D.tags, done, #CHECK, CAP.writefile and "" or " | SEM writefile")
		end
	end
	-- drag
	local dragging, dragStart, startPos = false, nil, nil
	connect(title.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragStart = input.Position; startPos = panel.Position
		end
	end)
	connect(UIS.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	connect(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	local minimized = false
	connect(mini.Activated, function()
		minimized = not minimized
		body.Visible = not minimized
		panel.Size = minimized and UDim2.fromOffset(w, 36) or UDim2.fromOffset(w, h)
	end)
	refreshGui()
end


tspawn(function()
	local tUI, tBox, tSave, tGui = 0, 0, os.clock(), 0
	while alive do
		local now = os.clock()
		if now - tUI >= CFG.UI_SCAN then
			tUI = now
			local ok, err = pcall(scanUI, false)
			if not ok then log("scanUI: " .. tostring(err)) end
		end
		if boxOn and now - tBox >= CFG.BOX_SCAN then
			tBox = now
			local ok, err = pcall(scanBoxes)
			if not ok then log("scanBoxes: " .. tostring(err)) end
		end
		if now - tGui >= 1 then
			tGui = now
			pcall(refreshGui)
		end
		if now - tSave >= CFG.AUTOSAVE then
			tSave = now
			if CAP.writefile and totalCount() ~= lastExportCount then
				local ok, err = pcall(doExport, true)
				if not ok then log("autosave: " .. tostring(err)) end
			end
		end
		twait(0.25)
	end
end)

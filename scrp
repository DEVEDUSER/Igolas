    table.insert(lines, "Tickets: " .. tostring(Stats.ticketsGained))
    table.insert(lines, "Vendidos: " .. tostring(Stats.itemsSold))
    table.insert(lines, "Hats vendidos: " .. tostring(Stats.hatsSold))
    table.insert(lines, "Pets vendidos: " .. tostring(Stats.petsSold))
    table.insert(lines, "Perks vendidos: " .. tostring(Stats.perksSold))

-- 2. JSON ENCODER (own implementation: supports null, NaN/inf -> null, key order, fixed escaping)
------------------------------------------------------------------------------------------------------
local NULL = setmetatable({}, { __tostring = function() return "null" end })
Json.NULL = NULL
local ARR = setmetatable({}, { __mode = "k" })
function Json.arr(t)
	ARR[t] = true
	return t
end
local L = Json.arr

local ESC = { ['"'] = '\\"', ["\\"] = "\\\\", ["\b"] = "\\b", ["\f"] = "\\f", ["\n"] = "\\n", ["\r"] = "\\r", ["\t"] = "\\t" }
local function escChar(c)
	return ESC[c] or string.format("\\u%04x", string.byte(c))
end

local function encStr(s)
	if utf8 and utf8.len and not utf8.len(s) then
		s = s:gsub("[\128-\255]", "?")
	end
	local body = s:gsub('[%c"\\]', escChar)
	return '"' .. body .. '"'
end

local function encNum(v)
	if v ~= v or v == math.huge or v == -math.huge then return "null" end
	if v == 0 then return "0" end
	if v == math.floor(v) and math.abs(v) < 1e15 then
		return string.format("%.0f", v)
	end
	return string.format("%.14g", v)
end

local function isArray(t)
	if ARR[t] then return true end
	local n = #t
	if n == 0 then return false end
	local c = 0
	for _ in pairs(t) do c = c + 1 end
	return c == n
end

local function enc(v, buf, depth, order)
	local tv = type(v)
	if v == nil or v == NULL then
		buf[#buf + 1] = "null"
	elseif tv == "string" then
		buf[#buf + 1] = encStr(v)
	elseif tv == "number" then
		buf[#buf + 1] = encNum(v)
	elseif tv == "boolean" then
		buf[#buf + 1] = v and "true" or "false"
	elseif tv == "table" then
		if depth > 14 then
			buf[#buf + 1] = '"<max_depth>"'
			return
		end
		if isArray(v) then
			buf[#buf + 1] = "["
			for i = 1, #v do
				if i > 1 then buf[#buf + 1] = "," end
				enc(v[i], buf, depth + 1)
			end
			buf[#buf + 1] = "]"
		else
			local keys, seen = {}, {}
			if order then
				for _, k in ipairs(order) do
					if v[k] ~= nil then keys[#keys + 1] = k; seen[k] = true end
				end
			end
			local rest = {}
			for k in pairs(v) do
				if not (type(k) == "string" and seen[k]) then rest[#rest + 1] = k end
			end
			table.sort(rest, function(a, b) return tostring(a) < tostring(b) end)
			for _, k in ipairs(rest) do keys[#keys + 1] = k end
			buf[#buf + 1] = "{"
			for i, k in ipairs(keys) do
				if i > 1 then buf[#buf + 1] = "," end
				buf[#buf + 1] = encStr(tostring(k))
				buf[#buf + 1] = ":"
				enc(v[k], buf, depth + 1)
			end
			buf[#buf + 1] = "}"
		end
	else
		buf[#buf + 1] = "null" -- functions, threads, userdata are never exported
	end
end

function Json.encode(v, order)
	local buf = {}
	enc(v, buf, 0, order)
	return table.concat(buf)
end

local RECORD_ORDER = { "id", "name", "category", "properties", "source", "collected_at", "last_updated_at", "confidence" }
function Json.encodeRecord(rec)
	local parts = { "{" }
	local first = true
	for _, k in ipairs(RECORD_ORDER) do
		local v = rec[k]
		if v ~= nil then
			if not first then parts[#parts + 1] = "," end
			first = false
			parts[#parts + 1] = encStr(k)
			parts[#parts + 1] = ":"
			parts[#parts + 1] = Json.encode(v)
		end
	end
	parts[#parts + 1] = "}"
	return table.concat(parts)
end

function Json.selfTest()
	local sample = {
		a = 1, b = 1.5, c = 0 / 0, d = math.huge, e = NULL, f = "x\"y\\z\n\t\1", g = L({}), h = {}, i = { 1, 2, { j = true } },
		k = "caf\u{E9} \u{1F600}",
	}
	local s = Json.encode(sample, { "a" })
	local ok, dec = pcall(function() return HttpService:JSONDecode(s) end)
	if not ok then return false, "decode failed: " .. tostring(dec) .. " | " .. s end
	if dec.a ~= 1 or dec.b ~= 1.5 or dec.c ~= nil or dec.d ~= nil or dec.f ~= "x\"y\\z\n\t\1" or #dec.g ~= 0 or dec.i[3].j ~= true or dec.k ~= "caf\u{E9} \u{1F600}" then
		return false, "roundtrip mismatch: " .. s
	end
	return true, "ok"
end


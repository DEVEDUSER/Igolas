function Visit.node(inst, tag, phase)
	if inst == Session.ownGui then return false end
	if phase == "initial_scan" and Store.seen[inst] then return true end
	Store.seen[inst] = true
	local cls = inst.ClassName
	local prune = false
	if cls == "Model" then
		local plr = Players:GetPlayerFromCharacter(inst)
		if plr then
			if plr ~= LocalPlayer then return false end
			prune = true
		end
	end
	if (cls == "Folder" or cls == "Model") and OtherPlayers[inst.Name] then return false end
	if tag == "player" and inst == PlayerGui then return false end
	local ctx = Ctx.make(inst, tag, phase)
	Session.stats.visited = Session.stats.visited + 1
	for _, m in ipairs(Modules) do
		if not m.disabled then
			local ok, err = pcall(m.visit, inst, ctx)
			if not ok then
				m.errors = m.errors + 1
				Log.errOnce("mod:" .. m.name, "module " .. m.name .. ": " .. tostring(err))
				if m.errors >= 50 then
					m.disabled = true
					Log.err("module " .. m.name .. " disabled after 50 errors")
				end
			end
		end
	end
	return not prune
end

function Visit.dynamic(inst)
	local tag = Roots.tagOf(inst)
	if tag == "other" then return end
	Visit.node(inst, tag, "dynamic")
	local b = Store.byInstance[inst]
	if b and active() then
		for cat, r in pairs(b) do
			if cat == "inventory" or cat == "economy" or cat == "progression" then
				Events.push("object_added", inst, r, nil, nil, nil, { noLimit = true })
				break
			end
		end
	end
end

function Scanner.walk(root, tag, gen)
	local S = Session
	local stack, sp = {}, 0
	local function push(inst, depth)
		local ok, ch = pcall(inst.GetChildren, inst)
		if ok and #ch > 0 then
			if #ch > CONFIG.MAX_CHILDREN_PER_PARENT then
				Store.note("children:" .. path(inst), "Only the first " .. CONFIG.MAX_CHILDREN_PER_PARENT .. " of " .. #ch .. " children of " .. path(inst) .. " were visited.")
			end
			sp = sp + 1
			stack[sp] = { ch, 1, depth }
		end
	end
	push(root, 1)
	local t0 = clock()
	while sp > 0 do
		if gen ~= S.gen then return end
		while S.state == "paused" do
			task.wait(0.25)
			if gen ~= S.gen then return end
		end
		local f = stack[sp]
		local ch, i = f[1], f[2]
		local lim = math.min(#ch, CONFIG.MAX_CHILDREN_PER_PARENT)
		if i > lim then
			stack[sp] = nil
			sp = sp - 1
		else
			f[2] = i + 1
			local inst = ch[i]
			local ok, descend = pcall(Visit.node, inst, tag, "initial_scan")
			if not ok then
				Log.errOnce("visit", "visit error: " .. tostring(descend))
				descend = true
			end
			if descend ~= false then
				if f[3] < CONFIG.MAX_DEPTH then push(inst, f[3] + 1)
				else Store.note("depth", "Maximum depth " .. CONFIG.MAX_DEPTH .. " reached; deeper descendants were not visited.") end
			end
			if clock() - t0 > CONFIG.FRAME_BUDGET then
				task.wait()
				t0 = clock()
			end
		end
	end
end

function Scanner.run(gen)
	local S = Session
	S.stats.visited = 0
	Structure.services()
	local roots = Roots.list()
	local total = 0
	for _, r in ipairs(roots) do
		local ok, n = pcall(function() return #r.inst:GetDescendants() end)
		r.n = ok and n or 0
		total = total + r.n + 1
	end
	S.stats.total = math.max(total, 1)
	for _, r in ipairs(roots) do
		if gen ~= S.gen then return end
		Log.info("Escaneando " .. r.label .. " (~" .. r.n .. " objetos)")
		if r.visitRoot then pcall(Visit.node, r.inst, r.tag, "initial_scan") end
		Scanner.walk(r.inst, r.tag, gen)
	end
	if gen ~= S.gen then return end
	pcall(Inventory.refresh)
	pcall(World.track)
	S.scanState = "complete"
	S.tScanEnd = clock()
	Log.info(string.format("Escaneamento inicial conclu\u{ED}do em %.1fs: %d registros. Monitorando mudan\u{E7}as.", S.tScanEnd - S.t0, Store.total()))
end

function Scanner.spawn()
	local gen = Session.gen
	task.spawn(function()
		local ok, err = pcall(Scanner.run, gen)
		if not ok then
			Log.err("scan failed: " .. tostring(err))
			if gen == Session.gen then Session.scanState = "error" end
		end
	end)
end

function Monitor.onRemoving(inst)
	if Store.byInstance[inst] or Watch.conns[inst] then
		Queue.removed[#Queue.removed + 1] = { inst, clock() }
	end
end

function Monitor.processRemoved()
	local q = Queue.removed
	if #q == 0 then return end
	local keep = {}
	local now = clock()
	for _, it in ipairs(q) do
		if now - it[2] < 0.15 then
			keep[#keep + 1] = it -- wait until the reparent (if any) has settled
		else
			local inst = it[1]
			if not inst:IsDescendantOf(game) then
				local recs = Store.byInstance[inst]
				if recs then
					local major
					for cat, rec in pairs(recs) do
						rec.properties.removed_observed = true
						rec.properties.removed_at_session_seconds = r2(it[2] - Session.t0)
						if cat == "boxes" then Boxes.onRemoved(rec, it[2]) end
						if cat ~= "objects" and cat ~= "ui" and not major then major = rec end
					end
					if major then Events.push("object_removed", inst, major, nil, nil, nil, { noLimit = true }) end
				end
				Watch.drop(inst)
			else
				-- was only reparented inside the game: refresh path in item records, keep watching
				local recs = Store.byInstance[inst]
				if recs then
					for _, rec in pairs(recs) do rec.properties.path = path(inst) end
				end
			end
		end
	end
	Queue.removed = keep
end

function Monitor.step()
	Monitor.processRemoved()
	if active() then
		Queue.process(CONFIG.FRAME_BUDGET)
		local t = clock()
		if t - (Monitor.lastWorld or 0) > 2 then
			Monitor.lastWorld = t
			World.track()
		end
	end
end

function Monitor.connect()
	if Monitor.connected then return end
	Monitor.connected = true
	local g = Session.gen
	local function conn(sig, fn)
		local c = sig:Connect(fn)
		Session.conns[#Session.conns + 1] = c
	end
	local function watchRoot(root)
		conn(root.DescendantAdded, function(d)
			if g == Session.gen then Queue.push(d) end
		end)
		conn(root.DescendantRemoving, function(d)
			if g == Session.gen then Monitor.onRemoving(d) end
		end)
	end
	watchRoot(Workspace)
	watchRoot(ReplicatedStorage)
	watchRoot(LocalPlayer) -- also covers PlayerGui, Backpack and leaderstats
	conn(Players.PlayerAdded, function() refreshOtherPlayers() end)
	conn(Players.PlayerRemoving, function() refreshOtherPlayers() end)
	Inventory.hook()
	task.spawn(function()
		while Session.alive and g == Session.gen do
			task.wait(0.15)
			local ok, err = pcall(Monitor.step)
			if not ok then Log.errOnce("monitor", "monitor step: " .. tostring(err)) end
		end
	end)
end

function Monitor.disconnect()
	for _, c in ipairs(Session.conns) do pcall(function() c:Disconnect() end) end
	Session.conns = {}
	Monitor.connected = false
end


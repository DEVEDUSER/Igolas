-- True when a dynamically added instance lives inside a character/folder that belongs to another player or our own character.
local function insideExcluded(inst)
	local cur = inst.Parent
	local steps = 0
	local myChar = LocalPlayer.Character
	while cur and cur ~= game and steps < 12 do
		if cur == myChar then return true end
		if cur:IsA("Model") and Players:GetPlayerFromCharacter(cur) then return true end
		if (cur:IsA("Folder") or cur:IsA("Model")) and OtherPlayers[cur.Name] then return true end
		cur = cur.Parent
		steps = steps + 1
	end
	return false
end


Modules["Store"] = function(...)
-- Store: in-memory registry of collected records, duplicate detection by stable id, and the queue of records waiting to be exported.
local Core = ...
local Store = {}

Store.ids = {}        -- category -> set of ids already known (this session + restored from previous sessions)
Store.pending = {}    -- category -> array of { dir = "relative/dir", record = {...} }
Store.counts = {}     -- category -> records added this session
Store.dups = {}       -- category -> duplicates skipped this session
Store.restored = {}   -- category -> ids restored from previous sessions
Store.index = {}      -- small summaries kept in memory for catalogs / reports (category -> array)
Store.cells = {}      -- "cx,cz" -> { status, parts, sessions = {...} }
Store.stats = {}      -- free counters

function Store.has(category, id)
	local set = Store.ids[category]
	return set ~= nil and set[id] == true
end

-- returns true when the record was new, false when it was a duplicate (and was skipped)
function Store.add(category, record, dir)
	local set = Store.ids[category]
	if not set then
		set = {}
		Store.ids[category] = set
	end
	if record.id and set[record.id] then
		Store.dups[category] = (Store.dups[category] or 0) + 1
		return false
	end
	if record.id then set[record.id] = true end
	local q = Store.pending[category]
	if not q then
		q = {}
		Store.pending[category] = q
	end
	q[#q + 1] = { dir = dir or ("Misc/" .. category), record = record }
	Store.counts[category] = (Store.counts[category] or 0) + 1
	return true
end

function Store.pendingCount()
	local n = 0
	for _, q in pairs(Store.pending) do n = n + #q end
	return n
end

function Store.summary(category, row)
	local list = Store.index[category]
	if not list then
		list = {}
		Store.index[category] = list
	end
	list[#list + 1] = row
end

function Store.bump(key, n)
	Store.stats[key] = (Store.stats[key] or 0) + (n or 1)
end

function Store.setCell(key, status, partsDelta)
	local c = Store.cells[key]
	if not c then
		c = { status = "NOT_SCANNED", parts = 0 }
		Store.cells[key] = c
	end
	-- a cell only ever moves "up": NOT_SCANNED -> PARTIALLY_SCANNED -> OBSERVED
	local rank = { NOT_SCANNED = 0, PARTIALLY_SCANNED = 1, OBSERVED = 2 }
	if (rank[status] or 0) > (rank[c.status] or 0) then c.status = status end
	c.parts = c.parts + (partsDelta or 0)
	return c
end

return Store

end

Modules["UICollector"] = function(...)
-- UICollector: measures the game's own interface (PlayerGui) - read only. Never clicks, never fires remotes.
-- Image asset ids, sounds and scripts are NOT read (only "has_image"). Menus are captured when the PLAYER opens them.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local UI = {}

UI.snapshots = {}   -- { label, gui, nodes, truncated, files, time }
UI.captured = {}    -- frame path -> true (auto capture, once per session)
UI.menuLog = {}     -- { t, kind = opened/closed, name, path }
UI.watching = false
UI.seq = 0
UI.PRIORITY = { "Shop", "Inventory", "Index", "Egg", "Upgrade", "Rebirth", "Quest", "Settings", "Daily", "Boost", "Pet", "Weapon", "Trade", "Gift", "Leaderboard", "Code" }

local OWN = "UBC_UI"

local function playerGui()
	local lp = Core.LocalPlayer
	if not lp then return nil end
	return lp:FindFirstChildOfClass("PlayerGui")
end
UI.playerGui = playerGui

local function viewport()
	local cam = Core.Workspace.CurrentCamera
	if cam then return cam.ViewportSize end
	return Vector2.new(1920, 1080)
end

local MODIFIERS = {
	UICorner = { "CornerRadius" },
	UIStroke = { "Color", "Thickness", "Transparency", "ApplyStrokeMode", "LineJoinMode", "Enabled" },
	UIGradient = { "Color", "Transparency", "Rotation", "Offset", "Enabled" },
	UIListLayout = { "FillDirection", "HorizontalAlignment", "VerticalAlignment", "SortOrder", "Padding", "Wraps" },
	UIGridLayout = { "CellPadding", "CellSize", "FillDirection", "StartCorner", "SortOrder", "HorizontalAlignment", "VerticalAlignment", "FillDirectionMaxCells" },
	UIPadding = { "PaddingTop", "PaddingBottom", "PaddingLeft", "PaddingRight" },
	UIAspectRatioConstraint = { "AspectRatio", "AspectType", "DominantAxis" },
	UISizeConstraint = { "MinSize", "MaxSize" },
	UIScale = { "Scale" },
	UITextSizeConstraint = { "MinTextSize", "MaxTextSize" },
}

local function enc(v)
	local t = typeof(v)
	if t == "ColorSequence" then
		local out = {}
		for _, k in ipairs(v.Keypoints) do out[#out + 1] = { U.num(k.Time), U.c3(k.Value) } end
		return { __type = "ColorSequence", value = out }
	elseif t == "NumberSequence" then
		local out = {}
		for _, k in ipairs(v.Keypoints) do out[#out + 1] = { U.num(k.Time), U.num(k.Value) } end
		return { __type = "NumberSequence", value = out }
	end
	return U.encodeValue(v)
end

local function modifiersOf(g)
	local list = nil
	for _, c in ipairs(g:GetChildren()) do
		local props = MODIFIERS[c.ClassName]
		if props then
			local m = { class = c.ClassName, name = c.Name, props = {} }
			for _, p in ipairs(props) do
				local v = U.get(c, p)
				if v ~= nil then m.props[p] = enc(v) end
			end
			list = list or {}
			list[#list + 1] = m
		end
	end
	return list
end

local function effectiveVisible(g)
	local cur = g
	local guard = 0
	while cur and guard < 60 do
		if cur:IsA("GuiObject") then
			if not cur.Visible then return false end
		elseif cur:IsA("ScreenGui") then
			return cur.Enabled
		elseif cur:IsA("LayerCollector") then
			return U.get(cur, "Enabled") ~= false
		end
		cur = cur.Parent
		guard = guard + 1
	end
	return true
end
UI.effectiveVisible = effectiveVisible

local function nodeRecord(g, rootPath, depth, vp)
	local n = {
		name = g.Name, class = g.ClassName, depth = depth, path = U.path(g),
		visible = g.Visible, visible_effective = effectiveVisible(g),
		position = U.ud2(g.Position), size = U.ud2(g.Size), anchor = U.v2(g.AnchorPoint),
		abs_position = U.v2(g.AbsolutePosition), abs_size = U.v2(g.AbsoluteSize), rotation = U.num(g.Rotation),
		z_index = g.ZIndex, layout_order = g.LayoutOrder, clips = g.ClipsDescendants,
		size_constraint = U.enumName(g.SizeConstraint), automatic_size = U.enumName(U.get(g, "AutomaticSize")),
		bg_color = U.c3(g.BackgroundColor3), bg_transparency = U.num(g.BackgroundTransparency),
		border_size = g.BorderSizePixel, border_color = U.c3(g.BorderColor3),
		attributes = U.attributes(g), tags = U.tags(g),
	}
	-- derived (computed from measurements, not read from the game)
	n.derived = { abs_center = { U.num(g.AbsolutePosition.X + g.AbsoluteSize.X / 2), U.num(g.AbsolutePosition.Y + g.AbsoluteSize.Y / 2) },
		center_fraction_of_viewport = { U.num((g.AbsolutePosition.X + g.AbsoluteSize.X / 2) / vp.X), U.num((g.AbsolutePosition.Y + g.AbsoluteSize.Y / 2) / vp.Y) },
		size_fraction_of_viewport = { U.num(g.AbsoluteSize.X / vp.X), U.num(g.AbsoluteSize.Y / vp.Y) } }
	if g:IsA("TextLabel") or g:IsA("TextButton") or g:IsA("TextBox") then
		n.text = {
			text = g.Text, size = g.TextSize, scaled = g.TextScaled, font = U.enumName(g.Font), color = U.c3(g.TextColor3), transparency = U.num(g.TextTransparency),
			stroke_color = U.c3(g.TextStrokeColor3), stroke_transparency = U.num(g.TextStrokeTransparency), x_align = U.enumName(g.TextXAlignment),
			y_align = U.enumName(g.TextYAlignment), wrapped = g.TextWrapped, rich = g.RichText, bounds = U.v2(U.get(g, "TextBounds")),
		}
		local p = U.parseDisplayNumber(g.Text)
		if p then n.text.parsed_number = p end
	end
	if g:IsA("ImageLabel") or g:IsA("ImageButton") then
		local image = U.get(g, "Image")
		n.image = { has_image = (type(image) == "string" and image ~= ""), color = U.c3(g.ImageColor3), transparency = U.num(g.ImageTransparency), scale_type = U.enumName(g.ScaleType),
			rect_offset = U.v2(U.get(g, "ImageRectOffset")), rect_size = U.v2(U.get(g, "ImageRectSize")), note = "image asset id deliberately not read" }
	end
	if g:IsA("ScrollingFrame") then
		n.scroll = { canvas_size = U.ud2(g.CanvasSize), canvas_position = U.v2(g.CanvasPosition), bar_thickness = g.ScrollBarThickness, direction = U.enumName(g.ScrollingDirection) }
	end
	if g:IsA("ViewportFrame") then n.viewport_frame = true end
	if g:IsA("GuiButton") then n.is_button = true end
	n.modifiers = modifiersOf(g)
	return n
end

-- measures every GuiObject under `roots`; returns nodes, truncatedCount
local function collectNodes(roots)
	local nodes, truncated = {}, 0
	local vp = viewport()
	local maxN = Core.Config.MaxUINodes
	local seen = {}
	local function walk(inst, depth)
		if inst.Name == OWN then return end
		if inst:IsA("GuiObject") then
			if #nodes >= maxN then
				truncated = truncated + 1
			else
				Core.tick(1)
				local ok, rec = pcall(nodeRecord, inst, nil, depth, vp)
				if ok then
					local base = U.stableId("ui", rec.path)
					local id = base
					local k = 1
					while seen[id] do
						k = k + 1
						id = base .. "#" .. k
					end
					seen[id] = true
					rec.id = id
					nodes[#nodes + 1] = rec
				else
					Store.bump("ui_node_errors")
				end
			end
		end
		for _, c in ipairs(inst:GetChildren()) do walk(c, depth + 1) end
	end
	for _, r in ipairs(roots) do walk(r, 0) end
	return nodes, truncated
end

local function screenGuiOf(inst)
	local cur = inst
	while cur do
		if cur:IsA("ScreenGui") then return cur end
		cur = cur.Parent
	end
	return nil
end

-- snapshot of the given roots (ScreenGuis or frames). label identifies the state ("HUD", "Shop open"...). Writes UI/<ScreenGui>/<label>_<session>_<n>.json
function UI.snapshot(label, roots)
	local vp = viewport()
	local nodes, truncated = collectNodes(roots)
	local first = roots[1]
	local sg = first and screenGuiOf(first)
	local guiName = sg and sg.Name or (first and first.Name) or "unknown"
	UI.seq = UI.seq + 1
	local header = {
		collector_version = Core.Config.Version, session = Exporter.session, kind = "ui_snapshot", label = label, time = U.nowIso(),
		screen_gui = sg and { name = sg.Name, enabled = sg.Enabled, display_order = U.get(sg, "DisplayOrder"), ignore_gui_inset = U.get(sg, "IgnoreGuiInset"), reset_on_spawn = U.get(sg, "ResetOnSpawn"), z_index_behavior = U.enumName(U.get(sg, "ZIndexBehavior")) } or "unknown",
		roots = {},
		viewport = U.v2(vp), touch_enabled = Core.UserInputService and Core.UserInputService.TouchEnabled or nil,
		gui_inset_top_left = (function() local ok, a = pcall(function() return Core.GuiService:GetGuiInset() end) return ok and U.v2(a) or nil end)(),
		node_count = #nodes, nodes_truncated = truncated,
		notes = { "positions are as laid out for THIS viewport; resolution and device change absolute values (scale/offset are the portable ones)", "hover/pressed/disabled states are only captured if the player triggers them while a snapshot is taken" },
	}
	for _, r in ipairs(roots) do header.roots[#header.roots + 1] = U.path(r) end
	local per = 2500
	local files = {}
	local part, i = 0, 1
	if #nodes == 0 then nodes[1] = nil end
	repeat
		part = part + 1
		local chunk = {}
		for j = i, math.min(i + per - 1, #nodes) do chunk[#chunk + 1] = nodes[j] end
		i = i + per
		local doc = {}
		for k, v in pairs(header) do doc[k] = v end
		doc.part = part
		doc.nodes = chunk
		local rel = string.format("UI/%s/%s_%s_%03d_p%d.json", U.sanitize(guiName), U.sanitize(label), tostring(Exporter.session), UI.seq, part)
		local ok, path = Exporter.writeJson(rel, doc, { kind = "ui_snapshot", records = #chunk, overwrite = true })
		if ok then files[#files + 1] = path end
	until i > #nodes
	if truncated > 0 then
		Core.warn(string.format("UI %s: %d nos alem do limite (%d) NAO foram medidos (registrado em truncated)", label, truncated, Core.Config.MaxUINodes))
	end
	local entry = { label = label, gui = guiName, nodes = #nodes, truncated = truncated, files = files, time = header.time }
	UI.snapshots[#UI.snapshots + 1] = entry
	Store.bump("ui_snapshots")
	Store.bump("ui_nodes", #nodes)
	return entry
end

-- every enabled ScreenGui (except this tool's own) as the current state ("HUD" = what is on screen right now)
function UI.snapshotAll(label)
	local pg = playerGui()
	if not pg then error("PlayerGui nao encontrado") end
	local results = {}
	for _, sg in ipairs(pg:GetChildren()) do
		if sg:IsA("ScreenGui") and sg.Name ~= OWN then
			Core.checkpoint()
			local ok, res = pcall(UI.snapshot, (label or "estado") , { sg })
			if ok then results[#results + 1] = res else Core.warn("UI " .. sg.Name .. ": " .. tostring(res)) end
		end
	end
	return results
end

-- ---------------------------------------------------------------- cards (items shown in lists/grids: shops, inventories, indexes)
-- Returns raw cards: names + texts + parsed numbers. Nothing is interpreted (no "this is the price").
function UI.cards(root)
	local out = {}
	local containers = {}
	local seenC = {}
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("UIGridLayout") or d:IsA("UIListLayout") then
			local p = d.Parent
			if p and not seenC[p] then
				seenC[p] = true
				containers[#containers + 1] = p
			end
		end
	end
	-- fallback for menus that place cards by hand (no layout object): a GuiObject with 3+ same-size children counts as a card container
	local function addRepeating(g)
		if seenC[g] then return end
		local groups, best = {}, 0
		for _, c in ipairs(g:GetChildren()) do
			if c:IsA("GuiObject") then
				local key = c.ClassName .. math.floor(c.AbsoluteSize.X + 0.5) .. "x" .. math.floor(c.AbsoluteSize.Y + 0.5)
				groups[key] = (groups[key] or 0) + 1
				if groups[key] > best then best = groups[key] end
			end
		end
		if best >= 3 then
			seenC[g] = true
			containers[#containers + 1] = g
		end
	end
	addRepeating(root)
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("GuiObject") then addRepeating(d) end
	end
	for _, cont in ipairs(containers) do
		if cont.Name ~= OWN then
			for _, child in ipairs(cont:GetChildren()) do
				if child:IsA("GuiObject") then
					local texts, numbers, images = {}, {}, 0
					local function visit(g)
						if (g:IsA("TextLabel") or g:IsA("TextButton")) and g.Text ~= "" then
							texts[#texts + 1] = { name = g.Name, text = g.Text }
							local p = U.parseDisplayNumber(g.Text)
							if p then numbers[#numbers + 1] = p end
						elseif g:IsA("ImageLabel") or g:IsA("ImageButton") then
							images = images + 1
						end
					end
					visit(child)
					for _, d in ipairs(child:GetDescendants()) do visit(d) end
					out[#out + 1] = { card = child.Name, container = U.path(cont), layout_order = child.LayoutOrder, visible = effectiveVisible(child), texts = texts, numbers = numbers, image_count = images, attributes = U.attributes(child) }
				end
			end
		end
	end
	return out
end

-- visible frames that look like an open menu: large, opaque-ish, not the whole screen
local function menuCandidates()
	local pg = playerGui()
	local found = {}
	if not pg then return found end
	local vp = viewport()
	local area = vp.X * vp.Y
	local minFrac = Core.Config.UIMinFrameFraction
	local function consider(g, depth)
		if depth > 3 then return end
		for _, c in ipairs(g:GetChildren()) do
			if c:IsA("GuiObject") and c.Name ~= OWN then
				if c.Visible and (c:IsA("Frame") or c:IsA("ImageLabel") or c:IsA("ScrollingFrame")) then
					local frac = (c.AbsoluteSize.X * c.AbsoluteSize.Y) / area
					local opaque = c.BackgroundTransparency < 0.95 or c:IsA("ImageLabel")
					if frac >= minFrac and frac <= 0.9 and opaque then
						found[U.path(c)] = c
					end
				end
				consider(c, depth + 1)
			end
		end
	end
	for _, sg in ipairs(pg:GetChildren()) do
		if sg:IsA("ScreenGui") and sg.Enabled and sg.Name ~= OWN then consider(sg, 1) end
	end
	return found
end
UI.menuCandidates = menuCandidates

function UI.openMenus()
	local out = {}
	for path, g in pairs(menuCandidates()) do out[#out + 1] = { path = path, name = g.Name, inst = g } end
	table.sort(out, function(a, b) return a.path < b.path end)
	return out
end

local function eventHook(kind, data)
	local ok, I = pcall(R, "InteractionObserver")
	if ok and I and I.record then I.record(kind, data, "ui_watch") end
end

-- passive watcher: when a menu that was closed becomes visible (opened by the player), snapshot it once per session
function UI.watch(on)
	if on == false then UI.watching = false return end
	if UI.watching then return end
	UI.watching = true
	task.spawn(function()
		local previous = {}
		local first = true
		while UI.watching do
			local ok, current = pcall(menuCandidates)
			if ok then
				if first then
					first = false
					previous = current
					for path in pairs(current) do UI.captured[path] = UI.captured[path] or "baseline" end
				else
					for path, g in pairs(current) do
						if not previous[path] then
							UI.menuLog[#UI.menuLog + 1] = { t = U.nowIso(), kind = "opened", name = g.Name, path = path }
							eventHook("ui_opened", { name = g.Name, path = path })
							if Core.Config.AutoUISnapshot and not UI.captured[path] then
								UI.captured[path] = true
								task.wait(0.7) -- let the opening animation finish before measuring
								local sg = screenGuiOf(g)
								local okS, res = pcall(UI.snapshot, "menu_" .. g.Name, { g })
								if okS then
									Core.info(string.format("menu '%s' medido (%d nos)", g.Name, res.nodes))
									local okC, cards = pcall(UI.cards, g)
									if okC and #cards > 0 then
										UI.cardsByMenu = UI.cardsByMenu or {}
										UI.cardsByMenu[g.Name] = { path = path, cards = cards, time = U.nowIso(), gui = sg and sg.Name }
									end
								else
									Core.warn("menu " .. g.Name .. ": " .. tostring(res))
								end
							end
						end
					end
					for path, g in pairs(previous) do
						if not current[path] then
							UI.menuLog[#UI.menuLog + 1] = { t = U.nowIso(), kind = "closed", name = g.Name, path = path }
							eventHook("ui_closed", { name = g.Name, path = path })
						end
					end
					previous = current
				end
			end
			task.wait(Core.Config.SampleInterval * 2)
		end
	end)
end

-- which priority menus were observed (fuzzy by name) -> NOT_OBSERVED / OBSERVED
function UI.priorityStatus()
	local out = {}
	for _, word in ipairs(UI.PRIORITY) do
		local hit = nil
		for _, s in ipairs(UI.snapshots) do
			if string.find(string.lower(s.label), string.lower(word), 1, true) then hit = s break end
		end
		out[#out + 1] = { menu = word, status = hit and "OBSERVED" or "NOT_SCANNED", snapshot = hit and hit.label or nil }
	end
	return out
end

function UI.writeMenuLog()
	if #UI.menuLog == 0 and not UI.cardsByMenu then return end
	Exporter.writeJson("UI/menu_state_log_" .. tostring(Exporter.session) .. ".json", { session = Exporter.session, log = UI.menuLog, cards_by_menu = UI.cardsByMenu or {} }, { kind = "ui_menu_log", overwrite = true })
end

return UI

end

Modules["Util"] = function(...)
-- Util: serialisation helpers shared by every module. Only plain Lua syntax (no +=, no continue, no //) so it runs on mobile executors.
local Core = ...
local U = {}

function U.num(n)
	if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then return nil end
	return math.floor(n * 1000 + 0.5) / 1000
end
local num = U.num

function U.v3(v)
	if typeof(v) ~= "Vector3" then return nil end
	return { num(v.X), num(v.Y), num(v.Z) }
end
function U.v2(v)
	if typeof(v) ~= "Vector2" then return nil end
	return { num(v.X), num(v.Y) }
end
function U.c3(c)
	if typeof(c) ~= "Color3" then return nil end
	return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end
function U.ud(u)
	if typeof(u) ~= "UDim" then return nil end
	return { num(u.Scale), u.Offset }
end
function U.ud2(v)
	if typeof(v) ~= "UDim2" then return nil end
	return { U.ud(v.X), U.ud(v.Y) }
end
function U.enumName(e)
	if e == nil then return nil end
	local s = tostring(e)
	return s:match("%.([^%.]+)$") or s
end

-- CFrame -> { pos = {x,y,z}, rot = {9 matrix values, row major}, euler_deg = {rx,ry,rz} }
function U.cf(cf)
	if typeof(cf) ~= "CFrame" then return nil end
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	local rx, ry, rz = cf:ToOrientation()
	local function q(n) return math.floor(n * 10000 + 0.5) / 10000 end
	return {
		pos = { num(x), num(y), num(z) },
		rot = { q(r00), q(r01), q(r02), q(r10), q(r11), q(r12), q(r20), q(r21), q(r22) },
		euler_deg = { num(math.deg(rx)), num(math.deg(ry)), num(math.deg(rz)) },
	}
end

function U.get(inst, prop)
	local ok, v = pcall(function() return inst[prop] end)
	if ok then return v end
	return nil
end

function U.path(inst)
	local ok, p = pcall(function() return inst:GetFullName() end)
	if ok then return p end
	return tostring(inst)
end

-- generic value encoder for attributes / simple properties
function U.encodeValue(v)
	local t = typeof(v)
	if t == "string" or t == "boolean" then return v end
	if t == "number" then return num(v) end
	if t == "Vector3" then return { __type = "Vector3", value = U.v3(v) } end
	if t == "Vector2" then return { __type = "Vector2", value = U.v2(v) } end
	if t == "Color3" then return { __type = "Color3", value = U.c3(v) } end
	if t == "UDim2" then return { __type = "UDim2", value = U.ud2(v) } end
	if t == "UDim" then return { __type = "UDim", value = U.ud(v) } end
	if t == "CFrame" then return { __type = "CFrame", value = U.cf(v) } end
	if t == "EnumItem" then return { __type = "Enum", value = U.enumName(v) } end
	if t == "BrickColor" then return { __type = "BrickColor", value = tostring(v) } end
	if t == "NumberRange" then return { __type = "NumberRange", value = { num(v.Min), num(v.Max) } } end
	return { __type = t, value = tostring(v) }
end

function U.attributes(inst)
	local ok, attrs = pcall(function() return inst:GetAttributes() end)
	if not ok or type(attrs) ~= "table" then return nil end
	local out, n = {}, 0
	for k, v in pairs(attrs) do
		out[k] = U.encodeValue(v)
		n = n + 1
	end
	if n == 0 then return nil end
	return out
end

function U.tags(inst)
	local ok, t = pcall(function() return Core.CollectionService:GetTags(inst) end)
	if ok and type(t) == "table" and #t > 0 then return t end
	return nil
end

-- FNV-1a 32 bit: stable ids that survive sessions
local function xor32(a, b)
	if bit32 and bit32.bxor then return bit32.bxor(a, b) end
	local r, bitv = 0, 1
	for _ = 1, 32 do
		local x, y = a % 2, b % 2
		if x ~= y then r = r + bitv end
		a, b, bitv = (a - x) / 2, (b - y) / 2, bitv * 2
	end
	return r
end
function U.hash32(s)
	local h = 2166136261
	for i = 1, #s do
		h = xor32(h, string.byte(s, i))
		h = (h * 16777619) % 4294967296
	end
	return h
end
function U.stableId(prefix, key)
	return prefix .. "_" .. string.format("%08x", U.hash32(key)) .. string.format("%04x", #key % 65536)
end

-- AABB of a part given its CFrame and size (exact for rotated parts)
function U.aabb(cf, size)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	local hx, hy, hz = size.X / 2, size.Y / 2, size.Z / 2
	local ex = math.abs(r00) * hx + math.abs(r01) * hy + math.abs(r02) * hz
	local ey = math.abs(r10) * hx + math.abs(r11) * hy + math.abs(r12) * hz
	local ez = math.abs(r20) * hx + math.abs(r21) * hy + math.abs(r22) * hz
	return x - ex, y - ey, z - ez, x + ex, y + ey, z + ez
end

-- display numbers like "125,280,955", "84.9Od", "21.5Qid", "296%" -> { display = original, approx = number or nil, suffix = ... }
local SUFFIX = { K = 1e3, M = 1e6, B = 1e9, T = 1e12, Qa = 1e15, Qi = 1e18, Sx = 1e21, Sp = 1e24, Oc = 1e27, No = 1e30, Dc = 1e33,
	Ud = 1e36, Dd = 1e39, Td = 1e42, Qad = 1e45, Qid = 1e48, Sxd = 1e51, Spd = 1e54, Ocd = 1e57, Nod = 1e60, Vg = 1e63 }
function U.parseDisplayNumber(text)
	if type(text) ~= "string" then return nil end
	local clean = text:gsub("<[^>]+>", ""):gsub("^%s+", ""):gsub("%s+$", "")
	local pct = clean:match("^([%d%.,]+)%%$")
	if pct then
		local n = tonumber((pct:gsub(",", "")))
		if n then return { display = clean, approx = n, unit = "percent", note = "approx_from_display" } end
	end
	local numPart, suf = clean:match("^([%d%.,]+)%s*(%a*)$")
	if not numPart then return nil end
	local n = tonumber((numPart:gsub(",", "")))
	if not n then return nil end
	if suf == "" then return { display = clean, approx = n, note = "exact_integer_text" } end
	local mult = SUFFIX[suf]
	if mult then return { display = clean, approx = n * mult, suffix = suf, note = "approx_from_display" } end
	return { display = clean, approx = nil, suffix = suf, note = "unknown_suffix" }
end

function U.isCharacter(inst)
	local m = inst:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then return true end
		m = m:FindFirstAncestorOfClass("Model")
	end
	return false
end

-- name-pattern classification: never a reason to drop an object; unmatched objects stay "unclassified"
local RULES = {
	{ "gift", "^Gift" }, { "gift", "Gift%d*$" },
	{ "box", "^Box%d*$" }, { "box", "^Static" }, { "box", "^Ghost" }, { "box", "Box%d+$" }, { "box", "^HalloweenBox" },
	{ "egg", "Egg" }, { "chest", "Chest" }, { "chest", "Crate" }, { "portal", "Portal" },
	{ "weapon_stand", "^Stand$" }, { "shop", "Shop" }, { "shop", "Armory" },
	{ "machine", "[Mm]achine" }, { "machine", "Enchant" }, { "machine", "Upgrade" }, { "machine", "Crafting" },
	{ "npc", "NPC" }, { "pet", "Pet$" }, { "tree", "Tree" }, { "rock", "Rock" }, { "rock", "Boulder" },
	{ "building", "Building" }, { "building", "House" }, { "building", "Castle" }, { "building", "Tower" }, { "building", "Hut" },
	{ "decoration", "Fence" }, { "decoration", "Barrel" }, { "decoration", "Banner" }, { "decoration", "Flag" }, { "decoration", "Pumpkin" },
	{ "decoration", "Decor" }, { "decoration", "Log" }, { "decoration", "Bush" }, { "decoration", "Flower" },
	{ "weapon", "Sword" }, { "weapon", "Blade" }, { "weapon", "Hammer" }, { "weapon", "Axe" },
	{ "event", "Halloween" }, { "event", "Event" },
}
function U.classify(name, path)
	for _, rule in ipairs(RULES) do
		if string.find(name, rule[2]) then return rule[1], "name_pattern" end
	end
	if path then
		local p = string.lower(path)
		if string.find(p, "decor", 1, true) or string.find(p, "structure", 1, true) then return "scenery", "path_pattern" end
	end
	return "unclassified", "none"
end

function U.nowIso()
	local ok, s = pcall(function() return os.date("!%Y-%m-%dT%H:%M:%SZ") end)
	return ok and s or tostring(os.time())
end

function U.sanitize(name)
	return (tostring(name):gsub("[^%w_%-]", "_"))
end

function U.shallowCount(t)
	local n = 0
	for _ in pairs(t) do n = n + 1 end
	return n
end

return U

end

Modules["WeaponCollector"] = function(...)
-- WeaponCollector: weapon stands in the world, weapon lists in opened menus and the tools the player carries (name, tooltip, attributes, handle size).
-- Scripts inside tools are not read; meshes / textures / animations are not read.
local Core, R = ...
local C = R("CatalogCommon")
local U = R("Util")
local W = {}

local function toolEntries()
	local out = {}
	local lp = Core.LocalPlayer
	if not lp then return out end
	local function add(tool, where)
		local handle = tool:FindFirstChild("Handle")
		out[#out + 1] = {
			key = "tool|" .. tool.Name, id = U.stableId("tool", tool.Name), name = tool.Name, class = tool.ClassName, location = where,
			tooltip = U.get(tool, "ToolTip"), can_be_dropped = U.get(tool, "CanBeDropped"), requires_handle = U.get(tool, "RequiresHandle"),
			grip = U.cf(U.get(tool, "Grip")), handle_size = handle and handle:IsA("BasePart") and U.v3(handle.Size) or "unknown",
			attributes = U.attributes(tool), tags = U.tags(tool), source = "observed_equipment",
			note = "stats are only what the game exposes as attributes/tooltip; real damage must be observed with REGISTRAR DANO",
		}
	end
	local bp = lp:FindFirstChildOfClass("Backpack")
	if bp then for _, t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then add(t, "Backpack") end end end
	local ch = lp.Character
	if ch then for _, t in ipairs(ch:GetChildren()) do if t:IsA("Tool") then add(t, "Character(equipped)") end end end
	return out
end

function W.measure()
	return C.run("weapons", { weapon_stand = true, weapon = true }, { "weapon", "armory", "sword", "inventory" }, { instances = true, extra = toolEntries })
end
return W
end

Modules["WorldCollector"] = function(...)
-- WorldCollector: identifies worlds (children of Workspace.Worlds) and their folder structure, and writes Worlds/<World>/world_info.json.
-- The structure is copied as found. Order of areas follows the leading number of the folder name or the Index attribute when present.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local W = {}

W.worlds = {}   -- name -> info

local function childrenSummary(inst, limit)
	local list = {}
	local ok, kids = pcall(function() return inst:GetChildren() end)
	if not ok then return list end
	for i, c in ipairs(kids) do
		if i > (limit or 200) then
			list[#list + 1] = { name = "...", class = "truncated", note = (#kids - limit) .. " more children not listed" }
			break
		end
		list[#list + 1] = { name = c.Name, class = c.ClassName, children = #c:GetChildren() }
	end
	return list
end

local function areaIndex(folder)
	local idx = U.get(folder, "Index")
	local ok, attr = pcall(function() return folder:GetAttribute("Index") end)
	if ok and type(attr) == "number" then return attr, "attribute:Index" end
	local lead = folder.Name:match("^(%d+)")
	if lead then return tonumber(lead), "folder_name_prefix" end
	return nil, "unknown"
end

function W.identify()
	W.worlds = {}
	local worldsFolder = Core.Workspace:FindFirstChild("Worlds")
	if not worldsFolder then
		Core.warn("Workspace.Worlds nao existe nesta sessao: nenhum mundo reconhecido")
		return W.worlds
	end
	for _, w in ipairs(worldsFolder:GetChildren()) do
		local info = {
			name = w.Name, class = w.ClassName, path = U.path(w), attributes = U.attributes(w), tags = U.tags(w),
			structure = childrenSummary(w), areas = {}, lobby_present = w:FindFirstChild("Lobby") ~= nil,
		}
		local areas = w:FindFirstChild("Areas") or w:FindFirstChild("EventAreas")
		if areas then
			info.areas_folder = areas.Name
			for _, a in ipairs(areas:GetChildren()) do
				local idx, source = areaIndex(a)
				info.areas[#info.areas + 1] = { name = a.Name, class = a.ClassName, index = idx, index_source = source, attributes = U.attributes(a), children = childrenSummary(a, 60) }
			end
			table.sort(info.areas, function(x, y)
				if x.index and y.index then return x.index < y.index end
				return x.name < y.name
			end)
		end
		info.area_count = #info.areas
		W.worlds[w.Name] = info
	end
	return W.worlds
end

function W.count()
	local n, areas = 0, 0
	for _, w in pairs(W.worlds) do
		n = n + 1
		areas = areas + (w.area_count or 0)
	end
	return n, areas
end

local function distanceBetweenAreas(world)
	local A = R("AreaCollector")
	local out = {}
	local prev
	for _, a in ipairs(world.areas) do
		local s = A.stats[world.name .. "/" .. a.name]
		if s and s.min[1] ~= math.huge then
			local c = { (s.min[1] + s.max[1]) / 2, (s.min[2] + s.max[2]) / 2, (s.min[3] + s.max[3]) / 2 }
			if prev then
				local dx, dy, dz = c[1] - prev.c[1], c[2] - prev.c[2], c[3] - prev.c[3]
				out[#out + 1] = { from = prev.name, to = a.name, delta = { U.num(dx), U.num(dy), U.num(dz) }, distance = U.num(math.sqrt(dx * dx + dy * dy + dz * dz)) }
			end
			prev = { name = a.name, c = c }
		end
	end
	return out
end

-- writes world_info.json (+ world geometry) for every identified world
function W.write()
	W.identify()
	local A = R("AreaCollector")
	for name, info in pairs(W.worlds) do
		local dir = "Worlds/" .. U.sanitize(name)
		local doc = {
			collector_version = Core.Config.Version, session = Exporter.session, world = info,
			area_distances = distanceBetweenAreas(info),
			portals_gates = "see Worlds/" .. U.sanitize(name) .. "/Areas/<area>/portals.json and the per-area objects.json (objects classified by name)",
			unknown = { "regions not loaded in the client are not listed", "blocked regions are not detectable without entering them" },
		}
		Exporter.writeJson(dir .. "/world_info.json", doc, { versioned = true, kind = "world_info" })
		-- world geometry = union of its zones
		local min, max = { math.huge, math.huge, math.huge }, { -math.huge, -math.huge, -math.huge }
		local zones = {}
		for key, s in pairs(A.stats) do
			if s.world == name and s.min[1] ~= math.huge then
				for i = 1, 3 do
					if s.min[i] < min[i] then min[i] = s.min[i] end
					if s.max[i] > max[i] then max[i] = s.max[i] end
				end
				zones[#zones + 1] = { key = key, zone = s.zone, area = s.area, min = { U.num(s.min[1]), U.num(s.min[2]), U.num(s.min[3]) }, max = { U.num(s.max[1]), U.num(s.max[2]), U.num(s.max[3]) }, parts = s.parts, models = s.models }
			end
		end
		if #zones > 0 then
			Exporter.writeJson(dir .. "/geometry.json", {
				collector_version = Core.Config.Version, session = Exporter.session, world = name, zones = zones,
				bbox = { min = { U.num(min[1]), U.num(min[2]), U.num(min[3]) }, max = { U.num(max[1]), U.num(max[2]), U.num(max[3]) } },
			}, { versioned = true, kind = "world_geometry" })
		end
	end
	-- anything else at the top of the Workspace is listed so nothing is hidden by the "Worlds" assumption
	local top = {}
	for _, c in ipairs(Core.Workspace:GetChildren()) do top[#top + 1] = { name = c.Name, class = c.ClassName, children = #c:GetChildren() } end
	Exporter.writeJson("Worlds/workspace_top_level.json", { collector_version = Core.Config.Version, session = Exporter.session, children = top }, { versioned = true, kind = "workspace_top_level" })
end

return W

end

Core = (function()
-- Core: configuration, services, logging, progress, and the cooperative scheduler (batches, pause, cancel).
local Core = {}

Core.ENV = (type(getgenv) == "function" and getgenv()) or _G

Core.Config = {
	Version = "2.0.0",
	Root = "UnboxingSimulatorData",
	CellSize = 128,            -- studs; the map is divided into square cells (X/Z) to track what has been observed
	BatchSize = 350,           -- instances processed before yielding
	BatchYield = 0.02,         -- seconds to wait between batches
	MaxPartsPerModel = 1500,   -- parts recorded per model; anything above is counted in truncated_objects.json (never dropped silently)
	MaxScanInstances = 400000, -- safety limit for one scan (reported when reached)
	RecordsPerFile = 250,      -- records per exported chunk file
	AutoUISnapshot = true,     -- snapshot a menu when it opens
	UIMinFrameFraction = 0.12, -- a frame covering this fraction of the screen counts as "a menu"
	MaxUINodes = 20000,
	SampleInterval = 0.25,     -- observers sample the screen this often (seconds)
	MaxEvents = 5000,
	AreaRadius = 350,           -- radius used by MAPEAR AREA ATUAL / MEDIR *
	IncludePlayerIdentity = false, -- player name / user id are NOT written to the export unless this is set to true
}

local function svc(name)
	local ok, s = pcall(game.GetService, game, name)
	if ok then return s end
	return nil
end
Core.svc = svc
Core.Players = svc("Players")
Core.HttpService = svc("HttpService")
Core.Workspace = svc("Workspace")
Core.Lighting = svc("Lighting")
Core.ReplicatedStorage = svc("ReplicatedStorage")
Core.CollectionService = svc("CollectionService")
Core.GuiService = svc("GuiService")
Core.UserInputService = svc("UserInputService")
Core.RunService = svc("RunService")
Core.ProximityPromptService = svc("ProximityPromptService")
Core.LocalPlayer = Core.Players and Core.Players.LocalPlayer

-- ---------------------------------------------------------------- logging / progress
Core.logLines = {}
Core.listeners = { log = {}, progress = {}, status = {} }

function Core.on(kind, fn)
	local list = Core.listeners[kind]
	list[#list + 1] = fn
end
local function fire(kind, a, b, c)
	for _, fn in ipairs(Core.listeners[kind]) do pcall(fn, a, b, c) end
end

function Core.log(level, msg)
	local line = "[" .. level .. "] " .. tostring(msg)
	local lines = Core.logLines
	lines[#lines + 1] = line
	if #lines > 400 then table.remove(lines, 1) end
	pcall(print, "[UBC] " .. line)
	fire("log", line, level)
end
function Core.info(msg) Core.log("info", msg) end
function Core.warn(msg) Core.log("warn", msg) end
function Core.err(msg) Core.log("erro", msg) end

Core.progress = { done = 0, total = 0, text = "ocioso" }
function Core.setProgress(done, total, text)
	local p = Core.progress
	p.done, p.total = done, total
	if text then p.text = text end
	fire("progress", p)
end

-- ---------------------------------------------------------------- scheduler
Core.control = { paused = false, cancelled = false, busy = false, op = nil, batches = 0, cancelAfterBatches = nil }

function Core.beginOperation(name)
	local c = Core.control
	if c.busy then return false, "ja existe uma operacao em andamento: " .. tostring(c.op) end
	c.busy, c.op, c.cancelled, c.paused, c.batches = true, name, false, false, 0
	Core.setProgress(0, 0, name)
	fire("status", "busy", name)
	return true
end

function Core.endOperation(state)
	local c = Core.control
	c.busy, c.op = false, nil
	fire("status", state or "idle")
end

local ticks = 0
-- call inside loops; yields every BatchSize calls, waits while paused, raises "CANCELLED" when the user cancelled
function Core.tick(count)
	ticks = ticks + (count or 1)
	if ticks >= Core.Config.BatchSize then
		ticks = 0
		local c = Core.control
		c.batches = c.batches + 1
		if c.cancelAfterBatches and c.batches >= c.cancelAfterBatches then
			c.cancelAfterBatches = nil
			c.cancelled = true
		end
		while c.paused and not c.cancelled do task.wait(0.2) end
		if c.cancelled then error("CANCELLED", 0) end
		task.wait(Core.Config.BatchYield)
	end
end

function Core.checkpoint()
	local c = Core.control
	while c.paused and not c.cancelled do task.wait(0.2) end
	if c.cancelled then error("CANCELLED", 0) end
end

-- runs fn(...) as an operation: error handling, cancel, state report. Returns ok, resultOrError
function Core.runOperation(name, fn, ...)
	local started, why = Core.beginOperation(name)
	if not started then Core.warn(why) return false, why end
	Core.info("iniciando: " .. name)
	local ok, result = pcall(fn, ...)
	if ok then
		Core.info("concluido: " .. name)
		Core.endOperation("done")
		return true, result
	end
	if tostring(result) == "CANCELLED" then
		Core.warn("cancelado: " .. name .. " (dados ja coletados foram mantidos)")
		Core.endOperation("cancelled")
		return false, "CANCELLED"
	end
	Core.err(name .. ": " .. tostring(result))
	Core.endOperation("error")
	return false, tostring(result)
end

Core.modules = {}
return Core

end)()


local SUFFIX = { k = 1e3, m = 1e6, b = 1e9, t = 1e12, qa = 1e15, qi = 1e18, sx = 1e21, sp = 1e24, oc = 1e27, no = 1e30, dc = 1e33 }
function Util.parseNumber(s)
	if type(s) ~= "string" then return nil end
	local numstr, suf = s:match("(%d[%d,]*%.?%d*)%s*(%a*)")
	if not numstr then return nil end
	numstr = numstr:gsub(",", "")
	local n = tonumber(numstr)
	if not n then return nil end
	local mult = SUFFIX[suf:lower()]
	if mult then n = n * mult end
	return n
end
local parseNumber = Util.parseNumber

local function plain(v, depth)
	depth = depth or 0
	if v == nil or v == NULL then return NULL end
	local t = typeof(v)
	if t == "string" then return trunc(v)
	elseif t == "number" then return Util.num(v)
	elseif t == "boolean" then return v
	elseif t == "Vector3" then return { x = Util.num(v.X), y = Util.num(v.Y), z = Util.num(v.Z) }
	elseif t == "Vector2" then return { x = Util.num(v.X), y = Util.num(v.Y) }
	elseif t == "CFrame" then
		local out = { position = { x = Util.num(v.X), y = Util.num(v.Y), z = Util.num(v.Z) } }
		local ok, rx, ry, rz = pcall(v.ToOrientation, v)
		if ok then out.orientation_degrees = { x = Util.num(math.deg(rx)), y = Util.num(math.deg(ry)), z = Util.num(math.deg(rz)) } end
		return out
	elseif t == "Color3" then
		local r, g, b = floor(v.R * 255 + 0.5), floor(v.G * 255 + 0.5), floor(v.B * 255 + 0.5)
		return { r = r, g = g, b = b, hex = string.format("#%02X%02X%02X", r, g, b) }
	elseif t == "UDim2" then
		return { x = { scale = Util.num(v.X.Scale), offset = v.X.Offset }, y = { scale = Util.num(v.Y.Scale), offset = v.Y.Offset } }
	elseif t == "UDim" then
		return { scale = Util.num(v.Scale), offset = v.Offset }
	elseif t == "BrickColor" then return v.Name
	elseif t == "EnumItem" then return tostring(v)
	elseif t == "Instance" then return path(v)
	elseif t == "table" then
		if depth >= 4 then return "<table>" end
		local out, n = {}, 0
		if #v > 0 then
			for i = 1, #v do
				if n >= 60 then break end
				out[#out + 1] = plain(v[i], depth + 1)
				n = n + 1
			end
			return L(out)
		end
		for k, x in pairs(v) do
			if n >= 60 then break end
			out[tostring(k)] = plain(x, depth + 1)
			n = n + 1
		end
		return out
	end
	return trunc(tostring(v))
end
Util.plain = plain

function Util.attrs(inst)
	local ok, a = pcall(inst.GetAttributes, inst)
	if not ok or type(a) ~= "table" then return {} end
	local out, n = {}, 0
	for k, v in pairs(a) do
		if n >= CONFIG.MAX_ATTRS then break end
		out[tostring(k)] = plain(v, 1)
		n = n + 1
	end
	return out
end

function Util.tags(inst)
	local ok, t = pcall(CollectionService.GetTags, CollectionService, inst)
	local out = {}
	if ok and type(t) == "table" then
		for i, v in ipairs(t) do
			if i > 20 then break end
			out[#out + 1] = trunc(v)
		end
	end
	return L(out)
end

-- Direct ValueBase children (and one level inside Configuration/Folder children).
function Util.valueChildren(inst, depth)
	depth = depth or 0
	local out, n = {}, 0
	local ok, ch = pcall(inst.GetChildren, inst)
	if not ok then return out end
	for _, c in ipairs(ch) do
		if n >= 40 then break end
		if c:IsA("ValueBase") then
			local okv, val = pcall(rawGet, c, "Value")
			if okv then
				local key = c.Name
				if out[key] ~= nil then key = key .. "#" .. n end
				out[key] = plain(val, 1)
				n = n + 1
			end
		elseif depth == 0 and (c:IsA("Configuration") or c:IsA("Folder")) then
			local sub = Util.valueChildren(c, 1)
			if next(sub) ~= nil then
				out[c.Name] = sub
				n = n + 1
			end
		end
	end
	return out
end


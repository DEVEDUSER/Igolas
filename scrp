Modules["DamageObserver"] = function(...)
-- DamageObserver: a MANUAL observation session. The player hits boxes normally; this module only watches the boxes near the player
-- (attribute changes, displayed text changes, destruction, respawn) and the economy numbers, then separates:
--   displayed  = what the screen / attributes literally showed
--   measured   = differences computed between consecutive observed values
--   estimated  = statistics derived from the measurements (always flagged, with sample size)
-- It never attacks, never fires remotes and never touches the boxes.
local Core, R = ...
local U = R("Util")
local Exporter = R("DataExporter")
local D = {}

D.sessions = {}
D.active = nil

local function median(list)
	if #list == 0 then return nil end
	local c = {}
	for i, v in ipairs(list) do c[i] = v end
	table.sort(c)
	local n = #c
	if n % 2 == 1 then return c[(n + 1) / 2] end
	return (c[n / 2] + c[n / 2 + 1]) / 2
end
local function mean(list)
	if #list == 0 then return nil end
	local s = 0
	for _, v in ipairs(list) do s = s + v end
	return s / #list
end

local function isBoxModel(m)
	if not m:IsA("Model") then return false end
	local cat = U.classify(m.Name, nil)
	return cat == "box" or cat == "gift"
end

local function now(s) return U.num(os.clock() - s.clock0) end

local function event(s, kind, box, data)
	if #s.events >= Core.Config.MaxEvents then
		s.dropped = s.dropped + 1
		return
	end
	s.events[#s.events + 1] = { clock = now(s), t = U.nowIso(), kind = kind, box = box and box.id or nil, data = data }
end

local function watchModel(s, model, why)
	if s.boxes[model] then return end
	local okP, pivot = pcall(function() return model:GetPivot() end)
	local okS, ext = pcall(function() return model:GetExtentsSize() end)
	local b = { id = U.stableId("dbox", U.path(model) .. "|" .. tostring(s.counter)), name = model.Name, path = U.path(model), position = okP and U.v3(pivot.Position) or "unknown",
		size = okS and U.v3(ext) or "unknown", attributes_initial = U.attributes(model), texts_initial = {}, text_values = {}, seen_via = why, watch_clock = now(s) }
	s.counter = s.counter + 1
	s.boxes[model] = b
	s.boxList[#s.boxList + 1] = b
	local attrs = {}
	pcall(function() for k, v in pairs(model:GetAttributes()) do attrs[k] = v end end)
	s.conns[#s.conns + 1] = model.AttributeChanged:Connect(function(name)
		local new = model:GetAttribute(name)
		event(s, "attribute_change", b, { attribute = name, old = U.encodeValue(attrs[name]), new = U.encodeValue(new) })
		if type(new) == "number" and type(attrs[name]) == "number" then
			b.attr_values = b.attr_values or {}
			b.attr_values[#b.attr_values + 1] = { name = name, clock = now(s), old = attrs[name], new = new, delta = new - attrs[name] }
		end
		attrs[name] = new
	end)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("TextLabel") then
			b.texts_initial[#b.texts_initial + 1] = { name = d.Name, text = d.Text }
			s.conns[#s.conns + 1] = d:GetPropertyChangedSignal("Text"):Connect(function()
				local p = U.parseDisplayNumber(d.Text)
				event(s, "text_change", b, { label = d.Name, text = d.Text, parsed = p })
				-- a clean number is one value; a mixed text ("120 / 200", "HP 30") yields one series per number found, in order
				local nums = {}
				if p and p.approx then
					nums[1] = p
				else
					for tok in string.gmatch(d.Text, "%d[%d%.,]*%a*") do
						local q = U.parseDisplayNumber(tok)
						if q and q.approx then nums[#nums + 1] = q end
					end
				end
				for idx, q in ipairs(nums) do
					local key = d.Name .. (idx > 1 and ("#" .. idx) or "")
					local list = b.text_values[key]
					if not list then
						list = {}
						b.text_values[key] = list
					end
					list[#list + 1] = { clock = now(s), value = q.approx, display = q.display, from_text = d.Text }
				end
			end)
		end
	end
	s.conns[#s.conns + 1] = model.AncestryChanged:Connect(function(_, parent)
		if parent == nil or not model:IsDescendantOf(Core.Workspace) then
			if not b.destroyed_clock then
				b.destroyed_clock = now(s)
				event(s, "destroyed", b, { position = b.position })
			end
		end
	end)
	event(s, "watching", b, { why = why, position = b.position, size = b.size })
end

function D.isActive() return D.active ~= nil end

function D.start(opts)
	opts = opts or {}
	if D.active then return false, "ja existe uma sessao de dano ativa" end
	local char = Core.LocalPlayer and Core.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local radius = opts.radius or 60
	local tool = char and char:FindFirstChildOfClass("Tool")
	local s = {
		id = "damage_" .. tostring(Exporter.session) .. "_" .. (#D.sessions + 1), started = U.nowIso(), clock0 = os.clock(), radius = radius, note = opts.note,
		equipped_tool = tool and tool.Name or "unknown (nenhuma ferramenta equipada)", events = {}, dropped = 0, boxes = {}, boxList = {}, conns = {}, counter = 1,
		inputs = {}, economy = {}, start_position = root and U.v3(root.Position) or "unknown", pending_respawn = {}, respawns = {},
	}
	D.active = s
	-- boxes already near the player
	if root then
		for _, m in ipairs(Core.Workspace:GetDescendants()) do
			if isBoxModel(m) then
				local ok, pv = pcall(function() return m:GetPivot() end)
				if ok and (pv.Position - root.Position).Magnitude <= radius then watchModel(s, m, "near_player_at_start") end
			end
		end
	end
	-- boxes that appear later (respawn)
	s.conns[#s.conns + 1] = Core.Workspace.DescendantAdded:Connect(function(m)
		if not isBoxModel(m) then return end
		task.defer(function()
			local ok, pv = pcall(function() return m:GetPivot() end)
			if not ok then return end
			local rootNow0 = Core.LocalPlayer.Character and Core.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if rootNow0 and (pv.Position - rootNow0.Position).Magnitude <= radius then
				event(s, "spawned", nil, { name = m.Name, position = U.v3(pv.Position) }) -- only boxes near the player (streaming adds far ones constantly)
			end
			-- respawn: a destroyed box of the same name, within 3 studs, not matched yet
			for _, b in ipairs(s.boxList) do
				if b.destroyed_clock and not b.respawn_clock and b.name == m.Name and type(b.position) == "table" then
					local dx, dy, dz = b.position[1] - pv.Position.X, b.position[2] - pv.Position.Y, b.position[3] - pv.Position.Z
					if math.sqrt(dx * dx + dy * dy + dz * dz) <= 3 then
						b.respawn_clock = now(s)
						s.respawns[#s.respawns + 1] = { box = b.id, name = b.name, seconds = U.num(b.respawn_clock - b.destroyed_clock) }
						break
					end
				end
			end
			local rootNow = Core.LocalPlayer.Character and Core.LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
			if rootNow and (pv.Position - rootNow.Position).Magnitude <= radius then watchModel(s, m, "spawned_during_session") end
		end)
	end)
	-- player inputs (only counted: when the player acts, to relate with the changes seen)
	if Core.UserInputService then
		s.conns[#s.conns + 1] = Core.UserInputService.InputBegan:Connect(function(input)
			local t = input.UserInputType
			if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch or t == Enum.UserInputType.Keyboard then
				if #s.inputs < 3000 then s.inputs[#s.inputs + 1] = U.num(os.clock() - s.clock0) end
			end
		end)
	end
	-- economy
	local E = R("EconomyObserver")
	E.start()
	s.econListener = function(key, old, new)
		local delta = nil
		if old.approx and new.approx then delta = new.approx - old.approx end
		s.economy[#s.economy + 1] = { clock = now(s), key = key, from = old.display, to = new.display, delta_approx = delta and U.num(delta) or nil }
	end
	E.listeners[#E.listeners + 1] = s.econListener
	Core.info(string.format("sessao de dano iniciada: %d caixas observadas num raio de %d. Bata nas caixas normalmente e depois use PARAR.", #s.boxList, radius))
	return true, s
end

local function summarize(s)
	local displayed, measured, estimated = { boxes = {} }, { boxes = {} }, {}
	local deltasAll, intervals, ttk, destroyedCount = {}, {}, {}, 0
	for _, b in ipairs(s.boxList) do
		displayed.boxes[#displayed.boxes + 1] = { id = b.id, name = b.name, position = b.position, size = b.size, attributes_initial = b.attributes_initial, texts_initial = b.texts_initial }
		local m = { id = b.id, name = b.name, destroyed_clock = b.destroyed_clock, respawn_clock = b.respawn_clock, attribute_changes = b.attr_values, label_series = {}, label_deltas = {} }
		local firstChange = nil
		for label, list in pairs(b.text_values) do
			m.label_series[label] = list
			local deltas = {}
			for i = 2, #list do
				local dv = list[i].value - list[i - 1].value
				deltas[#deltas + 1] = { clock = list[i].clock, delta = U.num(dv) }
				if dv < 0 then
					deltasAll[#deltasAll + 1] = -dv
					intervals[#intervals + 1] = list[i].clock - list[i - 1].clock
				end
			end
			m.label_deltas[label] = deltas
			if list[1] and (not firstChange or list[1].clock < firstChange) then firstChange = list[1].clock end
		end
		for _, a in ipairs(b.attr_values or {}) do
			if a.delta < 0 then
				deltasAll[#deltasAll + 1] = -a.delta
			end
			if not firstChange or a.clock < firstChange then firstChange = a.clock end
		end
		if b.destroyed_clock then
			destroyedCount = destroyedCount + 1
			if firstChange then
				m.seconds_first_change_to_destroyed = U.num(b.destroyed_clock - firstChange)
				ttk[#ttk + 1] = b.destroyed_clock - firstChange
			end
		end
		measured.boxes[#measured.boxes + 1] = m
	end
	-- only boxes with something measured are listed in full; the rest are counted (no silent omission)
	local withData = {}
	for _, m in ipairs(measured.boxes) do
		local has = m.destroyed_clock ~= nil or m.attribute_changes ~= nil or next(m.label_series) ~= nil
		if has then withData[#withData + 1] = m end
	end
	measured.boxes_without_measurements = #measured.boxes - #withData
	measured.boxes = withData
	local dispAll = displayed.boxes
	displayed.boxes_total = #dispAll
	displayed.boxes = {}
	for i = 1, math.min(200, #dispAll) do displayed.boxes[i] = dispAll[i] end
	displayed.boxes_omitted = #dispAll - #displayed.boxes
	measured.respawns = s.respawns
	measured.economy_changes = s.economy
	measured.player_inputs_count = #s.inputs
	-- reward candidates: economy changes within 2 s after a destruction (correlation only)
	local rewards = {}
	for _, b in ipairs(s.boxList) do
		if b.destroyed_clock then
			for _, e in ipairs(s.economy) do
				if e.clock >= b.destroyed_clock - 0.5 and e.clock <= b.destroyed_clock + 2 then
					rewards[#rewards + 1] = { box = b.id, name = b.name, economy_key = e.key, from = e.from, to = e.to, delta_approx = e.delta_approx, seconds_after_destroy = U.num(e.clock - b.destroyed_clock) }
				end
			end
		end
	end
	measured.reward_candidates = rewards
	local respSeconds = {}
	for _, r in ipairs(s.respawns) do respSeconds[#respSeconds + 1] = r.seconds end
	estimated.damage_per_decrease = { n = #deltasAll, mean = mean(deltasAll) and U.num(mean(deltasAll)) or "unknown", median = median(deltasAll) and U.num(median(deltasAll)) or "unknown" }
	estimated.seconds_between_decreases = { n = #intervals, median = median(intervals) and U.num(median(intervals)) or "unknown" }
	estimated.seconds_to_destroy = { n = #ttk, median = median(ttk) and U.num(median(ttk)) or "unknown" }
	estimated.respawn_seconds = { n = #respSeconds, median = median(respSeconds) and U.num(median(respSeconds)) or "unknown" }
	if #deltasAll > 0 and #intervals > 0 and median(intervals) > 0 then
		estimated.damage_per_second_rough = U.num(mean(deltasAll) / median(intervals))
	end
	estimated.warning = "estimates come from few manual samples: the game may batch hits, show rounded values or use criticals; repeat the session several times"
	return displayed, measured, estimated, destroyedCount
end

function D.stop()
	local s = D.active
	if not s then return false, "nenhuma sessao de dano ativa" end
	D.active = nil
	for _, c in ipairs(s.conns) do pcall(function() c:Disconnect() end) end
	local E = R("EconomyObserver")
	for i, fn in ipairs(E.listeners) do
		if fn == s.econListener then
			table.remove(E.listeners, i)
			break
		end
	end
	local displayed, measured, estimated, destroyed = summarize(s)
	local doc = {
		collector_version = Core.Config.Version, session = Exporter.session, kind = "damage_observation", id = s.id, started = s.started, ended = U.nowIso(),
		duration_seconds = U.num(os.clock() - s.clock0), radius = s.radius, equipped_tool = s.equipped_tool, player_note = s.note, start_position = s.start_position,
		boxes_watched = #s.boxList, boxes_destroyed = destroyed, displayed = displayed, measured = measured, estimated = estimated,
		events = s.events, events_dropped_over_limit = s.dropped,
		notes = { "the player did the hits; this tool only watched", "damage is NOT assumed: if no health text/attribute exists, 'measured' stays empty and that is the honest result" },
	}
	Exporter.writeJson("Observations/" .. s.id .. ".json", doc, { kind = "damage_session", records = #s.events, overwrite = true })
	s.summary = { id = s.id, boxes_watched = #s.boxList, destroyed = destroyed, events = #s.events, respawns = #s.respawns, decreases = estimated.damage_per_decrease.n }
	D.sessions[#D.sessions + 1] = s.summary
	Core.info(string.format("sessao de dano %s: %d caixas, %d destruidas, %d eventos, %d respawns medidos", s.id, #s.boxList, destroyed, #s.events, #s.respawns))
	return true, s.summary
end

return D
end

Modules["DataExporter"] = function(...)
-- DataExporter: folder structure, incremental chunk files, versioned index files. Never overwrites old data silently.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = {}

-- ---------------------------------------------------------------- file system abstraction
-- Uses the executor's writefile/readfile/makefolder; ENV.UBC_FS (a table with the same functions) overrides them (used by the tests).
local ENV = Core.ENV
local function fsFn(name)
	if type(ENV.UBC_FS) == "table" and type(ENV.UBC_FS[name]) == "function" then return ENV.UBC_FS[name] end
	local f = ENV[name]
	if type(f) == "function" then return f end
	local ok, g = pcall(function() return getfenv and getfenv(0)[name] end)
	if ok and type(g) == "function" then return g end
	return nil
end

local FS = { memory = {}, folders = {}, writes = 0, failures = 0 }
Exporter.FS = FS

function FS.canWrite()
	return fsFn("writefile") ~= nil
end

local function mkdirOne(path)
	if FS.folders[path] then return end
	local isfolder, makefolder = fsFn("isfolder"), fsFn("makefolder")
	if makefolder then
		local exists = false
		if isfolder then
			local ok, v = pcall(isfolder, path)
			exists = ok and v == true
		end
		if not exists then pcall(makefolder, path) end
	end
	FS.folders[path] = true
end

function FS.mkdirs(dir)
	local acc = nil
	for part in string.gmatch(dir, "[^/]+") do
		acc = acc and (acc .. "/" .. part) or part
		mkdirOne(acc)
	end
end

function FS.exists(path)
	if FS.memory[path] ~= nil then return true end
	local isfile = fsFn("isfile")
	if isfile then
		local ok, v = pcall(isfile, path)
		return ok and v == true
	end
	return false
end

function FS.read(path)
	if FS.memory[path] ~= nil then return FS.memory[path] end
	local readfile = fsFn("readfile")
	if readfile then
		local ok, v = pcall(readfile, path)
		if ok and type(v) == "string" then return v end
	end
	return nil
end

function FS.write(path, text)
	local dir = path:match("^(.*)/[^/]+$")
	if dir then FS.mkdirs(dir) end
	local writefile = fsFn("writefile")
	if writefile then
		local ok, err = pcall(writefile, path, text)
		if ok then
			FS.writes = FS.writes + 1
			FS.memory[path] = nil
			return true
		end
		FS.failures = FS.failures + 1
		Core.err("nao gravou " .. path .. ": " .. tostring(err))
	end
	-- no storage (or it failed): keep in memory so EXPORTAR can still offer it through the clipboard
	FS.memory[path] = text
	return false
end

-- ---------------------------------------------------------------- export bookkeeping
Exporter.files = {}       -- { path, kind, records, bytes, session, time }
Exporter.sequence = {}    -- dir|kind -> next number
Exporter.session = nil    -- set by SessionManager

local function root(rel) return Core.Config.Root .. "/" .. rel end

local function encode(tbl)
	local ok, json = pcall(function() return Core.HttpService:JSONEncode(tbl) end)
	if ok then return json end
	return nil, tostring(json)
end

-- writes an arbitrary JSON document. opts.versioned = keep the previous version as <name>.bak instead of losing it
function Exporter.writeJson(rel, tbl, opts)
	opts = opts or {}
	local path = root(rel)
	if type(tbl) == "table" then
		-- every document carries the collector version and the session that wrote it (without replacing values already set)
		if tbl.collector_version == nil then tbl.collector_version = Core.Config.Version end
		if tbl.session == nil and Exporter.session then tbl.session = Exporter.session end
	end
	local json, err = encode(tbl)
	if not json then
		Core.err("JSON invalido em " .. rel .. ": " .. tostring(err))
		return false, err
	end
	if FS.exists(path) then
		if opts.versioned then
			local old = FS.read(path)
			if old then FS.write(path .. ".bak", old) end
		elseif not opts.overwrite then
			-- never replace a different file silently: add the session id to the name
			local stem, ext = path:match("^(.*)(%.[^%.]+)$")
			path = (stem or path) .. "." .. tostring(Exporter.session or "s") .. (ext or "")
			rel = path:sub(#Core.Config.Root + 2)
		end
	end
	local stored = FS.write(path, json)
	Exporter.files[#Exporter.files + 1] = { path = path, kind = opts.kind or "document", records = opts.records or 1, bytes = #json, session = Exporter.session, time = U.nowIso(), stored = stored }
	return true, path
end

local function nextSeq(dir, kind)
	local key = dir .. "|" .. kind
	local n = (Exporter.sequence[key] or 0) + 1
	Exporter.sequence[key] = n
	return n
end

-- writes the pending records of one category (or all) as chunk files: <dir>/<kind>_<session>_<seq>.json
function Exporter.flush(category)
	local written = 0
	local cats = {}
	if category then cats[1] = category else for c in pairs(Store.pending) do cats[#cats + 1] = c end end
	for _, cat in ipairs(cats) do
		local q = Store.pending[cat]
		if q and #q > 0 then
			Store.pending[cat] = {}
			local byDir = {}
			for _, item in ipairs(q) do
				local list = byDir[item.dir]
				if not list then
					list = {}
					byDir[item.dir] = list
				end
				list[#list + 1] = item.record
			end
			for dir, records in pairs(byDir) do
				local i = 1
				while i <= #records do
					local chunk = {}
					for j = i, math.min(i + Core.Config.RecordsPerFile - 1, #records) do chunk[#chunk + 1] = records[j] end
					i = i + Core.Config.RecordsPerFile
					local seq = nextSeq(dir, cat)
					local rel = string.format("%s/%s_%s_%03d.json", dir, cat, tostring(Exporter.session), seq)
					local doc = { collector_version = Core.Config.Version, session = Exporter.session, kind = cat, exported_at = U.nowIso(), count = #chunk, records = chunk }
					local ok = Exporter.writeJson(rel, doc, { kind = cat, records = #chunk, overwrite = true })
					if ok then written = written + #chunk end
				end
			end
		end
	end
	return written
end

return Exporter

end

Modules["DataValidator"] = function(...)
-- DataValidator: reads back every file written in this session and checks it. A check that was not executed is reported as "NOT_RUN", never as PASS.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local V = {}

V.last = nil
V.validatedKinds = {}   -- kind -> true when all its files decoded and had consistent headers

local function add(list, name, status, detail, extra)
	local c = { name = name, status = status, detail = detail }
	if extra then for k, v in pairs(extra) do c[k] = v end end
	list[#list + 1] = c
end

function V.run()
	local checks = {}
	local files = Exporter.files
	local decodeFail, utf8Fail, headerFail, countFail, unreadable, checked = {}, {}, {}, {}, {}, 0
	local idsByKind = {}
	local dupIds = {}
	local kindOk = {}
	for i, f in ipairs(files) do
		if i % 50 == 0 then Core.tick(350) end
		local text = Exporter.FS.read(f.path)
		if not text then
			unreadable[#unreadable + 1] = f.path
			kindOk[f.kind] = false
		else
			checked = checked + 1
			local ok, doc = pcall(function() return Core.HttpService:JSONDecode(text) end)
			if not ok then
				decodeFail[#decodeFail + 1] = f.path
				kindOk[f.kind] = false
			else
				if utf8 and utf8.len and utf8.len(text) == nil then
					utf8Fail[#utf8Fail + 1] = f.path
					kindOk[f.kind] = false
				end
				if type(doc) ~= "table" then
					headerFail[#headerFail + 1] = f.path
					kindOk[f.kind] = false
				else
					if doc.collector_version == nil or doc.session == nil then
						-- state files are plain; chunk/report files must carry version + session
						if f.kind ~= "state" and f.kind ~= "state_ids" then
							headerFail[#headerFail + 1] = f.path
							kindOk[f.kind] = false
						end
					end
					if type(doc.records) == "table" and doc.count ~= nil and doc.count ~= #doc.records then
						countFail[#countFail + 1] = f.path
						kindOk[f.kind] = false
					end
					if type(doc.records) == "table" then
						local set = idsByKind[f.kind]
						if not set then
							set = {}
							idsByKind[f.kind] = set
						end
						for _, rec in ipairs(doc.records) do
							if type(rec) == "table" and rec.id then
								if set[rec.id] then dupIds[#dupIds + 1] = { kind = f.kind, id = rec.id, file = f.path } else set[rec.id] = true end
							end
						end
					end
					if kindOk[f.kind] == nil then kindOk[f.kind] = true end
				end
			end
		end
	end
	V.validatedKinds = {}
	for kind, ok in pairs(kindOk) do
		if ok then V.validatedKinds[kind] = true end
	end
	if #files == 0 then
		add(checks, "files_json_valid", "NOT_RUN", "nenhum arquivo foi exportado ainda")
	else
		add(checks, "files_json_valid", (#decodeFail == 0 and #unreadable == 0) and "PASS" or "FAIL", string.format("%d arquivos lidos de volta e decodificados, %d invalidos, %d ilegiveis", checked, #decodeFail, #unreadable), { failed = decodeFail, unreadable = unreadable })
		add(checks, "utf8_valid", (utf8 and utf8.len) and (#utf8Fail == 0 and "PASS" or "FAIL") or "NOT_RUN", (utf8 and utf8.len) and (#utf8Fail .. " arquivos com UTF-8 invalido") or "utf8.len indisponivel neste executor", { failed = utf8Fail })
		add(checks, "headers_version_session", #headerFail == 0 and "PASS" or "FAIL", #headerFail .. " arquivos sem collector_version/session", { failed = headerFail })
		add(checks, "record_counts_match", #countFail == 0 and "PASS" or "FAIL", #countFail .. " arquivos cujo count difere de #records", { failed = countFail })
		add(checks, "unique_ids_within_kind", #dupIds == 0 and "PASS" or "FAIL", #dupIds .. " ids repetidos entre os arquivos desta sessao", { duplicates = dupIds })
	end
	add(checks, "storage_writable", Exporter.FS.canWrite() and "PASS" or "WARN", Exporter.FS.canWrite() and "writefile disponivel" or "writefile indisponivel: os dados ficam so na memoria (use EXPORTAR -> copiar)")
	add(checks, "write_failures", Exporter.FS.failures == 0 and "PASS" or "FAIL", Exporter.FS.failures .. " gravacoes falharam")
	local dupTotal = 0
	for _, n in pairs(Store.dups) do dupTotal = dupTotal + n end
	add(checks, "duplicates_skipped", "INFO", dupTotal .. " registros duplicados foram ignorados (por id estavel) - veja Reports/duplicates.json")
	local gaps = 0
	for _, c in pairs(Store.cells) do if c.status ~= "OBSERVED" then gaps = gaps + 1 end end
	add(checks, "map_cells_all_observed", (U.shallowCount(Store.cells) > 0 and gaps == 0) and "PASS" or (U.shallowCount(Store.cells) == 0 and "NOT_RUN" or "WARN"), gaps .. " celulas nao totalmente observadas de " .. U.shallowCount(Store.cells))
	local M = R("ModelCollector")
	local rep = R("CollectionReport")
	add(checks, "models_not_truncated", #rep.truncatedAll == 0 and "PASS" or "WARN", #rep.truncatedAll .. " modelos com pecas alem do limite (contadas em truncated_objects.json)")
	local streaming = false
	pcall(function() streaming = Core.Workspace.StreamingEnabled end)
	add(checks, "streaming", streaming and "WARN" or "PASS", streaming and "StreamingEnabled: partes distantes nao carregadas nao puderam ser medidas" or "streaming desligado")
	local fail, warn = 0, 0
	for _, c in ipairs(checks) do
		if c.status == "FAIL" then fail = fail + 1 elseif c.status == "WARN" then warn = warn + 1 end
	end
	V.last = { collector_version = Core.Config.Version, session = Exporter.session, time = U.nowIso(), files_checked = checked, failures = fail, warnings = warn, passed_overall = fail == 0 and #files > 0, checks = checks, validated_kinds = V.validatedKinds }
	Exporter.writeJson("Reports/validation.json", V.last, { versioned = true, kind = "validation" })
	Core.info(string.format("validacao: %d arquivos, %d falhas, %d avisos", checked, fail, warn))
	return V.last
end

return V
end

Modules["EconomyObserver"] = function(...)
-- EconomyObserver: samples numbers the game itself displays (leaderstats and HUD labels whose names look like currencies/counters)
-- and records every change with a timestamp. It never spends or earns anything; it only watches.
local Core, R = ...
local U = R("Util")
local Exporter = R("DataExporter")
local E = {}

E.series = {}      -- key -> { source, samples = { {t, clock, display, approx} }, changes = n }
E.running = false
E.listeners = {}   -- fn(key, old, new) called on a change (DamageObserver uses it for rewards)
local t0 = os.clock()

local WORDS = { "coin", "gem", "cash", "money", "gold", "rebirth", "level", "kill", "box", "damage", "multiplier", "luck", "boost", "speed", "pet", "egg", "power", "rank", "xp", "exp", "token", "crystal", "candy", "currency", "stat", "balance" }

local function looksLikeCounter(label)
	local cur = label
	local depth = 0
	while cur and depth < 4 do
		local l = string.lower(cur.Name)
		for _, w in ipairs(WORDS) do
			if string.find(l, w, 1, true) then return true end
		end
		cur = cur.Parent
		depth = depth + 1
	end
	return false
end

local function note(key, source, display, approx)
	local s = E.series[key]
	if not s then
		s = { key = key, source = source, samples = {}, changes = 0 }
		E.series[key] = s
	end
	local last = s.samples[#s.samples]
	if last and last.display == display then return end
	if #s.samples >= 2000 then table.remove(s.samples, 1) s.truncated_old = (s.truncated_old or 0) + 1 end
	s.samples[#s.samples + 1] = { t = U.nowIso(), clock = U.num(os.clock() - t0), display = display, approx = approx and U.num(approx) or nil }
	if last then
		s.changes = s.changes + 1
		for _, fn in ipairs(E.listeners) do pcall(fn, key, last, s.samples[#s.samples]) end
	end
end

function E.sample()
	local lp = Core.LocalPlayer
	if not lp then return end
	local ls = lp:FindFirstChild("leaderstats")
	if ls then
		for _, v in ipairs(ls:GetChildren()) do
			if v:IsA("ValueBase") then
				local val = v.Value
				note("leaderstats/" .. v.Name, "leaderstats", tostring(val), type(val) == "number" and val or nil)
			end
		end
	end
	local pg = lp:FindFirstChildOfClass("PlayerGui")
	if not pg then return end
	for _, d in ipairs(pg:GetDescendants()) do
		if d:IsA("TextLabel") and d.Name ~= "UBC_UI" then
			local okVis = R("UICollector").effectiveVisible(d)
			if okVis and d.Text ~= "" and looksLikeCounter(d) then
				local p = U.parseDisplayNumber(d.Text)
				if p then
					local key = "hud/" .. d:GetFullName():gsub("^.-PlayerGui%.", "")
					note(key, "hud_label", p.display, p.approx)
				end
			end
		end
	end
end

function E.start()
	if E.running then return end
	E.running = true
	task.spawn(function()
		while E.running do
			pcall(E.sample)
			task.wait(Core.Config.SampleInterval * 2)
		end
	end)
end
function E.stop() E.running = false end

function E.summary()
	local out = {}
	for key, s in pairs(E.series) do
		local first, last = s.samples[1], s.samples[#s.samples]
		out[#out + 1] = { key = key, source = s.source, samples = #s.samples, changes = s.changes, first = first and first.display, last = last and last.display }
	end
	table.sort(out, function(a, b) return a.key < b.key end)
	return out
end

function E.write()
	local series = {}
	for _, s in pairs(E.series) do series[#series + 1] = s end
	if #series == 0 then return end
	Exporter.writeJson("Observations/economy_" .. tostring(Exporter.session) .. ".json", {
		collector_version = Core.Config.Version, session = Exporter.session, kind = "economy_observation", series = series,
		notes = { "values are exactly what the game displayed; 'approx' is parsed from abbreviated text (K, M, B...) and loses precision", "meaning of each key is NOT inferred: the key is the label / value name found", "nothing was bought, sold, opened or rebirthed by this tool" },
	}, { kind = "economy", records = #series, overwrite = true })
end

return E
end

Modules["EggCollector"] = function(...)
-- EggCollector: egg stands in the world and egg menus. Displayed percentages are copied from the screen; sampled results only exist
-- when the player hatched eggs by hand and logged them (event kind "hatch"). Eggs are NEVER opened by this tool.
local Core, R = ...
local C = R("CatalogCommon")
local U = R("Util")
local Exporter = R("DataExporter")
local E = {}

function E.measure()
	return C.run("eggs", { egg = true }, { "egg", "hatch" }, { instances = true })
end

-- sampled drop frequencies from hatches logged through REGISTRAR EVENTO (kind "hatch", data { egg = ..., result = ... })
function E.sampled()
	local I = R("InteractionObserver")
	local per = {}
	for _, ev in ipairs(I.events) do
		if ev.kind == "hatch" and type(ev.data) == "table" and ev.data.egg and ev.data.result then
			local e = per[ev.data.egg]
			if not e then
				e = { egg = ev.data.egg, samples = 0, results = {} }
				per[ev.data.egg] = e
			end
			e.samples = e.samples + 1
			e.results[ev.data.result] = (e.results[ev.data.result] or 0) + 1
		end
	end
	local list = {}
	for _, e in pairs(per) do
		local rows = {}
		for result, n in pairs(e.results) do rows[#rows + 1] = { result = result, count = n, observed_frequency_percent = U.num(n * 100 / e.samples) } end
		table.sort(rows, function(a, b) return a.count > b.count end)
		list[#list + 1] = { egg = e.egg, samples = e.samples, results = rows, kind = "sampled", warning = "frequencies from " .. e.samples .. " manual hatches are NOT the real probabilities; small samples are unreliable" }
	end
	if #list > 0 then
		Exporter.writeJson("Catalogs/egg_samples_" .. tostring(Exporter.session) .. ".json", { session = Exporter.session, eggs = list }, { kind = "egg_samples", overwrite = true })
	end
	return list
end
return E
end

Modules["GeometryCollector"] = function(...)
-- GeometryCollector: scans the Workspace in batches, assigns parts to models / areas / cells and tracks which map cells were observed.
-- Everything is read-only. Parts that are not loaded in the client (streaming) are NOT observable: those cells stay NOT_SCANNED.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local G = {}

G.last = nil   -- summary of the last scan

local function cellKey(x, z)
	local size = Core.Config.CellSize
	return math.floor(x / size) .. "," .. math.floor(z / size)
end
G.cellKey = cellKey

local function streamingInfo()
	local ws = Core.Workspace
	local info = { enabled = false, radius = nil }
	pcall(function()
		info.enabled = ws.StreamingEnabled == true
		info.radius = ws.StreamingTargetRadius
	end)
	return info
end

-- opts.radius / opts.center limit the scan to the surroundings of the player ("map current area")
function G.scan(opts)
	opts = opts or {}
	local Model, Area = R("ModelCollector"), R("AreaCollector")
	local World = R("WorldCollector")
	Model.reset()
	Area.reset()
	local ws = Core.Workspace
	local char = Core.LocalPlayer and Core.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local playerPos = root and root.Position or nil
	local center = opts.center or playerPos
	local radius = opts.radius
	if radius and not center then
		Core.warn("sem personagem: o raio foi ignorado (o mundo inteiro carregado sera medido)")
		radius = nil
	end
	local streaming = streamingInfo()
	local okSnap, snap = pcall(function() return ws:GetDescendants() end)
	if not okSnap then error("nao foi possivel listar o Workspace: " .. tostring(snap)) end
	local total = #snap
	Core.info(string.format("Workspace: %d instancias carregadas. Streaming %s%s.", total, streaming.enabled and "LIGADO" or "desligado", streaming.radius and (" (raio " .. tostring(streaming.radius) .. ")") or ""))

	local skipModels = {}
	local terrain, camera = ws:FindFirstChildOfClass("Terrain"), ws.CurrentCamera
	local scannedParts, skipped, limitHit = 0, 0, false
	local cellsTouched = {}
	local function isSkipped(d)
		if d == terrain or (camera and (d == camera or d:IsDescendantOf(camera))) then return true end
		for _, m in ipairs(skipModels) do
			if d == m or d:IsDescendantOf(m) then return true end
		end
		return false
	end

	local maxN = Core.Config.MaxScanInstances
	for i = 1, total do
		Core.tick(1)
		if i % 2000 == 0 then
			Core.setProgress(i, total, "varredura do Workspace")
			if Store.pendingCount() > 3000 then Exporter.flush() end
		end
		if i > maxN then
			limitHit = true
			Core.warn("limite de instancias atingido (" .. maxN .. "): o restante nao foi medido")
			break
		end
		local d = snap[i]
		local okI = pcall(function()
			if d:IsA("Model") and d:FindFirstChildOfClass("Humanoid") then
				skipModels[#skipModels + 1] = d -- characters / NPC rigs with a Humanoid are not map geometry
				return
			end
			if isSkipped(d) then skipped = skipped + 1 return end
			local isPart = d:IsA("BasePart")
			local isModel = d:IsA("Model")
			if not isPart and not isModel then return end
			local ctx = Area.contextOf(d)
			if isModel then
				if radius then
					local okp, pv = pcall(function() return d:GetPivot() end)
					if okp and (pv.Position - center).Magnitude > radius + 150 then Model.closeFor(d) return end
				end
				Model.visit(d, ctx)
				return
			end
			-- BasePart
			local pos = d.Position
			if radius and (pos - center).Magnitude > radius then Model.closeFor(d) return end
			Model.closeFor(d) -- closes models that ended before this part
			scannedParts = scannedParts + 1
			Area.observePart(d, ctx)
			local key = cellKey(pos.X, pos.Z)
			cellsTouched[key] = (cellsTouched[key] or 0) + 1
			if not Model.addPart(d, ctx) then
				local rec = Model.looseRecord(d, ctx)
				Store.add("loose_parts", rec, ctx.dir .. "/loose_parts")
			end
		end)
		if not okI then Store.bump("scan_errors") end
	end
	Model.finish()

	-- cell coverage: with streaming, only cells near the player are certain
	local sizeC = Core.Config.CellSize
	for key, n in pairs(cellsTouched) do
		local cx, cz = key:match("^(-?%d+),(-?%d+)$")
		local status = "OBSERVED"
		if streaming.enabled and playerPos and streaming.radius then
			local mid = Vector3.new((tonumber(cx) + 0.5) * sizeC, playerPos.Y, (tonumber(cz) + 0.5) * sizeC)
			if (mid - playerPos).Magnitude > streaming.radius * 0.85 then status = "PARTIALLY_SCANNED" end
		end
		Store.setCell(key, status, n)
	end

	Area.finalize()
	World.write()
	Exporter.flush()
	local summary = {
		instances_in_workspace = total, parts_scanned = scannedParts, skipped = skipped, limit_hit = limitHit, streaming = streaming,
		models = Model.stats, cells_touched = U.shallowCount(cellsTouched), duplicates = Store.dups, time = U.nowIso(), radius = radius,
	}
	G.last = summary
	Core.info(string.format("varredura: %d pecas, %d modelos (completos %d, parciais %d), %d celulas", scannedParts, Model.stats.models, Model.stats.full, Model.stats.partial, summary.cells_touched))
	return summary
end

-- cells of the map extent already known (from measured areas) that were never observed: the list of places to visit
function G.unobservedCells()
	local list = {}
	local A = R("AreaCollector")
	local size = Core.Config.CellSize
	local seen = {}
	for _, key in ipairs(A.order) do
		local s = A.stats[key]
		if s.min[1] ~= math.huge then
			for cx = math.floor(s.min[1] / size), math.floor(s.max[1] / size) do
				for cz = math.floor(s.min[3] / size), math.floor(s.max[3] / size) do
					local k = cx .. "," .. cz
					if not seen[k] then
						seen[k] = true
						local c = Store.cells[k]
						if not c or c.status ~= "OBSERVED" then list[#list + 1] = { cell = k, status = c and c.status or "NOT_SCANNED", center = { (cx + 0.5) * size, (cz + 0.5) * size }, area = key } end
					end
				end
			end
		end
	end
	return list
end

return G

end

Modules["InteractionObserver"] = function(...)
-- InteractionObserver: the event diary (timestamps) + passive observation of proximity prompts the PLAYER uses.
-- It never triggers a prompt, a click or a remote.
local Core, R = ...
local U = R("Util")
local Exporter = R("DataExporter")
local I = {}

I.events = {}        -- { t, clock, kind, source, data }
I.dropped = 0
I.hooks = false
local t0 = os.clock()

function I.record(kind, data, source)
	if #I.events >= Core.Config.MaxEvents then
		I.dropped = I.dropped + 1
		return false
	end
	local char = Core.LocalPlayer and Core.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	I.events[#I.events + 1] = { t = U.nowIso(), clock = U.num(os.clock() - t0), kind = kind, source = source or "manual", data = data, player_position = root and U.v3(root.Position) or nil }
	return true
end

-- passive hooks: prompts shown / hidden / triggered BY THE PLAYER
function I.start()
	if I.hooks then return end
	I.hooks = true
	local pps = Core.ProximityPromptService
	if pps then
		pcall(function()
			pps.PromptShown:Connect(function(prompt)
				I.record("prompt_shown", { object = U.get(prompt, "ObjectText"), action = U.get(prompt, "ActionText"), hold = U.num(U.get(prompt, "HoldDuration")), path = U.path(prompt) }, "proximity_prompt")
			end)
			pps.PromptTriggered:Connect(function(prompt)
				I.record("prompt_triggered_by_player", { object = U.get(prompt, "ObjectText"), action = U.get(prompt, "ActionText"), path = U.path(prompt) }, "proximity_prompt")
			end)
		end)
	end
end

function I.write()
	Exporter.writeJson("Observations/events_" .. tostring(Exporter.session) .. ".json", {
		collector_version = Core.Config.Version, session = Exporter.session, kind = "events", count = #I.events, dropped_over_limit = I.dropped, events = I.events,
	}, { kind = "events", records = #I.events, overwrite = true })
end

return I
end

Modules["LightingCollector"] = function(...)
-- LightingCollector: Lighting service, Atmosphere and post-processing effects (no sky textures, only their existence and numeric settings).
local Core, R = ...
local U = R("Util")
local Exporter = R("DataExporter")
local L = {}
L.labels = {}

local LIGHTING_PROPS = { "Ambient", "OutdoorAmbient", "Brightness", "ClockTime", "TimeOfDay", "GeographicLatitude", "ColorShift_Top", "ColorShift_Bottom", "EnvironmentDiffuseScale",
	"EnvironmentSpecularScale", "ExposureCompensation", "FogColor", "FogEnd", "FogStart", "GlobalShadows", "ShadowSoftness", "Technology", "OutdoorAmbient" }
local EFFECTS = {
	Atmosphere = { "Density", "Offset", "Color", "Decay", "Glare", "Haze" },
	ColorCorrectionEffect = { "Enabled", "Brightness", "Contrast", "Saturation", "TintColor" },
	BloomEffect = { "Enabled", "Intensity", "Size", "Threshold" },
	BlurEffect = { "Enabled", "Size" },
	DepthOfFieldEffect = { "Enabled", "FarIntensity", "FocusDistance", "InFocusRadius", "NearIntensity" },
	SunRaysEffect = { "Enabled", "Intensity", "Spread" },
	Sky = { "CelestialBodiesShown", "StarCount", "SunAngularSize", "MoonAngularSize" },
	Clouds = { "Cover", "Density", "Color", "Enabled" },
}

function L.capture(label)
	local lighting = Core.Lighting
	local doc = { collector_version = Core.Config.Version, session = Exporter.session, label = label, time = U.nowIso(), lighting = {}, effects = {}, notes = {} }
	for _, p in ipairs(LIGHTING_PROPS) do
		local v = U.get(lighting, p)
		if v ~= nil then doc.lighting[p] = U.encodeValue(v) end
	end
	local ok, kids = pcall(function() return lighting:GetChildren() end)
	if ok then
		for _, c in ipairs(kids) do
			local props = EFFECTS[c.ClassName]
			if props then
				local e = { class = c.ClassName, name = c.Name, props = {} }
				for _, p in ipairs(props) do
					local v = U.get(c, p)
					if v ~= nil then e.props[p] = U.encodeValue(v) end
				end
				doc.effects[#doc.effects + 1] = e
			end
		end
	end
	local char = Core.LocalPlayer and Core.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	doc.captured_at_position = root and U.v3(root.Position) or "unknown"
	doc.notes[1] = "Lighting can differ per area: capture it standing in each area (label = area name)."
	doc.notes[2] = "Sky/cloud textures are not read; only whether they exist and their numeric settings."
	local rel = "Worlds/_lighting/lighting_" .. U.sanitize(label or "current") .. "_" .. tostring(Exporter.session) .. ".json"
	Exporter.writeJson(rel, doc, { kind = "lighting" })
	L.labels[#L.labels + 1] = label or "current"
	return doc
end

return L

end

Modules["MainController"] = function(...)
-- MainController: wires the modules to the operations the UI buttons call. Every operation runs inside Core.runOperation
-- (batches, pause, cancel, error isolation). Nothing here buys, attacks, opens eggs or rebirths.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local Main = {}

Main.ops = {}
Main.started = false

local function session() return R("SessionManager") end

-- descriptions shown BEFORE an operation starts (what will be collected / what will NOT happen)
Main.INFO = {
	collectAll = { title = "COLETAR TUDO ACESSIVEL", what = "Varre o Workspace carregado (modelos, pecas, geometria por area), mede toda a interface visivel, captura a iluminacao atual, monta os catalogos (lojas, armas, caixas, pets, ovos, baus/maquinas), valida e exporta.", wont = "Nao compra, nao ataca, nao abre ovos, nao faz rebirth, nao entra em areas bloqueadas, nao mexe em nenhum objeto do jogo. So o que o seu cliente enxerga agora." },
	mapWorld = { title = "MAPEAR MUNDO ATUAL", what = "Varre todo o Workspace carregado: modelos com todas as pecas, geometria e arquivos por area (geometry/objects/shops/boxes...), cobertura por celulas.", wont = "Partes fora do raio de streaming nao carregam e ficam como NAO OBSERVADAS (veja Relatorios)." },
	mapArea = { title = "MAPEAR AREA ATUAL", what = "Varre as pecas e modelos num raio ao redor do seu personagem e salva a area onde voce esta (mescla com sessoes anteriores sem duplicar).", wont = "Nao teleporta nem anda por voce: va ate a area antes." },
	measureModels = { title = "MEDIR MODELOS", what = "Mede modelos e todas as pecas (tamanho, CFrame absoluto e relativo, cor, material, transparencia, colisao, atributos, efeitos) ao redor de voce.", wont = "Nao le meshes, texturas, ids de imagem, animacoes nem scripts." },
	measureShops = { title = "MEDIR LOJAS", what = "Cataloga estandes/lojas vistos no mundo e os itens exibidos num menu de loja que VOCE abriu.", wont = "Nao aperta comprar. Abra a loja manualmente antes de usar." },
	measureWeapons = { title = "MEDIR ARMAS", what = "Cataloga estandes de armas, listas de armas de menus abertos e as ferramentas que voce carrega (nome, tooltip, atributos).", wont = "Dano real so aparece com REGISTRAR DANO; nada e inventado." },
	measureBoxes = { title = "MEDIR CAIXAS", what = "Agrupa as caixas/presentes (Box, Gift, Static, Ghost...) por tipo: quantidade, faixa de tamanho, areas, textos exibidos.", wont = "Nao bate nas caixas." },
	measurePets = { title = "MEDIR PETS", what = "Cataloga pets mostrados nos menus abertos (inventario/index/ovos) e modelos de pet no mundo.", wont = "Nao equipa, nao vende, nao evolui pets." },
	measureEggs = { title = "MEDIR OVOS", what = "Cataloga ovos do mundo e as porcentagens EXIBIDAS no menu do ovo que voce abriu. Resultados amostrados so existem se voce registrar chocamentos manuais.", wont = "Nunca abre ovo nem gasta moeda." },
	measureUI = { title = "MEDIR UI", what = "Mede cada ScreenGui visivel agora (posicao, tamanho, cores, textos, fontes, UICorner/UIStroke/layouts, ZIndex...) e os menus abertos.", wont = "Nao clica em nada; ids de imagem nao sao lidos. Abra os menus que quer medir (ou deixe o observador capturar quando voce abrir)." },
	validate = { title = "VALIDAR DADOS", what = "Le de volta cada arquivo exportado, confere JSON/UTF-8/cabecalhos/contagens/ids unicos e grava Reports/validation.json.", wont = "Itens nao verificaveis ficam NOT_RUN, nunca PASS." },
	export = { title = "EXPORTAR", what = "Grava tudo que esta pendente, o estado de retomada, relatorios, manifesto e valida. Dados antigos nunca sao sobrescritos em silencio (versoes .bak / nome com sessao).", wont = "Sem writefile os dados ficam na memoria: use COPIAR RELATORIO." },
	damage = { title = "REGISTRAR DANO", what = "Inicia/encerra uma sessao MANUAL: voce bate nas caixas, o coletor observa atributos/textos de vida, destruicao, respawn e mudancas de economia e separa exibido / medido / estimado.", wont = "O coletor nao ataca. Pare a sessao com o mesmo botao." },
	event = { title = "REGISTRAR EVENTO", what = "Grava no diario (com horario e posicao) uma anotacao sua: ex. 'abri ovo X e saiu Y' (tipo hatch) ou qualquer evento observado.", wont = "Nao executa nada no jogo." },
}

function Main.init(opts)
	opts = opts or {}
	if Main.started then return Main end
	Main.started = true
	session().start(opts.resume ~= false)
	R("InteractionObserver").start()
	R("UICollector").watch(true)
	R("EconomyObserver").start()
	R("ProgressionObserver").start()
	R("AnimationObserver").start()
	Core.info("coletor " .. Core.Config.Version .. " pronto. Observadores passivos ligados (UI, economia, progressao, animacoes).")
	return Main
end

local function finish(name, ok, res)
	session().recordOperation(name, ok and "done" or tostring(res))
	if Store.pendingCount() > 0 then Exporter.flush() end
	pcall(function() session().saveState() end)
	return ok, res
end

local function scan(radius)
	local summary = R("GeometryCollector").scan({ radius = radius })
	R("CollectionReport").accumulate(summary)
	return summary
end

local function catalogs()
	local out = {}
	local names = { { "shops", "ShopCollector" }, { "weapons", "WeaponCollector" }, { "boxes", "BoxCollector" }, { "pets", "PetCollector" }, { "eggs", "EggCollector" }, { "chests_machines", "ChestCollector" } }
	for _, n in ipairs(names) do
		Core.checkpoint()
		local ok, res = pcall(function() return R(n[2]).measure() end)
		out[#out + 1] = { name = n[1], ok = ok, result = ok and res or tostring(res) }
		if not ok then Core.warn("catalogo " .. n[1] .. ": " .. tostring(res)) end
	end
	return out
end

local function lightingHere(label)
	local ok, e = pcall(function() return R("LightingCollector").capture(label) end)
	if not ok then Core.warn("iluminacao: " .. tostring(e)) end
end

local function currentAreaLabel()
	local P = R("ProgressionObserver")
	local char = Core.LocalPlayer and Core.LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		local ok, key = pcall(P.areaAt, root.Position)
		if ok and key then return (key:gsub("/", "_")) end
	end
	return "posicao_atual"
end

function Main.ops.collectAll()
	return Core.runOperation("COLETAR TUDO", function()
		Core.setProgress(0, 5, "1/5 varredura do mundo")
		scan(nil)
		Core.setProgress(1, 5, "2/5 interface")
		pcall(function() R("UICollector").snapshotAll("estado_atual") end)
		Core.setProgress(2, 5, "3/5 iluminacao")
		lightingHere(currentAreaLabel())
		Core.setProgress(3, 5, "4/5 catalogos")
		catalogs()
		Core.setProgress(4, 5, "5/5 validacao e exportacao")
		local res = R("CollectionReport").exportAll()
		Core.setProgress(5, 5, "concluido")
		return res
	end)

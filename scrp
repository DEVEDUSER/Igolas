local PlayerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 10)

local OUT = "UnboxingMeasure"
local MAX_UI_NODES = 15000
local MAX_PARTS = 120
local MAX_MODELS = 300
local PATTERNS = { "^Box%d+$", "^Gift%d+$", "^HalloweenBox$", "^HalloweenGift$", "^Egg", "^Stand$", "^Tree$", "^Fence$", "^Wall$", "^Barrel$",
	"^Banner$", "^Pumpkin$", "^DeadTree$", "^Building$", "^UFO$", "^Kelp$", "^Portal", "^Chest", "^TicketWheel$", "^Crab$" }
local FOLDERS = { "Workspace.Worlds.World1.Lobby", "Workspace.Worlds.World1.Areas" }


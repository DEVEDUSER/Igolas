local function formatTime(seconds)
    seconds = math.floor(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function countDict(tbl)
    local n = 0
    for _ in pairs(tbl or {}) do
        n = n + 1
    end
    return n
end

local function getItemData(invItem)
    if not invItem or not invItem.ItemId then return nil end
    local ok, data = pcall(function()
        return ItemData.Get(invItem.ItemId)
    end)
    if ok then return data end
    return nil
end

local function getRarityName(itemData)
    if not itemData or not itemData.Rarity then return nil end
    local ok, name = pcall(function()
        return ItemData.GetRawRarityName(itemData.Rarity)
    end)
    if ok then return rarityAliases[name] or name end
    return nil
end

local function getBestPerkStat(invItem)
    local best = 0
    local function scan(v)
        if type(v) == "number" then
            if v > best then best = v end
        elseif type(v) == "table" then
            for _, x in pairs(v) do scan(x) end
        end
    end
    if invItem then
        scan(invItem.Stats)
        scan(invItem.Stat)
        scan(invItem.Modifiers)
        scan(invItem.Boosts)
        scan(invItem.Multiplier)
        scan(invItem.Power)
        scan(invItem.Value)
    end
    return best
end

local function isRareDrop(invItem)
    if not invItem then return false end
    local txt = string.lower(tostring(invItem.ItemId or invItem.Id or invItem.Name or ""))
    return txt:find("eggrain") or txt:find("egg rain") or txt:find("bombrain") or txt:find("bomb rain") or txt:find("bomb%-rain")
end

local function favoriteOrLockItem(category, uid)
    pcall(function()
        if RE:FindFirstChild("FavoriteItem") then
            RE.FavoriteItem:FireServer(category, uid, true)
        elseif RE:FindFirstChild("LockItem") then
            RE.LockItem:FireServer(category, uid, true)
        elseif RE:FindFirstChild("ToggleFavorite") then
            RE.ToggleFavorite:FireServer(category, uid)
        elseif RF:FindFirstChild("FavoriteItem") then
            RF.FavoriteItem:InvokeServer(category, uid, true)
        elseif RF:FindFirstChild("LockItem") then
            RF.LockItem:InvokeServer(category, uid, true)
        elseif RF:FindFirstChild("ToggleFavorite") then
            RF.ToggleFavorite:InvokeServer(category, uid)
        end
    end)
end

local function shouldSellItem(invItem, category)
    if not invItem then return false end
    if invItem.IsEquipped or invItem.IsFavorite or invItem.Locked then return false end
    local data = getItemData(invItem)
    local rarity = getRarityName(data)
    return rarity and sellRarities[category] and sellRarities[category][rarity] == true
end

local function protectSpecialItems()
    local data = PlayerData.data
    if not data then return end

    for _, category in ipairs({ "Hats", "Pets", "Perks" }) do
        local storage = data[category]
        if storage then
            for uid, invItem in pairs(storage) do
                if autoFavoriteRareDrops and isRareDrop(invItem) then
                    favoriteOrLockItem(category, uid)
                    invItem.IsFavorite = true
                    invItem.Locked = true
                elseif category == "Perks" and autoFavoriteGoodPerks and getBestPerkStat(invItem) >= perkFavoriteMinStat then
                    favoriteOrLockItem(category, uid)
                    invItem.IsFavorite = true
                    invItem.Locked = true
                end
            end
        end
    end
end

local function sellInventoryCategory(category)
    local data = PlayerData.data
    if not data then return end

    local storage = data[category]
    if not storage then return end

    local list = {}

    for uid, invItem in pairs(storage) do
        local protected = false

        if autoFavoriteRareDrops and isRareDrop(invItem) then
            favoriteOrLockItem(category, uid)
            invItem.IsFavorite = true
            invItem.Locked = true
            protected = true
        end

        if category == "Perks" and autoFavoriteGoodPerks and getBestPerkStat(invItem) >= perkFavoriteMinStat then
            favoriteOrLockItem(category, uid)
            invItem.IsFavorite = true
            invItem.Locked = true
            protected = true
        end

        if not protected and shouldSellItem(invItem, category) then
            table.insert(list, uid)
        end
    end

    if (category == "Hats" or category == "Pets") and #list >= countDict(storage) then
        table.remove(list)
    end

    if #list == 0 then return end

    local ok, result = pcall(function()
        return RF.SellItems:InvokeServer(list, category)
    end)

    if ok and result then
        Stats.itemsSold = Stats.itemsSold + #list
        if category == "Hats" then Stats.hatsSold = Stats.hatsSold + #list end
        if category == "Pets" then Stats.petsSold = Stats.petsSold + #list end
        if category == "Perks" then Stats.perksSold = Stats.perksSold + #list end
        notify("Auto Sell", "Vendeu " .. tostring(#list) .. " " .. category, 2)
    end
end

local function getNearestBox()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local field = BoxController.GetCurrentField(root.Position)
    if not field then return nil end

    local nearest
    local nearestDist = autoAttackRange
    local boxes = field.VisibleBoxes or field.Boxes or {}

    for _, box in pairs(boxes) do
        if box and box.CFrame and box.Health and box.Damage then
            if box.Health > box.Damage and not box.IsOpen then
                local dist = (box.CFrame.Position - root.Position).Magnitude
                if dist < nearestDist then
                    nearest = box
                    nearestDist = dist
                end
            end
        end
    end

    return nearest
end

local function getCameraBoxTarget()
    local camera = workspace.CurrentCamera
    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local field = root and BoxController.GetCurrentField(root.Position)
    if not field then return nil end

    local bestBox
    local bestScore = cameraScanRadius

    for _, box in pairs(field.VisibleBoxes or field.Boxes or {}) do
        if box and box.CFrame and box.Health and box.Damage then
            if box.Health > box.Damage and not box.IsOpen then
                local screenPos, onScreen = camera:WorldToViewportPoint(box.CFrame.Position)
                if onScreen and screenPos.Z > 0 then
                    local score = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if score < bestScore then
                        bestScore = score
                        bestBox = box
                    end
                end
            end
        end
    end

    return bestBox
end

local function buildRoutePoints(center, radius, step)
    local points = {}

    for x = -radius, radius, step do
        local row = {}

        for z = -radius, radius, step do
            if Vector3.new(x, 0, z).Magnitude <= radius then
                table.insert(row, center + Vector3.new(x, 0, z))
            end
        end

        if math.floor((x + radius) / step) % 2 == 1 then
            local rev = {}
            for i = #row, 1, -1 do
                table.insert(rev, row[i])
            end
            row = rev
        end

        for _, p in ipairs(row) do
            table.insert(points, p)
        end
    end

    return points
end

local function startTPCameraRoute()
    if tpConn then tpConn:Disconnect() tpConn = nil end

    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    lockedCameraCenter = lockedCameraCenter or root.Position

    routePoints = buildRoutePoints(lockedCameraCenter, routeRadius, routeStep)
    routeIndex = 1

    tpConn = RunService.Heartbeat:Connect(function()
        if not State.tpCamera then return end

        local c = player.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not r or not h or #routePoints == 0 then return end

        local target = routePoints[routeIndex]
        local flatR = Vector3.new(r.Position.X, lockedCameraCenter.Y, r.Position.Z)
        local flatT = Vector3.new(target.X, lockedCameraCenter.Y, target.Z)

        if (flatR - flatT).Magnitude <= 8 then
            routeIndex = routeIndex + 1
            if routeIndex > #routePoints then routeIndex = 1 end
            target = routePoints[routeIndex]
        end

        h:MoveTo(target)
    end)
end

local function stopTPCameraRoute()
    if tpConn then tpConn:Disconnect() tpConn = nil end
end

local function getAreaModel(index)
    local areas = workspace:FindFirstChild("Areas")
    if not areas then return nil end

    local prefix = tostring(index) .. "_"
    for _, area in ipairs(areas:GetChildren()) do
        if tostring(area.Name):sub(1, #prefix) == prefix then
            return area
        end
    end

    return areas:FindFirstChild(tostring(index))
end

local function getModelCenter(model)
    if not model then return nil end

    local ok, cf = pcall(function()
        return model:GetPivot()
    end)

    if ok and cf then return cf.Position end

    local part = model:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function startFarmAreaRoute()
    if areaConn then areaConn:Disconnect() areaConn = nil end

    local area = getAreaModel(farmAreaIndex)
    farmAreaCenter = getModelCenter(area)

    if not farmAreaCenter then
        notify("Area Farm", "Area nao encontrada: " .. tostring(farmAreaIndex), 3)
        return
    end

    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    root.CFrame = CFrame.new(farmAreaCenter + Vector3.new(0, 4, 0))

    farmPoints = buildRoutePoints(farmAreaCenter, farmAreaRadius, farmAreaStep)
    farmPointIndex = 1
    State.autoAttackBoxes = true

    areaConn = RunService.Heartbeat:Connect(function()
        if not autoFarmArea then return end

        local c = player.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        local h = c and c:FindFirstChildOfClass("Humanoid")
        if not r or not h or #farmPoints == 0 then return end

        local target = farmPoints[farmPointIndex]
        local flatR = Vector3.new(r.Position.X, farmAreaCenter.Y, r.Position.Z)
        local flatT = Vector3.new(target.X, farmAreaCenter.Y, target.Z)

        if (flatR - flatT).Magnitude <= 8 then
            farmPointIndex = farmPointIndex + 1
            if farmPointIndex > #farmPoints then farmPointIndex = 1 end
            target = farmPoints[farmPointIndex]
        end

        h:MoveTo(target)
    end)

    notify("Area Farm", "Farmando area " .. tostring(farmAreaIndex), 3)
end


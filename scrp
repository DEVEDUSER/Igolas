function Inventory.refresh()
	if not Session.alive then return end
	local gen = Session.gen
	local count = 0
	local function rec(key, name, P, src, conf)
		local r = Store.upsert("inventory", key, name, P, src, conf)
		if r then count = count + 1 end
		return r
	end

	local function tool(t, where)
		local P = {
			kind = "tool", class = t.ClassName, location = where, path = path(t), equipped = (where == "character"),
			tooltip = trunc(tostring(get(t, "ToolTip") or "")), attributes = Util.attrs(t), value_children = Util.valueChildren(t),
		}
		rec(t, t.Name, P, "client_instance:" .. P.path, "high")
	end
	local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
	if bp then
		for _, t in ipairs(bp:GetChildren()) do
			if t:IsA("Tool") then tool(t, "backpack") end
		end
	end
	local ch = LocalPlayer.Character
	if ch then
		for _, t in ipairs(ch:GetChildren()) do
			if t:IsA("Tool") then tool(t, "character") end
		end
	end

	-- data folders / values under the local player and under ReplicatedStorage folders named after the local player
	local nodes = 0
	local function walkData(inst, where, depth)
		if nodes >= 600 or depth > 5 then return end
		local ok, kids = pcall(inst.GetChildren, inst)
		if not ok then return end
		for _, c in ipairs(kids) do
			nodes = nodes + 1
			if nodes >= 600 then return end
			if c:IsA("ValueBase") then
				local r = rec(c, c.Name, { kind = "player_data_value", location = where, value = plain(get(c, "Value")), value_class = c.ClassName,
					path = path(c) }, "value_object:" .. path(c), "high")
				if r then Watch.ensureValue(c) end
			elseif c:IsA("Folder") or c:IsA("Configuration") then
				local a = Util.attrs(c)
				if next(a) ~= nil then
					rec(c, c.Name, { kind = "player_data_folder", location = where, attributes = a, path = path(c), child_count = #c:GetChildren() },
						"client_instance:" .. path(c), "high")
				end
				walkData(c, where, depth + 1)
			end
		end
	end
	for _, c in ipairs(LocalPlayer:GetChildren()) do
		local n = c.Name
		if not (c:IsA("Backpack") or c:IsA("PlayerGui") or n == "PlayerScripts" or n == "StarterGear" or n == "leaderstats") then
			if c:IsA("Folder") or c:IsA("Configuration") or c:IsA("ValueBase") then
				if c:IsA("ValueBase") then
					rec(c, c.Name, { kind = "player_data_value", location = "player", value = plain(get(c, "Value")), path = path(c) }, "value_object:" .. path(c), "high")
				else
					walkData(c, "player", 1)
				end
			end
		end
	end
	local function scanRS(parent, depth)
		for _, c in ipairs(parent:GetChildren()) do
			if c.Name == LocalPlayer.Name or c.Name == tostring(LocalPlayer.UserId) then
				walkData(c, "replicated_storage_player_folder", 1)
			elseif depth < 2 and (c:IsA("Folder") or c:IsA("Configuration")) then
				scanRS(c, depth + 1)
			end
		end
	end
	pcall(scanRS, ReplicatedStorage, 0)

	-- player attributes that look inventory-related
	for k, v in pairs(Util.attrs(LocalPlayer)) do
		local tok = Tok.of(k)
		if hit(tok, KW.inv) or hit(tok, KW.pet) or hit(tok, KW.egg) or hit(tok, KW.weapon) or hit(tok, KW.box) then
			rec("pa:" .. k, k, { kind = "player_attribute", value = v, path = path(LocalPlayer), attribute = k }, "attribute:" .. path(LocalPlayer) .. "#" .. k, "high")
		end
	end
	Watch.ensureAttr(LocalPlayer)

	-- visible inventory UI: slots and capacity texts
	if PlayerGui then
		local okd, desc = pcall(PlayerGui.GetDescendants, PlayerGui)
		if okd then
			local t0, scanned, slots = clock(), 0, 0
			for _, d in ipairs(desc) do
				if gen ~= Session.gen then return end
				scanned = scanned + 1
				if scanned > 6000 then
					Store.note("inventory_ui_scan_cap", "Inventory UI scan stopped after 6000 GUI descendants.")
					break
				end
				if d ~= Session.ownGui and (not Session.ownGui or not d:IsDescendantOf(Session.ownGui)) then
					if d:IsA("TextLabel") or d:IsA("TextButton") then
						local t = get(d, "Text")
						if type(t) == "string" and #t <= 40 then
							local cur, max = t:match("^%D*(%d+)%s*/%s*(%d+)%D*$")
							if cur then
								local tok = ancestorTokens(d, 4)
								if hit(tok, KW.inv) or hit(tok, KW.pet) or hit(tok, KW.egg) or hit(tok, KW.weapon) then
									rec(d, d.Name, { kind = "capacity_or_count_text", text = trunc(t), current = tonumber(cur), max = tonumber(max), path = path(d) },
										"gui_text:" .. path(d), "low")
								end
							end
						end
					elseif (d:IsA("GuiButton") or d:IsA("Frame")) and slots < 600 then
						local par = d.Parent
						if par and (hit(Tok.of(par.Name), KW.invui) or (par.Parent and hit(Tok.of(par.Parent.Name), KW.invui))) then
							local texts = collectTexts(d, 8)
							if #texts > 0 then
								local cnt = nil
								for _, tx in ipairs(texts) do
									cnt = tx:match("[xX]%s*(%d[%d,]*)") or tx:match("(%d[%d,]*)%s*[xX]%f[%A]")
									if cnt then break end
								end
								slots = slots + 1
								rec(d, d.Name, { kind = "ui_slot", texts = L(texts), count_text = cnt or NO, image = (d:IsA("ImageButton") and plain(get(d, "Image"))) or NO,
									path = path(d), visible = get(d, "Visible") }, "client_instance:" .. path(d), "low")
							end
						end
					end
				end
				if clock() - t0 > CONFIG.FRAME_BUDGET then task.wait(); t0 = clock() end
			end
		end
	end

	-- equipped pets seen as followers in the world (low confidence)
	local followers = 0
	for _, r in ipairs(Store.lists.pets) do
		if r.properties.follows_local_player and not r.properties.removed_observed then followers = followers + 1 end
	end
	if followers > 0 then
		rec("equipped_followers", "equipped_pet_followers_visible", { kind = "derived_count", count = followers,
			basis = "pet models parented under a container named after the local player" }, "derived:pets", "low")
	end
	Log.info("Invent\u{E1}rio atualizado: " .. count .. " registros tocados.")
end

function Inventory.hook()
	local function hookContainer(cont, where)
		if not cont then return end
		Watch.add(cont, "inv_added", cont.ChildAdded, function(c)
			if c:IsA("Tool") then
				Events.push(where == "character" and "tool_equipped" or "inventory_changed", c, nil, "ChildAdded", nil, c.Name, { noLimit = true, location = where })
				Store.upsert("inventory", c, c.Name, { kind = "tool", class = c.ClassName, location = where, path = path(c), equipped = (where == "character"),
					attributes = Util.attrs(c), value_children = Util.valueChildren(c) }, "client_instance:" .. path(c), "high")
			end
		end)
		Watch.add(cont, "inv_removed", cont.ChildRemoved, function(c)
			if c:IsA("Tool") then
				Events.push(where == "character" and "tool_unequipped" or "inventory_changed", c, nil, "ChildRemoved", c.Name, nil, { noLimit = true, location = where })
			end
		end)
	end
	hookContainer(LocalPlayer:FindFirstChildOfClass("Backpack"), "backpack")
	hookContainer(LocalPlayer.Character, "character")
	Watch.add(LocalPlayer, "charadded", LocalPlayer.CharacterAdded, function(c)
		hookContainer(c, "character")
	end)
end


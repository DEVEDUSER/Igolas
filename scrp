local function buildGui()
	local sg = Instance.new("ScreenGui")
	sg.Name = "UBG_GUI"; sg.ResetOnSpawn = false; sg.DisplayOrder = 100000; sg.IgnoreGuiInset = true
	local parentOk = false
	if CAP.gethui then parentOk = pcall(function() sg.Parent = gethui() end) end
	if not parentOk or not sg.Parent then parentOk = pcall(function() sg.Parent = svc("CoreGui") end) end
	if not parentOk or not sg.Parent then sg.Parent = PlayerGui end
	GUI = sg
	local vp = viewport()
	local w = math.clamp(vp.X * 0.38, 250, 330)
	local h = 222
	local panel = Instance.new("Frame")
	panel.Size = UDim2.fromOffset(w, h); panel.Position = UDim2.fromOffset(8, 8)
	panel.BackgroundColor3 = Color3.fromRGB(24, 28, 40); panel.BorderSizePixel = 0; panel.Parent = sg
	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, -34, 0, 30); title.BackgroundColor3 = Color3.fromRGB(40, 90, 170); title.BorderSizePixel = 0
	title.Text = "Unboxing Gap v" .. CFG.VERSION; title.TextColor3 = Color3.new(1, 1, 1); title.Font = Enum.Font.GothamBold; title.TextSize = 14
	title.Active = true; title.Parent = panel
	local mini = Instance.new("TextButton")
	mini.Size = UDim2.fromOffset(34, 30); mini.Position = UDim2.new(1, -34, 0, 0); mini.BackgroundColor3 = Color3.fromRGB(170, 60, 60)
	mini.BorderSizePixel = 0; mini.Text = "-"; mini.TextColor3 = Color3.new(1, 1, 1); mini.Font = Enum.Font.GothamBold; mini.TextSize = 20; mini.Parent = panel
	local body = Instance.new("Frame")
	body.Size = UDim2.new(1, 0, 1, -30); body.Position = UDim2.fromOffset(0, 30); body.BackgroundTransparency = 1; body.Parent = panel
	local function label(y, height, size, color)
		local l = Instance.new("TextLabel")
		l.Size = UDim2.new(1, -16, 0, height); l.Position = UDim2.fromOffset(8, y); l.BackgroundTransparency = 1; l.Text = ""
		l.TextColor3 = color; l.Font = Enum.Font.Gotham; l.TextSize = size; l.TextWrapped = true
		l.TextXAlignment = Enum.TextXAlignment.Left; l.TextYAlignment = Enum.TextYAlignment.Top; l.Parent = body
		return l
	end
	local statusLabel = label(4, 62, 13, Color3.fromRGB(225, 230, 245))
	local missingLabel = label(68, 56, 12, Color3.fromRGB(240, 190, 90))
	local logLabel = label(126, 34, 11, Color3.fromRGB(150, 160, 180))
	local function button(text, xScale, color, cb)
		local b = Instance.new("TextButton")
		b.Size = UDim2.new(0.5, -12, 0, 34); b.Position = UDim2.new(xScale, xScale == 0 and 8 or 4, 1, -40)
		b.BackgroundColor3 = color; b.BorderSizePixel = 0; b.Text = text; b.TextColor3 = Color3.new(1, 1, 1)
		b.Font = Enum.Font.GothamBold; b.TextSize = 14; b.Parent = body
		connect(b.Activated, function()
			local ok, err = pcall(cb, b)
			if not ok then log("erro: " .. tostring(err)) end
		end)
		return b
	end
	button("EXPORTAR", 0, Color3.fromRGB(40, 150, 80), function() tspawn(function() doExport(false) end) end)
	local pauseBtn
	pauseBtn = button("PAUSAR", 0.5, Color3.fromRGB(200, 120, 30), function()
		paused = not paused
		pauseBtn.Text = paused and "CONTINUAR" or "PAUSAR"
		log(paused and "pausado (mapa, caixas e menus param; economia continua)" or "continuando")
		refreshGui()
	end)
	refreshGui = function()
		local secs = math.floor(Core.clock())
		local saved = Stats.lastSave and string.format("%ds atras", math.floor(os.clock() - Stats.lastSave)) or "nunca"
		statusLabel.Text = string.format("%s | %02d:%02d | salvo: %s\nmenus %d | caixas %d (quebradas %d) | mapa %d\ncliques %d | ledger %d | area: %s",
			paused and "PAUSADO" or "COLETANDO", math.floor(secs / 60), secs % 60, saved, #D.ui, boxCount, destroyedCount, Map.count,
			#D.clicks, #Ledger.events, tostring(Core.state.area or "?"))
		local miss = Core.missingLabels()
		if #miss == 0 then
			missingLabel.Text = "Todos os menus da lista foram vistos."
		else
			local txt = "Abra ainda: " .. table.concat(miss, ", ")
			if #txt > 150 then txt = string.sub(txt, 1, 147) .. "..." end
			missingLabel.Text = txt
		end
		logLabel.Text = lastLog
	end
	-- drag by the title bar
	local dragging, dragStart, startPos = false, nil, nil
	connect(title.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true; dragStart = input.Position; startPos = panel.Position
		end
	end)
	connect(UIS.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - dragStart
			panel.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
	connect(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)
	local minimized = false
	connect(mini.Activated, function()
		minimized = not minimized
		body.Visible = not minimized
		panel.Size = minimized and UDim2.fromOffset(w, 30) or UDim2.fromOffset(w, h)
	end)
	refreshGui()
end


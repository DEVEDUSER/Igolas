local function textProgressionFacts(inst, text)
	if #text == 0 or #text > 90 or not (text:find("%d")) then return nil end
	local tok, names = ancestorTokens(inst, 3)
	local low = text:lower()
	local kwHit = hit(tok, KW.prog)
	local lowHit = low:find("level") or low:find("rebirth") or low:find("require") or low:find("unlock") or low:find("stage") or low:find("rank") or low:find("xp%f[%A]")
	if not (kwHit or lowHit) then return nil end
	local kind = "progress_text"
	if low:find("require") or low:find("unlock") or low:find("need") then kind = "requirement_text" end
	local P = { kind = kind, text = trunc(text), path = path(inst), ui_context = L(names), parsed_number = parseNumber(text) or NO }
	local a, b = text:match("(%d[%d,%.]*%a*)%s*/%s*(%d[%d,%.]*%a*)")
	if a and b then P.fraction = { current = parseNumber(a) or NO, max = parseNumber(b) or NO } end
	return P
end

function Progression.onText(inst, text)
	local P = textProgressionFacts(inst, text)
	if P then Store.upsert("progression", inst, inst.Name, P, "gui_text:" .. P.path, "medium") end
end


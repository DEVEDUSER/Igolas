				pcall(fnc, txt)
				Core.info("relatorio compacto copiado para a area de transferencia (" .. #txt .. " bytes)")
			else
				Core.warn("sem setclipboard neste executor")
			end
			return
		end
		if id == "event" then
			ask(info, { { placeholder = "tipo (ex: hatch, observacao, boss)", default = "observacao" }, { placeholder = "texto (hatch: 'Nome do ovo = resultado')", default = "" } }, function(kind, txt)
				Main.ops.event(kind ~= "" and kind or "observacao", txt)
				Core.info("evento registrado: " .. tostring(kind))
			end)
			return
		end
		if id == "lighting" then
			ask({ title = "CAPTURAR ILUMINACAO", what = "Lighting, Atmosphere e efeitos de pos-processamento (valores numericos) no local onde voce esta.", wont = "Nao le texturas de ceu." }, { { placeholder = "rotulo (ex: Forest)", default = "" } }, function(label) task.spawn(Main.ops.lighting, label ~= "" and label or nil) end)
			return
		end
		ask(info, nil, function()
			task.spawn(function()
				if id == "damage" then
					local ok, res, state = Main.ops.damage()
					if not ok then Core.warn(tostring(res)) end
				else
					Main.ops[id]()
				end
			end)

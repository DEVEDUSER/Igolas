	for _, s in ipairs(UIc.snapshots) do out[#out + 1] = string.format("  %-28s gui %-16s %d nos%s", string.sub(s.label, 1, 28), s.gui, s.nodes, s.truncated > 0 and (" (TRUNCADO " .. s.truncated .. ")") or "") end
	out[#out + 1] = ""
	out[#out + 1] = "Menus prioritarios:"

------------------------------------------------------------------------------------------------------
World.current = nil
function World.track()
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end
	local okp, pos = pcall(rawGet, hrp, "Position")
	if not okp then return end
	local best, bestD, bestRec = nil, math.huge, nil
	local checked = 0
	for _, rec in ipairs(Store.lists.worlds) do
		local P = rec.properties
		local big = type(P.size) ~= "table" or (type(P.size.x) == "number" and type(P.size.z) == "number" and P.size.x >= 40 and P.size.z >= 40)
		if P.world_kind == "world" and P.root ~= "playergui" and P.class == "Model" and big and not P.removed_observed
			and type(P.position) == "table" and type(P.position.x) == "number" then
			checked = checked + 1
			if checked > 400 then break end
			local dx, dy, dz = pos.X - P.position.x, pos.Y - P.position.y, pos.Z - P.position.z
			local d = math.sqrt(dx * dx + dy * dy + dz * dz)
			local sz = P.size
			if type(sz) == "table" and type(sz.x) == "number" and abs(dx) <= sz.x / 2 and abs(dy) <= sz.y / 2 and abs(dz) <= sz.z / 2 then d = 0 end
			if d < bestD then best, bestD, bestRec = rec.name, d, rec end
		end
	end
	if best and best ~= World.current then
		local old = World.current
		World.current = best
		Events.push("world_changed", nil, bestRec, "nearest_world_record", old, best,
			{ distance_studs = bestD == math.huge and NULL or r2(bestD), basis = "distance_to_world_records_position_low_confidence", noLimit = true })
	end
end


local function geometry(inst, full)
	local g = {}
	if inst:IsA("BasePart") then
		g.position = plain(get(inst, "Position"))
		g.size = plain(get(inst, "Size"))
		g.orientation = plain(get(inst, "Orientation"))
		if full then
			g.anchored = get(inst, "Anchored")
			g.can_collide = get(inst, "CanCollide")
			g.transparency = plain(get(inst, "Transparency"))
			g.material = plain(get(inst, "Material"))
			g.color = plain(get(inst, "Color"))
		end
	elseif inst:IsA("Model") then
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok and cf then
			local pc = plain(cf)
			g.position = pc.position
			g.orientation = pc.orientation_degrees
		end
		if full then
			local oks, sz = pcall(inst.GetExtentsSize, inst)
			if oks then g.size = plain(sz) end
			local pp = get(inst, "PrimaryPart")
			g.primary_part = pp and pp.Name or NO
		end
	end
	return g
end

-- Collect visible text from an item: GUI text, ProximityPrompt text, Billboard/Surface GUIs of 3D objects.
local function collectTexts(root, cap)
	local out, seen = {}, {}
	local function add(s)
		if type(s) == "string" and s ~= "" and not seen[s] and #out < cap then
			seen[s] = true
			out[#out + 1] = trunc(s)
		end
	end
	local queue, qh, qt, nodes = { root }, 1, 1, 0
	local depthOf = { [root] = 0 }
	while qh <= qt and nodes < 600 do
		local n = queue[qh]
		qh = qh + 1
		nodes = nodes + 1
		local d = depthOf[n]
		if n:IsA("TextLabel") or n:IsA("TextButton") or n:IsA("TextBox") then
			add(get(n, "Text"))
		elseif n:IsA("ProximityPrompt") then
			add(get(n, "ActionText"))
			add(get(n, "ObjectText"))
		end
		if d < 6 and #out < cap then
			local ok, ch = pcall(n.GetChildren, n)
			if ok then
				for _, c in ipairs(ch) do
					if qt < 800 then
						qt = qt + 1
						queue[qt] = c
						depthOf[c] = d + 1
					end
				end
			end
		end
	end
	return out
end

local function extractFacts(texts)
	local F = { rarity = nil, damage_texts = {}, speed_texts = {}, price_texts = {}, multiplier_texts = {}, percent_texts = {},
		requirement_texts = {}, health_texts = {}, reward_texts = {} }
	local function add(list, s) if #list < 8 then list[#list + 1] = s end end
	for _, s in ipairs(texts) do
		local low = s:lower()
		local hasDigit = low:find("%d") ~= nil
		if low:find("%d%s*%%") then add(F.percent_texts, s) end
		if low:find("dmg") or low:find("damage") then add(F.damage_texts, s) end
		if low:find("speed") or low:find("cooldown") or low:find("/s%f[%A]") or low:find("per sec") then add(F.speed_texts, s) end
		if low:find("require") or low:find("unlock") or low:find("need") or low:find("rebirth") then add(F.requirement_texts, s) end
		if hasDigit and (low:find("%$") or low:find("price") or low:find("cost") or low:find("buy") or hasCurrencyWord(low)) then add(F.price_texts, s) end
		if s:find("%f[%a][xX]%s*%d") or s:find("%d%s*[xX]%f[%A]") then add(F.multiplier_texts, s) end
		if low:find("%d%s*/%s*%d") or low:find("health") or low:find("hp%f[%A]") then add(F.health_texts, s) end
		if low:find("reward") or low:find("drop") or low:find("loot") or low:find("earn") then add(F.reward_texts, s) end
		if not F.rarity then
			for w in low:gmatch("%a+") do
				if RARITY[w] then F.rarity = w break end
			end
		end
	end
	return F
end

local function normMap(attrsT, vals)
	local m = {}
	for k, v in pairs(attrsT) do m[Util.norm(k)] = { v = v, s = "attribute:" .. k, k = k } end
	for k, v in pairs(vals) do
		local nk = Util.norm(k)
		if not m[nk] and type(v) ~= "table" then m[nk] = { v = v, s = "value_object:" .. k, k = k } end
	end
	return m
end

local function pickField(m, aliases)
	for _, a in ipairs(aliases) do
		local e = m[a]
		if e and e.v ~= nil then return e.v, e.s end
	end
	return nil, nil
end

local function multipliersFrom(m)
	local out, n = {}, 0
	for nk, e in pairs(m) do
		if (nk:find("mult") or nk:find("boost") or nk:find("luck") or nk:find("bonus")) and n < 20 then
			out[e.k] = e.v
			n = n + 1
		end
	end
	return out, n
end

local function setField(P, FS, name, v, src)

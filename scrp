local function trackCrateReward(value)
    if type(value) == "string" then
        local s = string.lower(value)

        if s:find("eggrain") or s:find("egg rain") then Stats.eggRainGained = Stats.eggRainGained + 1 end
        if s:find("bombrain") or s:find("bomb rain") or s:find("bomb%-rain") then Stats.bombRainGained = Stats.bombRainGained + 1 end
        if s:find("ticket") then Stats.ticketsGained = Stats.ticketsGained + 1 end
    elseif type(value) == "table" then
        for k, v in pairs(value) do
            local key = string.lower(tostring(k))

            if key:find("ticket") and type(v) == "number" then
                Stats.ticketsGained = Stats.ticketsGained + v
            end

            trackCrateReward(k)
            trackCrateReward(v)
        end
    end
end


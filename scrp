local function getNearestWheelId()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local nearestId
    local nearestDist = math.huge

    for _, inst in ipairs(workspace:GetDescendants()) do
        local ok, wheelId = pcall(function()
            return inst:GetAttribute("WheelId")
        end)

        if ok and wheelId then
            local pos
            if inst:IsA("BasePart") then pos = inst.Position end
            if inst:IsA("Model") then pos = inst:GetPivot().Position end

            if pos then
                local dist = root and (pos - root.Position).Magnitude or 0
                if dist < nearestDist then
                    nearestDist = dist
                    nearestId = wheelId
                end
            end
        end
    end

    return nearestId
end


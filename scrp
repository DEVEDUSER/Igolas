    farmAreaStuckSince = nil
end

local function getEquippedPerkIds()
    local data = PlayerData.data
    local ids = {}

    if not data then return ids end

    if type(data.PerksEquipped) == "table" then
        for _, perkId in pairs(data.PerksEquipped) do
            if perkId then table.insert(ids, perkId) end
        end
    end

    if type(data.EquippedPerks) == "table" then
        for _, perkId in pairs(data.EquippedPerks) do
            if perkId then table.insert(ids, perkId) end
        end
    end

    if type(data.Perks) == "table" then
        for uniqueId, perk in pairs(data.Perks) do
            if perk and (perk.IsEquipped or perk.Equipped or perk.Slot or perk.TeamIndex) then
                table.insert(ids, uniqueId)
            end
        end
    end

    return ids
end


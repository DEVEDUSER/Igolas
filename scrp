local main = mk("Frame", { Size = UDim2.fromOffset(430, 330), Position = UDim2.fromOffset(20, 60), BackgroundColor3 = BG, BorderSizePixel = 0 }, sg)
mk("UICorner", { CornerRadius = UDim.new(0, 8) }, main)

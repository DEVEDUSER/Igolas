------------------------------------------------------------------------------------------------- util
local U = {}
Core.U = U
function U.num(n)
	if type(n) ~= "number" or n ~= n or n == math.huge or n == -math.huge then return nil end
	return math.floor(n * 1000 + 0.5) / 1000
end
local num = U.num
-- array elements are never nil (a hole would make JSONEncode fail for the whole file)
local function n0(x) return num(x) or 0 end
function U.v2(v) if typeof(v) ~= "Vector2" then return nil end return { n0(v.X), n0(v.Y) } end
function U.v3(v) if typeof(v) ~= "Vector3" then return nil end return { n0(v.X), n0(v.Y), n0(v.Z) } end
function U.c3(c)
	if typeof(c) ~= "Color3" then return nil end
	return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end
function U.ud(u) if typeof(u) ~= "UDim" then return nil end return { n0(u.Scale), u.Offset } end
function U.ud2(v)
	if typeof(v) ~= "UDim2" then return nil end
	return { { n0(v.X.Scale), v.X.Offset }, { n0(v.Y.Scale), v.Y.Offset } }
end
function U.enumName(e)
	if e == nil then return nil end
	local s = tostring(e)
	return s:match("%.([^%.]+)$") or s
end
function U.cf6(cf)
	if typeof(cf) ~= "CFrame" then return nil end
	local rx, ry, rz = cf:ToOrientation()
	return { n0(cf.X), n0(cf.Y), n0(cf.Z), n0(math.deg(rx)), n0(math.deg(ry)), n0(math.deg(rz)) }
end
function U.clean(s)
	if type(s) ~= "string" then return nil end
	if #s > 600 then s = string.sub(tostring(s), 1, 600) end
	local ok = true
	if utf8 and utf8.len then ok = (utf8.len(s) ~= nil) end
	if ok then return s end
	return (string.gsub(s, "[\128-\255]", "?"))
end
function U.sanitize(name)
	local s = string.gsub(tostring(name), "[^%w_%-]", "_")
	return string.sub(s, 1, 40)
end
function U.encodeSimple(v)
	local t = typeof(v)
	if t == "string" then return U.clean(v) end
	if t == "number" then return num(v) end
	if t == "boolean" then return v end
	if t == "Vector3" then return U.v3(v) end
	if t == "Color3" then return U.c3(v) end
	return tostring(v)
end
function U.attributes(inst)
	local ok, a = pcall(function() return inst:GetAttributes() end)
	if not ok or type(a) ~= "table" then return nil end
	local out, n = {}, 0
	for k, v in pairs(a) do out[tostring(k)] = U.encodeSimple(v); n = n + 1 end
	if n == 0 then return nil end
	return out
end
function U.nowIso()
	local ok, s = pcall(function() return os.date("!%Y-%m-%dT%H:%M:%SZ") end)
	return ok and s or tostring(os.time())
end
local function rd(inst, prop)
	local ok, v = pcall(function() return inst[prop] end)
	if ok then return v end
	return nil
end
Core.rd = rd

-- Display numbers ("125,280,955", "84.9Od", "x6.31k", "296%"). Unknown suffixes are NOT guessed: they are counted in `seen`.
-- "Od" (1e57) is derived from the ladder order Td,Qad,Qid,Sxd,Spd,Od,Nod and is listed in the summary so it can be confirmed.
local SUFFIX = { K = 1e3, M = 1e6, B = 1e9, T = 1e12, Qa = 1e15, Qi = 1e18, Sx = 1e21, Sp = 1e24, Oc = 1e27, No = 1e30, Dc = 1e33,
	Ud = 1e36, Dd = 1e39, Td = 1e42, Qad = 1e45, Qid = 1e48, Sxd = 1e51, Spd = 1e54, Od = 1e57, Nod = 1e60, Vg = 1e63 }
local TIME_UNITS = { min = true, mins = true, hr = true, hrs = true, sec = true, day = true, days = true }
function U.parseDisplay(text, seen)
	if type(text) ~= "string" then return nil end
	local clean = text:gsub("<[^>]+>", ""):gsub("^%s+", ""):gsub("%s+$", "")
	local pct = clean:match("^([%d%.,]+)%%$")
	if pct then
		local n = tonumber((pct:gsub(",", "")))
		if n then return { display = clean, approx = n, unit = "percent" } end
	end
	local numPart, suf = clean:match("^[x%+]?([%d%.,]+)%s*(%a*)$")
	if not numPart then return nil end
	local n = tonumber((numPart:gsub(",", "")))
	if not n then return nil end
	if suf == "" then return { display = clean, approx = n } end
	if TIME_UNITS[string.lower(suf)] then return { display = clean, approx = n, unit = "time:" .. string.lower(suf) } end
	local mult = SUFFIX[suf] or SUFFIX[string.upper(suf)]
	if mult then return { display = clean, approx = n * mult, suffix = suf } end
	if seen then seen[suf] = (seen[suf] or 0) + 1 end
	return { display = clean, suffix = suf, unknown_suffix = true }
end

function U.chunk(list, n)
	local out, cur = {}, nil
	for i = 1, #list do
		if not cur or #cur >= n then cur = {}; out[#out + 1] = cur end
		cur[#cur + 1] = list[i]
	end
	return out
end

-- path relative to Workspace ("Worlds.World1.Areas.06_PirateParadise.X") -> "World1_06_PirateParadise"
function Core.areaLabel(path)
	local world, rest = string.match(path, "Worlds%.([^%.]+)%.(.*)$")
	if not world then return "_other" end
	local area = string.match(rest, "^Areas%.([^%.]+)") or string.match(rest, "^EventAreas%.([^%.]+)")
	if area then return world .. "_" .. area end
	if string.match(rest, "^Lobby") then return world .. "_lobby" end
	return world .. "_misc"
end


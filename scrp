	if type(writefile) ~= "function" then
		Log.err("SALVAR precisa de writefile, indispon\u{ED}vel neste executor.")
		return
	end
	Dump.busy = true
	local ok, err = pcall(Dump._run, rootsOverride, label, useFolder)
	Dump.busy = false

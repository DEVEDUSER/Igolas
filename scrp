-- ---------------------------------------------------------------- utilidades
local function r(n) return math.floor(n * 100 + 0.5) / 100 end
local function c3(c) if typeof(c) ~= "Color3" then return nil end return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) } end
local function ud(u) return { r(u.Scale), u.Offset } end
local function ud2(v) return { ud(v.X), ud(v.Y) } end
local function v3(v) return { r(v.X), r(v.Y), r(v.Z) } end
local function enumName(e) return e and tostring(e):match("%.([^%.]+)$") or nil end
local function get(inst, prop)
	local ok, v = pcall(function() return inst[prop] end)
	if ok then return v end
	return nil
end

local canWrite = (type(writefile) == "function") and (type(makefolder) == "function")
local fallback = {}
if canWrite then pcall(function() if isfolder and not isfolder(OUT) then makefolder(OUT) end end) end
local savedCount = 0
local function save(name, data)
	local json = HttpService:JSONEncode(data)
	if canWrite then
		local ok, err = pcall(writefile, OUT .. "/" .. name .. ".json", json)
		if ok then savedCount = savedCount + 1 else log("nao gravou " .. name .. ": " .. tostring(err)) end
	else
		fallback[#fallback + 1] = '"' .. name .. '":' .. json
	end
end

-- ---------------------------------------------------------------- UI
local nodes = 0
local function dumpGui(inst, depth)
	nodes = nodes + 1
	if nodes > MAX_UI_NODES or depth > 14 then return nil end
	local n = { n = inst.Name, c = inst.ClassName }
	if inst:IsA("GuiObject") then
		n.vis = get(inst, "Visible")
		local p, s, a = get(inst, "Position"), get(inst, "Size"), get(inst, "AnchorPoint")
		if p then n.pos = ud2(p) end
		if s then n.size = ud2(s) end
		if a then n.anchor = { r(a.X), r(a.Y) } end
		local ap, as = get(inst, "AbsolutePosition"), get(inst, "AbsoluteSize")
		if ap then n.absPos = { r(ap.X), r(ap.Y) } end
		if as then n.absSize = { r(as.X), r(as.Y) } end
		n.bg = c3(get(inst, "BackgroundColor3"))
		n.bgT = get(inst, "BackgroundTransparency")
		n.z = get(inst, "ZIndex")
		n.order = get(inst, "LayoutOrder")
		local rot = get(inst, "Rotation")
		if rot and rot ~= 0 then n.rot = r(rot) end
	end
	if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
		n.text = get(inst, "Text")
		n.font = enumName(get(inst, "Font"))
		n.textSize = get(inst, "TextSize")
		n.textColor = c3(get(inst, "TextColor3"))
		n.textStrokeT = get(inst, "TextStrokeTransparency")
		n.textStroke = c3(get(inst, "TextStrokeColor3"))
		n.scaled = get(inst, "TextScaled")
	end
	if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
		local img = get(inst, "Image")
		n.hasImage = (img ~= nil and img ~= "")
		n.imageColor = c3(get(inst, "ImageColor3"))
		n.imageT = get(inst, "ImageTransparency")
		n.scaleType = enumName(get(inst, "ScaleType"))
	end
	if inst:IsA("UICorner") then local rr = get(inst, "CornerRadius") if rr then n.radius = ud(rr) end end
	if inst:IsA("UIStroke") then n.stroke = { c3(get(inst, "Color")), get(inst, "Thickness"), get(inst, "Transparency") } end
	if inst:IsA("UIGradient") then
		local cs = get(inst, "Color")
		local ks = {}
		if cs then for _, k in ipairs(cs.Keypoints) do ks[#ks + 1] = { r(k.Time), c3(k.Value) } end end
		n.gradient = { ks, get(inst, "Rotation") }
	end
	if inst:IsA("UIListLayout") then
		local pad = get(inst, "Padding")
		n.list = { enumName(get(inst, "FillDirection")), pad and ud(pad) or nil, enumName(get(inst, "HorizontalAlignment")), enumName(get(inst, "VerticalAlignment")) }
	end
	if inst:IsA("UIGridLayout") then
		local cs, cp = get(inst, "CellSize"), get(inst, "CellPadding")
		n.grid = { cs and ud2(cs) or nil, cp and ud2(cp) or nil }
	end
	if inst:IsA("UIPadding") then
		n.padding = { ud(inst.PaddingTop), ud(inst.PaddingBottom), ud(inst.PaddingLeft), ud(inst.PaddingRight) }
	end
	if inst:IsA("UIScale") then n.scale = get(inst, "Scale") end
	local kids = {}
	local okc, ch = pcall(inst.GetChildren, inst)
	if okc then
		for _, child in ipairs(ch) do
			local okk, k = pcall(dumpGui, child, depth + 1)
			if okk and k then kids[#kids + 1] = k end
		end
	end
	if #kids > 0 then n.k = kids end
	return n
end

local function measureUI()
	local count = 0
	log("medindo a interface...")
	local cam = Workspace.CurrentCamera
	save("meta", { viewport = cam and { cam.ViewportSize.X, cam.ViewportSize.Y } or nil })
	for _, gui in ipairs(PlayerGui:GetChildren()) do
		if gui:IsA("ScreenGui") and gui ~= sg then
			nodes = 0
			local ok, tree = pcall(dumpGui, gui, 0)
			if ok and tree then
				save("ui_" .. (gui.Name:gsub("[^%w]", "_")), tree)
				count = count + 1
				log("UI ok: " .. gui.Name .. " (" .. nodes .. " itens)")
			else
				log("UI falhou: " .. gui.Name .. " " .. tostring(tree))
			end
			task.wait()
		end
	end
	return count
end

-- ---------------------------------------------------------------- modelos
local function dumpModel(m)
	local parts = {}
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") then parts[#parts + 1] = d end
	end
	if m:IsA("BasePart") then parts[#parts + 1] = m end
	if #parts == 0 then return nil end
	local out = { n = m.Name, c = m.ClassName, path = m:GetFullName(), count = #parts, parts = {} }
	local pivot
	if m:IsA("Model") then pivot = m:GetPivot() elseif m:IsA("BasePart") then pivot = m.CFrame else pivot = parts[1].CFrame end
	if m:IsA("Model") then
		local cf, size = m:GetBoundingBox()
		out.box = { v3(pivot:PointToObjectSpace(cf.Position)), v3(size) }
	end
	table.sort(parts, function(a, b) return a.Size.X * a.Size.Y * a.Size.Z > b.Size.X * b.Size.Y * b.Size.Z end)
	for i = 1, math.min(#parts, MAX_PARTS) do
		local p = parts[i]
		local rel = pivot:ToObjectSpace(p.CFrame)
		local rx, ry, rz = rel:ToOrientation()
		out.parts[#out.parts + 1] = {
			n = p.Name, c = p.ClassName, pos = v3(rel.Position), rot = { r(math.deg(rx)), r(math.deg(ry)), r(math.deg(rz)) }, size = v3(p.Size),
			color = c3(p.Color), mat = enumName(p.Material), t = r(p.Transparency), shape = p:IsA("Part") and enumName(p.Shape) or nil,
			mesh = p:IsA("MeshPart") or nil,
		}
	end
	return out
end

local function measureModels()
	log("medindo modelos (pode levar 1 minuto)...")
	local found, seen, scanned = {}, {}, 0
	local function consider(inst)
		if #found >= MAX_MODELS or seen[inst] then return end
		if inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Folder") then
			seen[inst] = true
			local ok, data = pcall(dumpModel, inst)
			if ok and data then found[#found + 1] = data end
		end
	end
	for _, path in ipairs(FOLDERS) do
		local node = game
		for part in string.gmatch(path, "[^%.]+") do node = node and node:FindFirstChild(part) end
		if node then
			for _, child in ipairs(node:GetChildren()) do consider(child) end
		end
	end
	for _, root in ipairs({ ReplicatedStorage, Workspace }) do
		for _, d in ipairs(root:GetDescendants()) do
			scanned = scanned + 1
			if scanned % 1500 == 0 then task.wait() end
			if d:IsA("Model") or d:IsA("BasePart") then
				for _, pat in ipairs(PATTERNS) do
					if string.match(d.Name, pat) then consider(d) break end
				end
			end
			if #found >= MAX_MODELS then break end
		end
	end
	for i = 1, #found, 30 do
		local chunk = {}
		for j = i, math.min(i + 29, #found) do chunk[#chunk + 1] = found[j] end
		save("models_" .. tostring(math.floor((i - 1) / 30) + 1), chunk)
	end
	log("modelos medidos: " .. #found)
	return #found
end

local function finish()
	if canWrite then
		log("PRONTO. " .. savedCount .. " arquivos em workspace/" .. OUT .. ". Zipe a pasta e mande.")
	else
		local blob = "{" .. table.concat(fallback, ",") .. "}"
		if type(setclipboard) == "function" then
			setclipboard(blob)
			log("Sem writefile: os dados foram COPIADOS. Cole num arquivo de texto e mande.")
		else
			log("Este executor nao grava arquivos nem copia texto.")
		end
	end
end

local busy = false
local function run(doUI, doModels)
	if busy then return end
	busy = true
	task.spawn(function()
		local ok, err = pcall(function()
			if doUI then measureUI() end
			if doModels then measureModels() end
			finish()
		end)
		if not ok then log("ERRO: " .. tostring(err)) end
		busy = false
	end)
end


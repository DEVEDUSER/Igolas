function FSapi.detect()
	return {
		writefile = type(writefile) == "function", readfile = type(readfile) == "function", isfile = type(isfile) == "function",
		isfolder = type(isfolder) == "function", makefolder = type(makefolder) == "function", appendfile = type(appendfile) == "function",
		setclipboard = type(setclipboard) == "function", identifyexecutor = type(identifyexecutor) == "function",
	}
end

function FSapi.write(p, data)
	if type(writefile) ~= "function" then return false, "writefile_unavailable" end
	local ok, err = pcall(writefile, p, data)
	if not ok then return false, tostring(err) end
	if type(readfile) == "function" then
		local ok2, back = pcall(readfile, p)
		if not ok2 or type(back) ~= "string" then return true, "written_unverified" end
		if #back == #data then return true, "verified" end
		if #back >= #data * 0.95 then return true, "written_length_differs(" .. #back .. " vs " .. #data .. ")" end
		return false, "verify_failed(read " .. #back .. " of " .. #data .. " chars)"
	end
	return true, "written_unverified"
end

local STATIC_LIMITS = {
	{ "server_side_data", "Server-side data (DataStores, server Scripts, ServerStorage, ServerScriptService) is not replicated to the client and was not collected." },
	{ "script_sources", "Script sources were never read; only name/class are listed." },
	{ "hidden_probabilities", "Real drop tables and probabilities are only recorded when the game shows them in UI text, attributes or replicated values." },
	{ "display_values", "Values are what the client displays or replicates; they may be rounded or abbreviated (1.2K) and can differ from server values." },
	{ "heuristic_classification", "Records are classified by name tokens (box/egg/pet/weapon/world...). Names that do not contain those words are missed; some matches can be false positives. See per-record confidence." },
	{ "streaming", "With StreamingEnabled only instances streamed to this client are visible; far-away areas are captured only if you walk there while monitoring is running." },
	{ "other_players", "Other players' characters, per-player folders and data are excluded on purpose." },
	{ "remotes", "RemoteEvents/RemoteFunctions are listed by name/class only and are never invoked, so server-driven results (rewards, hatch outcomes) are only seen when they show up in replicated state or UI." },
	{ "timing_accuracy", "Times (lifetime, time-to-destroy) are measured by this client from the events it observes; replication latency and the first-observed moment limit their accuracy." },
	{ "world_detection", "Current-world detection is a distance heuristic against world records (low confidence) plus player attribute/leaderstat changes when present." },
	{ "event_rate_limit", "Observed events are rate limited per target/property and capped; record values still update, but not every intermediate change is stored." },
	{ "noise_classes", "Decorative classes without attributes (Attachment, Weld, Decal, SurfaceAppearance, particle/light classes, UI layout helpers) and plain parts that sit inside a Model are only counted, not listed; the Model record carries their position/size." },
	{ "attribute_quota", "Economy/progression attribute records are limited to 60 instances per attribute name; further copies are summarized (distinct values + counts) in the attribute_summary_* limitation entries." },
	{ "delta_api", "File export depends on the executor's writefile/readfile/makefolder. Export capabilities detected at runtime are listed in metadata.export_capabilities." },
}

function Exporter.limitations()
	local out = {}
	local function add(name, text, conf)
		out[#out + 1] = { id = string.format("lim_%03d", #out + 1), name = name, category = "limitations", properties = { description = text },
			source = "collector", collected_at = Util.iso(), confidence = conf or "high" }
	end
	for _, l in ipairs(STATIC_LIMITS) do add(l[1], l[2]) end
	for _, cat in ipairs(DATA_CATS) do
		if Store.dropped[cat] > 0 then
			add("record_cap_" .. cat, "Record cap reached for '" .. cat .. "': " .. Store.dropped[cat] .. " insert attempts were rejected (cap " .. (CONFIG.MAX_RECORDS[cat] or 2000) .. ").")
		end
	end
	for _, k in ipairs(Store.noteOrder) do add("note", Store.notes[k]) end
	for _, pair in ipairs({ { "economy", Economy.tr }, { "progression", Progression.tr } }) do
		local tr = pair[2]
		for k, vs in pairs(tr.values) do
			if (tr.keySkipped[k] or 0) > 0 then
				add("attribute_summary_" .. pair[1] .. "_" .. k, Json.encode({
					attribute = k, records_kept = ATTR_QUOTA, further_instances_only_counted = tr.keySkipped[k],
					distinct_values_and_counts = vs.d, note = "counts are approximate; at most 40 distinct values tracked" }))
			end
		end
	end
	if Queue.dropped > 0 then add("queue_overflow", Queue.dropped .. " DescendantAdded items were dropped because the queue was full.") end
	if Watch.capHit then add("watcher_cap", "The cap of " .. CONFIG.MAX_WATCHERS .. " live watchers was reached; some objects are not monitored for changes.") end
	for kind, n in pairs(Events.budgetSkipped) do
		add("event_budget_" .. kind, n .. " '" .. kind .. "' events were not stored (budget " .. EVENT_BUDGET[kind] .. " per kind, so they cannot fill the whole event list).")
	end
	if Events.muted > 0 or Events.skipped > 0 then add("events_rate_limited", Events.skipped .. " events skipped by rate limit, " .. Events.muted .. " keys muted after " .. CONFIG.EVENT_MAX_PER_KEY .. " events.") end
	if Session.missed > 0 then add("missed_while_paused", Session.missed .. " change notifications arrived while paused/idle and were not recorded.") end
	for _, m in ipairs(Modules) do
		if m.disabled then add("module_disabled", "Module '" .. m.name .. "' was disabled after repeated errors.", "high") end
	end
	if Log.suppressed > 0 then add("suppressed_errors", Log.suppressed .. " repeated error messages were suppressed in the console.") end
	if Session.scanState ~= "complete" then add("scan_incomplete", "Export taken while the initial scan state was '" .. Session.scanState .. "'; data may be partial.") end
	if get(Workspace, "StreamingEnabled") == true then add("streaming_enabled_detected", "Workspace.StreamingEnabled is true in this place.") end
	local n = 0
	for _ in pairs(Store.noiseCounts) do n = n + 1 end
	if n > 0 then add("noise_class_counts", Json.encode(Store.noiseCounts)) end
	return out
end

local function finalizeRecord(rec)
	return {
		id = rec.id, name = rec.name, category = rec.category, properties = rec.properties, source = rec.source,
		collected_at = rec.collected_at, last_updated_at = rec.last_updated_unix and Util.iso(rec.last_updated_unix) or nil,
		confidence = rec.confidence,
	}
end

local ORDER = { "worlds", "boxes", "weapons", "pets", "eggs", "economy", "progression", "inventory", "ui", "objects", "observed_events", "limitations" }

local function composeDoc(metaStr, cats, sep)
	local parts = { '{"metadata":', metaStr }
	for _, c in ipairs(ORDER) do
		local list = cats[c] or {}
		parts[#parts + 1] = ',"' .. c .. '":['
		if #list > 0 then
			if sep == "\n" then parts[#parts + 1] = "\n" end
			parts[#parts + 1] = table.concat(list, "," .. sep)
			if sep == "\n" then parts[#parts + 1] = "\n" end
		end
		parts[#parts + 1] = "]"
	end
	parts[#parts + 1] = "}"
	return table.concat(parts)
end

function Exporter.printFallback(label, data)
	local n = math.ceil(#data / CONFIG.PRINT_CHUNK)
	print(string.format("[UBRC] ===== BEGIN EXPORT %s (%d chars, %d chunks) =====", label, #data, n))
	for i = 1, n do
		local chunk = data:sub((i - 1) * CONFIG.PRINT_CHUNK + 1, i * CONFIG.PRINT_CHUNK)
		print(string.format("UBRC|%s|%d/%d|%s", label, i, n, chunk))
		if i % 20 == 0 then task.wait() end
	end
	print(string.format("[UBRC] ===== END EXPORT %s =====", label))
end

function Exporter._run()
	local stamp = os.date("!%Y%m%d_%H%M%S")
	local fsCaps = FSapi.detect()
	local encoded, counts, failures = {}, {}, 0
	-- Snapshot EVERYTHING synchronously first: the encode loop below yields, and the user may press
	-- LIMPAR DADOS or the game may keep adding records while it runs.
	local snaps = {}
	for _, cat in ipairs(DATA_CATS) do
		local s = {}
		for i, r in ipairs(Store.lists[cat]) do s[i] = r end
		snaps[cat] = s
	end
	local noiseSnap = {}
	for k, v in pairs(Store.noiseCounts) do noiseSnap[k] = v end
	local lims = Exporter.limitations()
	local snapState, snapScan, snapScanEnd = Session.state, Session.scanState, Session.tScanEnd
	local ly = clock()
	for _, cat in ipairs(DATA_CATS) do
		local snap = snaps[cat]
		if cat == "objects" and next(noiseSnap) ~= nil then
			snap[#snap + 1] = { id = "obj_noise_summary", name = "skipped_noise_class_counts", category = "objects", source = "collector", confidence = "high",
				collected_at = Util.iso(), properties = { kind = "class_summary", counts = noiseSnap, note = "counted, not listed" } }
		end
		local out = {}
		for _, rec in ipairs(snap) do
			local ok, s = pcall(function() return Json.encodeRecord(finalizeRecord(rec)) end)
			if not ok then
				failures = failures + 1
				s = Json.encodeRecord({ id = rec.id, name = rec.name, category = cat, properties = { error = "serialization_failed" }, source = rec.source,
					collected_at = rec.collected_at, confidence = "low" })
			end
			out[#out + 1] = s
			if clock() - ly > 0.01 then task.wait(); ly = clock() end
		end
		encoded[cat] = out
		counts[cat] = #out
	end
	if failures > 0 then
		lims[#lims + 1] = { id = string.format("lim_%03d", #lims + 1), name = "serialization_failures", category = "limitations",
			properties = { description = failures .. " records could not be serialized and were replaced by error stubs." }, source = "collector",
			collected_at = Util.iso(), confidence = "high" }
	end
	local limStrs = {}
	for _, l in ipairs(lims) do limStrs[#limStrs + 1] = Json.encodeRecord(l) end
	encoded.limitations = limStrs
	counts.limitations = #limStrs

	local executor = NO
	if type(identifyexecutor) == "function" then
		local ok, a, b = pcall(identifyexecutor)
		if ok then executor = tostring(a) .. (b and (" " .. tostring(b)) or "") end
	end
	local function metaFor(extra)
		local m = {
			game_name = "Unboxing Simulator", collector = "Unboxing Reference Collector", version = CONFIG.VERSION, timestamp = Util.iso(),
			place_id = tostring(game.PlaceId), collection_scope = "client_observable",
			game_id = tostring(game.GameId), place_name_observed = Session.placeName or NO, executor = executor,
			session_state = snapState, scan_state = snapScan,
			scan_duration_seconds = snapScanEnd and r2(snapScanEnd - Session.t0) or NO,
			streaming_enabled = get(Workspace, "StreamingEnabled") == true,
			record_counts = counts, export_capabilities = fsCaps,
		}
		if extra then m.export_part = extra end
		return Json.encode(m, { "game_name", "collector", "version", "timestamp", "place_id", "collection_scope" })
	end

	local total = 0
	for _, c in ipairs(ORDER) do
		for _, s in ipairs(encoded[c]) do total = total + #s + 2 end
	end

	local docs = {} -- { label, filename, compact(fn) }
	if total <= CONFIG.SINGLE_FILE_MAX_CHARS then
		docs[1] = { label = "full", file = "ubrc_" .. stamp .. ".json", cats = encoded, part = nil }
	else
		local parts = {}
		for _, c in ipairs(ORDER) do
			local cur, size = {}, 0
			local list = encoded[c]
			for _, s in ipairs(list) do
				if size + #s > CONFIG.PART_MAX_CHARS and #cur > 0 then
					parts[#parts + 1] = { cat = c, list = cur }
					cur, size = {}, 0
				end
				cur[#cur + 1] = s
				size = size + #s + 2
			end
			if #cur > 0 then parts[#parts + 1] = { cat = c, list = cur } end
		end
		for i, p in ipairs(parts) do
			local cats = {}
			cats[p.cat] = p.list
			docs[#docs + 1] = {
				label = string.format("p%02dof%02d_%s", i, #parts, p.cat),
				file = string.format("ubrc_%s_p%02dof%02d_%s.json", stamp, i, #parts, p.cat),
				cats = cats,
				part = { index = i, count = #parts, category = p.cat, records_in_part = #p.list, total_in_category = counts[p.cat] },
			}
		end
	end

	-- write
	local dir = CONFIG.EXPORT_DIR
	local useDir = false
	if fsCaps.writefile and fsCaps.makefolder and fsCaps.isfolder then
		local okf, exists = pcall(isfolder, dir)
		if okf and not exists then pcall(makefolder, dir) end
		local okf2, exists2 = pcall(isfolder, dir)
		useDir = okf2 and exists2 == true
	end
	local written, failed = {}, {}
	local index = { files = {}, total_records = counts, created = Util.iso() }
	for _, d in ipairs(docs) do
		local data = composeDoc(metaFor(d.part), d.cats, "\n")
		d.data = data
		local fname = (useDir and (dir .. "/") or "") .. d.file
		local ok, status = FSapi.write(fname, data)
		if ok then
			written[#written + 1] = fname
			index.files[#index.files + 1] = { file = d.file, chars = #data, category = d.part and d.part.category or "all", status = status }
			Log.info("Exportado: " .. fname .. " (" .. #data .. " chars, " .. status .. ")")
		else
			failed[#failed + 1] = d
			Log.warn("Falha ao gravar " .. fname .. ": " .. tostring(status))
		end
		task.wait()
	end
	if #docs > 1 and #written > 0 then
		local fname = (useDir and (dir .. "/") or "") .. "ubrc_" .. stamp .. "_index.json"
		local ok, status = FSapi.write(fname, Json.encode(index))
		if ok then Log.info("Exportado \u{ED}ndice: " .. fname) end
	end

	-- console fallback for anything that could not be written (never truncated silently)
	if #failed > 0 then
		Log.warn("Gravacao de arquivo indisponivel/falhou: imprimindo " .. #failed .. " parte(s) no console, em partes.")
		for _, d in ipairs(failed) do
			local compact = composeDoc(metaFor(d.part), d.cats, "")
			Exporter.printFallback(d.label, compact)
		end
		Log.warn("Console: linhas 'UBRC|<parte>|i/n|<dados>'. Junte os dados na ordem e remova quebras de linha (veja README).")
		if #failed == 1 and type(setclipboard) == "function" and #docs == 1 and #failed[1].data <= 1500000 then
			local okc = pcall(setclipboard, failed[1].data)
			if okc then Log.info("JSON completo copiado para a \u{E1}rea de transfer\u{EA}ncia.") end
		end
	end
	Log.info(string.format("Exporta\u{E7}\u{E3}o conclu\u{ED}da: %d arquivo(s) gravado(s), %d via console.", #written, #failed))
end

function Exporter.run()
	if Exporter.busy then
		Log.warn("Exporta\u{E7}\u{E3}o j\u{E1} em andamento.")
		return
	end
	Exporter.busy = true
	local ok, err = pcall(Exporter._run)
	Exporter.busy = false
	if not ok then Log.err("Export failed: " .. tostring(err)) end
end


Items.specs = {}

local function isEntity3D(inst)
	return inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Tool") or inst:IsA("Configuration") or inst:IsA("Accessory")
end

function Items.match(inst, ctx, spec)
	local cls = ctx.cls
	if ctx.rootTag == "playergui" then
		if not spec.ui or not ctx.isGuiObj then return nil end
		if not (inst:IsA("GuiButton") or cls == "Frame" or cls == "ImageLabel" or cls == "ViewportFrame") then return nil end
		if (ctx.parentCls == "Frame" or ctx.parentCls == "ScrollingFrame") then
			local par = hit(ctx.parentTok, spec.kw)
			if par then return "ui_container_child", par end
		end
		local own = hit(ctx.nameTok, spec.kw)
		if own and inst:IsA("GuiButton") then return "ui_named_button", own end
		return nil
	end
	if spec.tool and cls == "Tool" then return "tool_class", "tool" end
	local entity = isEntity3D(inst)
	if not entity and cls ~= "Folder" then return nil end
	local reason, kwHit
	local own = entity and hit(ctx.nameTok, spec.kw)
	if own and not (spec.ex and hit(ctx.nameTok, spec.ex)) then
		-- a BasePart inside a Model is a sub-part of that model, never an item of its own
		if inst:IsA("BasePart") and ctx.parentCls == "Model" then return nil end
		if Items.ancestorMatches(inst, spec, own) then return nil end
		reason, kwHit = "self_name", own
	elseif ctx.parent and (ctx.parentCls == "Folder" or ctx.parentCls == "Configuration") then
		local par = hit(ctx.parentTok, spec.kw)
		if par then
			reason, kwHit = "container_child", par
		elseif hit(ctx.parentTok, GENERIC_CONTAINER) and ctx.parent.Parent then
			local gp = ctx.parent.Parent
			if gp:IsA("Folder") or gp:IsA("Configuration") then
				local gpar = hit(Tok.of(gp.Name), spec.kw)
				if gpar then reason, kwHit = "container_grandchild", gpar end
			end
		end
	end
	if not reason then return nil end
	if spec.accept and not spec.accept(inst, ctx, reason, kwHit) then return nil end
	return reason, kwHit
end

-- true when an ancestor Model/BasePart/Tool already matched the same keyword (the instance is just a piece of it)
function Items.ancestorMatches(inst, spec, own)
	local cur = inst.Parent
	for _ = 1, 6 do
		if not cur or cur == game then return false end
		if cur:IsA("Model") or cur:IsA("BasePart") or cur:IsA("Tool") then
			local h = hit(Tok.of(cur.Name), spec.kw)
			if h and h == own and not (spec.ex and hit(Tok.of(cur.Name), spec.ex)) then return true end
		end
		cur = cur.Parent
	end
	return false
end

function Items.record(inst, ctx, spec, reason, kwHit)
	local cat = spec.cat
	local isUI = ctx.rootTag == "playergui"
	local attrsT = ctx:attrs()
	local vals = ctx:vals()
	local p = ctx:path()
	local P = {
		kind = isUI and "ui_item" or (ctx.cls == "Tool" and "tool" or "instance"),
		class = ctx.cls, path = p, root = ctx.rootTag, match_reason = reason, matched_keyword = kwHit,
		attributes = attrsT, value_children = vals, tags = ctx:tags(),
	}
	if ctx.phase == "dynamic" then P.loaded_dynamically = true elseif ctx.phase == "initial_scan" then P.loaded_dynamically = false end
	if isUI then
		P.visible = get(inst, "Visible")
		P.effective_visible = Hooks.effectiveVisible(inst)
		P.absolute_position = plain(get(inst, "AbsolutePosition"))
		P.absolute_size = plain(get(inst, "AbsoluteSize"))
		if inst:IsA("ImageButton") or inst:IsA("ImageLabel") then P.image = plain(get(inst, "Image")) end
	else
		for k, v in pairs(geometry(inst, true)) do P[k] = v end
		local par = ctx.parent
		if par then
			local pn = par.Name
			if pn == LocalPlayer.Name or pn == tostring(LocalPlayer.UserId) then P.follows_local_player = true end
		end
	end
	local texts = {}
	if ctx.cls ~= "Tool" then texts = collectTexts(inst, 40) end
	if ctx.cls == "Tool" then
		local tip = get(inst, "ToolTip")
		if type(tip) == "string" and tip ~= "" then texts[#texts + 1] = trunc(tip) end
	end
	if isUI and #texts == 0 and reason == "ui_container_child" and allIn(ctx.nameTok, GENERIC_UI) then return nil end
	P.ui_texts = L(texts)
	local facts = extractFacts(texts)
	local FS = {}
	local m = normMap(attrsT, vals)
	spec.fields(P, FS, m, facts, inst, ctx, kwHit)
	P.field_sources = FS
	local existing = Store.index[cat][inst]
	if existing and spec.keep then
		for _, k in ipairs(spec.keep) do P[k] = nil end
	end
	local conf = isUI and "low" or "medium"
	local rec, created = Store.upsert(cat, inst, inst.Name, P, "client_instance:" .. p .. " (" .. ctx.phase .. ")", conf)
	if rec and created then Store.aux[rec] = { t_first = clock() } end
	return rec, created
end

function Items.refresh(inst, cat)
	local spec = Items.specs[cat]
	if not spec then return nil end
	local b = Store.byInstance[inst]
	local old = b and b[cat]
	local tag = old and old.properties.root or Roots.tagOf(inst)
	local ctx = Ctx.make(inst, tag, "refresh")
	return Items.record(inst, ctx, spec, old and old.properties.match_reason or "refresh", old and old.properties.matched_keyword)
end

function Items.makeModule(spec)
	Items.specs[spec.cat] = spec
	return addModule(spec.cat, function(inst, ctx)
		local reason, kwHit = Items.match(inst, ctx, spec)
		if not reason then return end
		local rec, created = Items.record(inst, ctx, spec, reason, kwHit)
		if rec and created then
			Watch.attachItem(inst, rec, spec.cat)
			if ctx.phase == "dynamic" then Events.push("object_added", inst, rec, nil, nil, nil, { noLimit = true }) end
		elseif rec and ctx.rootTag == "playergui" and spec.ui then
			Watch.ensureAttr(inst)
		end
	end)
end

local function childListing(inst, kw)
	local out = {}
	local ok, ch = pcall(inst.GetChildren, inst)
	if not ok then return out end
	for _, c in ipairs(ch) do
		if (c:IsA("Folder") or c:IsA("Configuration") or c:IsA("Model")) and hit(Tok.of(c.Name), kw) then
			local ok2, gc = pcall(c.GetChildren, c)
			if ok2 then
				for _, g in ipairs(gc) do
					if #out >= 80 then break end
					local entry = { name = g.Name, class = g.ClassName }
					if g:IsA("ValueBase") then entry.value = plain(get(g, "Value")) end
					local ga = Util.attrs(g)
					if next(ga) ~= nil then entry.attributes = ga end
					out[#out + 1] = entry
				end
			end
		end
	end
	return out
end
local LIST_KW = set({ "pet", "drop", "reward", "loot", "chance", "possible", "content", "result" })

local function containerRarity(inst)
	local par = inst.Parent
	if par then
		local r = hit(Tok.of(par.Name), RARITY)
		if r then return r end
	end
	return nil
end


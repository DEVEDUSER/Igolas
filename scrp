		corner(tb, 5)
		tabButtons[tab.id] = tb
		tb.MouseButton1Click:Connect(function() select(tab) end)
	end
	select(TABS[1])

	-- progress / status
	Core.on("progress", function(p)
		bar.Size = UDim2.new(p.total > 0 and math.clamp(p.done / p.total, 0, 1) or 0, 0, 1, 0)
		status.Text = p.text .. (p.total > 0 and string.format("  (%d/%d)", p.done, p.total) or "")
	end)
	Core.on("log", function(line, level)
		status.Text = line
		status.TextColor3 = (level == "erro") and Color3.fromRGB(255, 110, 110) or ((level == "warn") and WARN or DIM)
	end)
	task.spawn(function()
		while gui.Parent do
			task.wait(1.5)
			if main.Visible then pcall(refresh) end
		end
	end)

	-- dragging and resizing (mouse + touch)
	local UIS = Core.UserInputService
	local dragging, resizing, startInput, startPos, startSize = false, false, nil, nil, nil
	local function isPointer(i) return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch end
	title.InputBegan:Connect(function(i)
		if isPointer(i) then dragging, startInput, startPos = true, i.Position, main.Position end
	end)
	handle.InputBegan:Connect(function(i)
		if isPointer(i) then resizing, startInput, startSize = true, i.Position, main.AbsoluteSize end
	end)
	UIS.InputChanged:Connect(function(i)
		if not (dragging or resizing) then return end
		if i.UserInputType ~= Enum.UserInputType.MouseMovement and i.UserInputType ~= Enum.UserInputType.Touch then return end
		local dx, dy = i.Position.X - startInput.X, i.Position.Y - startInput.Y
		if dragging then
			main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dx, startPos.Y.Scale, startPos.Y.Offset + dy)
		else
			main.Size = UDim2.new(0, math.clamp(startSize.X + dx, 360, vp.X), 0, math.clamp(startSize.Y + dy, 260, vp.Y))
		end
	end)
	UIS.InputEnded:Connect(function(i)
		if isPointer(i) then dragging, resizing = false, false end
	end)

	local minimized = false
	btnMin.MouseButton1Click:Connect(function()
		minimized = not minimized
		strip.Visible, body.Visible, footer.Visible, handle.Visible = not minimized, not minimized, not minimized, not minimized
		main.Size = minimized and UDim2.new(0, main.AbsoluteSize.X, 0, 30) or UDim2.new(0, main.AbsoluteSize.X, 0, H)
	end)
	btnClose.MouseButton1Click:Connect(function() gui:Destroy() end)
	UI.gui, UI.select, UI.refresh, UI.runAction = gui, select, refresh, runAction
	UI.tabButtons = tabButtons
	return gui
end

return UI


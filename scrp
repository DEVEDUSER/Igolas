-- Search by name (descendants of the readable roots) -> click a result -> its subtree is saved as JSON.
local Search = { busy = false }
-- Matches by name (or by full path when the query contains a dot). Results nested inside another result are
-- folded into it, because saving the parent already saves everything below it.
local SEARCH_LIMIT = 3000   -- collected (and saved); the list below shows the first 200
function Search.run(query, autoSave)
	query = tostring(query or ""):lower()
	if #query < 2 then
		Log.warn("Digite ao menos 2 letras para buscar.")
		return
	end
	if Search.busy then return end
	Search.busy = true
	Search.lastQuery = query
	task.spawn(function()
		local res, matched, nested, t0 = {}, setmetatable({}, { __mode = "k" }), 0, clock()
		local useFull = query:find(".", 1, true) ~= nil
		local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
		local rootsList = { Workspace, ReplicatedStorage, svc("ReplicatedFirst"), svc("StarterGui"), svc("StarterPack"), Lighting, PlayerGui, bp }
		for _, root in ipairs(rootsList) do
			if root and #res < SEARCH_LIMIT then
				local ok, desc = pcall(root.GetDescendants, root)
				if ok then
					for _, d in ipairs(desc) do
						if #res >= SEARCH_LIMIT then break end
						local hitName
						if useFull then hitName = path(d):lower():find(query, 1, true) ~= nil else hitName = d.Name:lower():find(query, 1, true) ~= nil end
						if hitName then
							local own = Session.ownGui
							if not (own and (d == own or d:IsDescendantOf(own))) and not Dump.excluded(d) and not insideExcluded(d) then
								local cur, covered = d.Parent, false
								for _ = 1, 40 do
									if not cur then break end
									if matched[cur] then covered = true break end
									cur = cur.Parent
								end
								if covered then
									nested = nested + 1
								else
									matched[d] = true
									res[#res + 1] = d
								end
							end
						end
						if clock() - t0 > CONFIG.FRAME_BUDGET then
							task.wait()
							t0 = clock()
						end
					end
				end
			end
		end
		Search.busy = false
		Search.last, Search.counts = res, nil
		Log.info(string.format("Busca '%s': %d resultado(s) principais (+%d dentro deles)%s.", query, #res, nested, #res >= SEARCH_LIMIT and " - limite atingido" or ""))
		if GUI.showResults then GUI.showResults(res, nested) end
		if autoSave then Control.saveResults() end
	end)
end

function Control.saveResults()
	local res = Search.last
	if not res or #res == 0 then
		Log.warn("Nenhum resultado para salvar. Fa\u{E7}a uma busca primeiro.")
		return
	end
	if Dump.repeated("search:" .. tostring(Search.lastQuery)) then
		Log.warn("Essa busca j\u{E1} foi salva h\u{E1} instantes; ignorado para n\u{E3}o duplicar a pasta.")
		return
	end
	local roots = {}
	for _, inst in ipairs(res) do
		if inst.Parent then roots[#roots + 1] = { label = inst.Name, inst = inst, tag = Roots.tagOf(inst) } end
	end
	local label = tostring(Search.lastQuery or "busca"):gsub("[^%w_%-]", "_"):sub(1, 30)
	Log.info("Salvando " .. #roots .. " resultado(s) da busca '" .. tostring(Search.lastQuery) .. "'...")
	task.spawn(Dump.run, roots, label, true) -- true = everything goes into one folder named after the search
end

-- UNIVERSAL SEARCH: lists the whole readable game as "units" of at most ~4000 instances each. A container that
-- is bigger than that is split into its children, so nothing is lost and every row stays a sensible file size.
-- Then SALVAR LISTA writes every unit into one folder (universal_<time>).
local function universalRoots()
	local list = {}
	for _, r in ipairs(Roots.list()) do list[#list + 1] = r end
	for _, name in ipairs({ "StarterGui", "StarterPlayer", "SoundService", "MaterialService" }) do
		local s = svc(name)
		if s then list[#list + 1] = { label = name, inst = s, tag = "other" } end
	end
	return list
end

function Search.universal()
	if Search.busy then return end
	Search.busy = true
	Search.lastQuery = "universal"
	task.spawn(function()
		local units, counts, t0, total = {}, setmetatable({}, { __mode = "k" }), clock(), 0
		local UNIT_MAX, MAX_UNITS = 4000, 3000
		local capped = false
		local function collect(inst, depth)
			if #units >= MAX_UNITS then capped = true return end
			local own = Session.ownGui
			if inst == own or Dump.excluded(inst) then return end
			local ok, n = pcall(function() return #inst:GetDescendants() end)
			n = ok and n or 0
			if n <= UNIT_MAX or depth >= 8 then
				units[#units + 1] = inst
				counts[inst] = n + 1
				total = total + n + 1
			else
				local okc, ch = pcall(inst.GetChildren, inst)
				if okc then
					for _, c in ipairs(ch) do collect(c, depth + 1) end
				end
			end
			if clock() - t0 > CONFIG.FRAME_BUDGET then
				task.wait()
				t0 = clock()
			end
		end
		for _, r in ipairs(universalRoots()) do
			local okc, ch = pcall(r.inst.GetChildren, r.inst)
			if okc then
				for _, c in ipairs(ch) do
					if not (r.tag == "player" and c == PlayerGui) then collect(c, 1) end
				end
			end
		end
		Search.busy = false
		Search.last, Search.counts = units, counts
		Log.info(string.format("Universal: %d bloco(s) cobrindo ~%d inst\u{E2}ncias%s. Toque em SALVAR LISTA para gravar tudo.", #units, total, capped and " (limite de blocos atingido)" or ""))
		if GUI.showResults then GUI.showResults(units) end
	end)
end

function Control.saveInstance(inst)
	if not inst or not inst.Parent then

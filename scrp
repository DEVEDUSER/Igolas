-- 12. CONTROL + GUI
------------------------------------------------------------------------------------------------------
------------------------------------------------------------------------------------------------------
-- SAVE ALL: whole client-visible tree -> JSON parts (names, classes, attributes, tags, plain properties).
-- This is a JSON tree for reference, NOT a .rbxl/.rbxm: it cannot be opened in Studio.
-- Script sources are never read (scripts are listed by name/class only). Other players' characters/folders
-- and the collector's own GUI are skipped. Streams to disk part by part (low memory), writes everything in one run.
------------------------------------------------------------------------------------------------------
local Dump = { busy = false, nodes = 0, total = 1, files = 0 }

function FSapi.ensureDir(dir)
	local caps = FSapi.detect()
	if not (caps.writefile and caps.makefolder and caps.isfolder) then return "" end
	local ok, exists = pcall(isfolder, dir)
	if ok and not exists then pcall(makefolder, dir) end
	local ok2, ex2 = pcall(isfolder, dir)
	if ok2 and ex2 == true then return dir .. "/" end
	return ""
end

local function dumpProps(inst, cls)
	local P = {}
	local function putP(k, raw) if raw ~= nil then P[k] = plain(raw) end end
	if inst:IsA("BasePart") then
		putP("pos", get(inst, "Position")); putP("size", get(inst, "Size")); putP("ori", get(inst, "Orientation"))
		local tr = get(inst, "Transparency")
		if tr and tr ~= 0 then putP("transparency", tr) end
		putP("anchored", get(inst, "Anchored")); putP("collide", get(inst, "CanCollide")); putP("material", get(inst, "Material"))
		local col = get(inst, "Color")
		if col then P.color = plain(col).hex end
		if cls == "MeshPart" then putP("mesh", get(inst, "MeshId")); putP("tex", get(inst, "TextureID")) end
		if cls == "Part" then putP("shape", get(inst, "Shape")) end
	elseif inst:IsA("Model") then
		local ok, cf = pcall(inst.GetPivot, inst)
		if ok and cf then
			local pc = plain(cf)
			P.pos, P.ori = pc.position, pc.orientation_degrees
		end
		local pp = get(inst, "PrimaryPart")
		if pp then P.primary = pp.Name end
	elseif inst:IsA("ValueBase") then
		putP("value", get(inst, "Value"))
	elseif inst:IsA("GuiObject") then
		putP("visible", get(inst, "Visible")); putP("pos", get(inst, "Position")); putP("size", get(inst, "Size"))
		putP("layout_order", get(inst, "LayoutOrder")); putP("z", get(inst, "ZIndex"))
		local bg = get(inst, "BackgroundColor3")
		if bg then P.bg = plain(bg).hex end
		if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then putP("text", get(inst, "Text")) end
		if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then putP("image", get(inst, "Image")) end
	elseif inst:IsA("LayerCollector") then
		putP("enabled", get(inst, "Enabled"))
	elseif inst:IsA("ProximityPrompt") then
		putP("action", get(inst, "ActionText")); putP("object", get(inst, "ObjectText")); putP("hold", get(inst, "HoldDuration"))
		putP("distance", get(inst, "MaxActivationDistance"))
	elseif inst:IsA("Tool") then
		putP("tooltip", get(inst, "ToolTip"))
	elseif inst:IsA("Humanoid") then
		putP("max_health", get(inst, "MaxHealth")); putP("display_name", get(inst, "DisplayName"))
	elseif inst:IsA("Decal") or inst:IsA("Texture") then
		putP("texture", get(inst, "Texture"))
	elseif inst:IsA("SpecialMesh") then
		putP("mesh", get(inst, "MeshId")); putP("scale", get(inst, "Scale"))
	elseif inst:IsA("Sound") then
		putP("sound", get(inst, "SoundId"))
	elseif inst:IsA("Animation") then
		putP("animation", get(inst, "AnimationId"))
	elseif inst:IsA("LuaSourceContainer") then
		P.script_source = "never_read"
	end
	return P
end

function Dump.excluded(inst)
	if inst == Session.ownGui then return true end
	local cls = inst.ClassName
	if cls == "Model" and Players:GetPlayerFromCharacter(inst) then return true end
	if (cls == "Folder" or cls == "Model") and OtherPlayers[inst.Name] then return true end
	if inst.Name == "Highscores" then return true end -- leaderboards hold other players' names/ids
	return false
end

-- ignore an identical save requested again within a few seconds (double taps)
function Dump.repeated(key)
	local t = clock()
	if Dump.lastKey == key and t - (Dump.lastT or 0) < 15 then return true end
	Dump.lastKey, Dump.lastT = key, t
	return false
end

function Dump._run(rootsOverride, label, useFolder)
	local stamp = os.date("!%Y%m%d_%H%M%S")
	local dirPrefix = FSapi.ensureDir(CONFIG.EXPORT_DIR)
	if useFolder and label and dirPrefix ~= "" then
		local sub = FSapi.ensureDir(CONFIG.EXPORT_DIR .. "/" .. label .. "_" .. stamp)
		if sub ~= "" then dirPrefix = sub end
	end
	local base = dirPrefix .. "ubrc_" .. (label and ("save_" .. label) or "fulltree") .. "_" .. stamp
	local roots = rootsOverride or Roots.list()
	if not rootsOverride then
		for _, name in ipairs({ "StarterGui", "StarterPlayer", "SoundService", "MaterialService" }) do
			local s = svc(name)
			if s then roots[#roots + 1] = { label = name, inst = s, tag = "other" } end
		end
	end
	local total = 0
	for _, r in ipairs(roots) do
		local ok, c = pcall(function() return #r.inst:GetDescendants() end)
		total = total + (ok and c or 0) + 1
	end
	Dump.nodes, Dump.total, Dump.files = 0, math.max(total, 1), 0

	local ids = setmetatable({}, { __mode = "k" })
	local n, buf, size, parts, failed, truncated = 0, {}, 0, 0, nil, false
	local written, rootIds = {}, {}

	local function flush()
		if #buf == 0 then return end
		parts = parts + 1
		local fname = string.format("%s_p%03d.json", base, parts)
		local meta = Json.encode({ kind = "full_tree_dump", part = parts, place_id = tostring(game.PlaceId), created = Util.iso(),
			note = "keys: i=id p=parent id n=name c=class a=attributes t=tags v=plain properties; script source never read" }, { "kind" })
		local data = '{"metadata":' .. meta .. ',"nodes":[\n' .. table.concat(buf, ",\n") .. "\n]}"
		local count = #buf
		local ok, status = FSapi.write(fname, data)
		if ok then
			written[#written + 1] = { file = fname, nodes = count, chars = #data, status = status }
			Dump.files = #written
		else
			failed = tostring(status)
		end
		buf, size = {}, 0
		task.wait()
	end

	local function emit(inst, pid)
		n = n + 1
		ids[inst] = n
		local cls = inst.ClassName
		local node = { i = n, p = pid, n = trunc(inst.Name), c = cls }
		if pid == 0 then node.rp = path(inst) end
		local a = Util.attrs(inst)
		for k in pairs(a) do
			local lk = k:lower()
			if lk:find("userid", 1, true) or lk:find("username", 1, true) or lk:find("ownerid", 1, true) then a[k] = nil end
		end
		if next(a) ~= nil then node.a = a end
		local tg = Util.tags(inst)
		if #tg > 0 then node.t = tg end
		local v = dumpProps(inst, cls)
		if next(v) ~= nil then node.v = v end
		local s = Json.encode(node)
		buf[#buf + 1] = s
		size = size + #s + 2
		Dump.nodes = n
		if size >= CONFIG.PART_MAX_CHARS then flush() end
	end

	local t0 = clock()
	for _, r in ipairs(roots) do
		if failed or truncated then break end
		Log.info("Salvar tudo: " .. r.label)
		emit(r.inst, 0)
		rootIds[r.label] = n
		local stack, sp = {}, 0
		local function push(inst, depth)
			local ok, ch = pcall(inst.GetChildren, inst)
			if ok and #ch > 0 then
				if #ch > CONFIG.DUMP_MAX_CHILDREN then
					Store.note("dump_children:" .. path(inst), "SALVAR TUDO: only the first " .. CONFIG.DUMP_MAX_CHILDREN .. " of " .. #ch .. " children of " .. path(inst) .. " were written.")
				end
				sp = sp + 1
				stack[sp] = { ch, 1, depth, ids[inst] }
			end
		end
		push(r.inst, 1)
		while sp > 0 and not failed do
			local f = stack[sp]
			local ch, i = f[1], f[2]
			if i > math.min(#ch, CONFIG.DUMP_MAX_CHILDREN) then
				stack[sp] = nil
				sp = sp - 1
			else
				f[2] = i + 1
				local inst = ch[i]
				local skip = Dump.excluded(inst) or (r.tag == "player" and inst == PlayerGui)
				if not skip then
					if n >= CONFIG.DUMP_MAX_NODES then
						truncated = true
						break
					end
					local okE, errE = pcall(emit, inst, f[4])
					if not okE then Log.errOnce("dump", "save all node: " .. tostring(errE)) end
					if f[3] < CONFIG.DUMP_MAX_DEPTH and ids[inst] then push(inst, f[3] + 1) end
				end
				if clock() - t0 > CONFIG.FRAME_BUDGET * 1.5 then
					task.wait()
					t0 = clock()
				end
			end
		end
	end
	flush()
	local idx = { kind = "full_tree_index", place_id = tostring(game.PlaceId), created = Util.iso(), nodes = n, parts = written, roots = rootIds,
		truncated_at_node_limit = truncated, write_error = failed or NULL,
		excluded = "other players' characters/folders, the collector's own GUI, script sources (never read)", format = "JSON tree for reference; not loadable in Studio" }
	FSapi.write(base .. "_index.json", Json.encode(idx))
	if failed then
		Log.err("Salvar tudo: falha ao gravar (" .. failed .. "). Gravados " .. #written .. " arquivo(s).")
	else
		Log.info(string.format("Salvar tudo concluido: %d nos em %d arquivo(s) (%s_*.json).", n, #written, base))
	end
	if truncated then Log.warn("Limite de " .. CONFIG.DUMP_MAX_NODES .. " nos atingido; o restante nao foi salvo.") end
end

function Dump.run(rootsOverride, label, useFolder)
	if Dump.busy then
		Log.warn("Salvar tudo j\u{E1} em andamento.")

tspawn(function()
	local tUI, tBox, tSave, tGui, tArea, tMap = 0, 0, os.clock(), 0, 0, os.clock() - CFG.MAP_AUTO_GAP + 5
	local lastMapPos, lastMapArea = nil, nil
	while alive do
		local now = os.clock()
		if not paused then
			if now - tArea >= 1 then
				tArea = now
				local ok, err = pcall(updateArea)
				if not ok then log("area: " .. tostring(err)) end
			end
			if now - tUI >= CFG.UI_SCAN then
				tUI = now
				local ok, err = pcall(scanUI)
				if not ok then log("scanUI: " .. tostring(err)) end
			end
			if now - tBox >= CFG.BOX_SCAN then
				tBox = now
				local ok, err = pcall(scanBoxes)
				if not ok then log("scanBoxes: " .. tostring(err)) end
			end
			if not mapBusy and now - tMap >= CFG.MAP_AUTO_GAP then
				local rp = rootPart()
				if rp then
					local p = rp.Position
					local moved = (lastMapPos == nil) or (p - lastMapPos).Magnitude >= CFG.MAP_AUTO_MOVE
					local areaChanged = Core.state.area ~= nil and Core.state.area ~= lastMapArea
					if moved or areaChanged then
						tMap, lastMapPos, lastMapArea = now, p, Core.state.area
						tspawn(scanMap)
					end
				end
			end
		end
		if now - tGui >= 1 then
			tGui = now
			pcall(refreshGui)
		end
		if now - tSave >= CFG.AUTOSAVE then
			tSave = now
			if CAP.writefile and totalCount() ~= lastExportCount then
				local ok, err = pcall(doExport, true)
				if not ok then log("autosave: " .. tostring(err)) end
			end
		end
		twait(0.25)
	end
end)

------------------------------------------------------------------------------------------------- UI watcher (menus open by themselves)
local covered = setmetatable({}, { __mode = "k" })
local pending = setmetatable({}, { __mode = "k" })
local lastSig, labelCount, labelChild = {}, {}, {}
local function viewport()
	local cam = Workspace.CurrentCamera
	if cam then return cam.ViewportSize end
	return Vector2.new(800, 400)
end
local function capturePanel(node)
	local pathNames = {}
	local label = relPath(node, PlayerGui)
	for seg in string.gmatch(label, "[^%.]+") do pathNames[#pathNames + 1] = seg end
	if Core.isDeniedPanel(node.Name) then covered[node] = true; return end
	local snap = Core.snapshotTree(node, { yield = slice, covered = covered, maxNodes = CFG.UI_MAX_NODES })
	if snap.node_count < CFG.UI_MIN_NODES then return end -- trivial overlay (fade bar, glow...)
	local sig = Core.snapSig(snap.nodes)
	if lastSig[label] == sig then return end
	lastSig[label] = sig
	local children = {}
	for _, r in ipairs(snap.nodes) do
		-- visible direct children of the panel (e.g. "Inventory", "TeleportMenu" under ActivePage) identify which menu is open
		if not r.hidden and r.p ~= "" and not string.find(r.p, "/", 1, true) and not string.find(r.c or "", "^UI") then children[#children + 1] = r.p end
	end
	labelChild[label] = children[1]
	local lastThree = {}
	for i = math.max(1, #pathNames - 2), #pathNames do lastThree[#lastThree + 1] = pathNames[i] end
	local hits = Core.matchChecklist(lastThree, children)
	Core.markChecklist(hits, label)
	local vp = viewport()
	D.ui[#D.ui + 1] = { gap_version = CFG.VERSION, session = SID, kind = "ui_snapshot", label = label, clock = num(Core.clock()), ts = U.nowIso(), area = Core.state.area,
		viewport = { n0(vp.X), n0(vp.Y) }, node_count = snap.node_count, hidden_count = snap.hidden_count, truncated = snap.truncated, matched = hits,
		visible_children = children, nodes = snap.nodes }
	Stats.scans.ui = Stats.scans.ui + 1
	log("menu medido: " .. label .. " (" .. snap.node_count .. " nos)")
	refreshGui()
end
local function scanUI()
	local vp = viewport()
	local minX, minY = vp.X * CFG.UI_MIN_FRAC, vp.Y * CFG.UI_MIN_FRAC
	local stack = {}
	for _, sg in ipairs(PlayerGui:GetChildren()) do
		if sg:IsA("ScreenGui") and rd(sg, "Enabled") ~= false and not isMine(sg) then
			local kids = sg:GetChildren()
			for i = #kids, 1, -1 do stack[#stack + 1] = kids[i] end
		end
	end
	local now = os.clock()
	local ctxBest = ""
	local ctxLabel
	while #stack > 0 do
		local node = table.remove(stack)
		if not node:IsA("GuiObject") then
			local kids = node:GetChildren() -- Folders and similar: look inside
			for i = #kids, 1, -1 do stack[#stack + 1] = kids[i] end
		elseif rd(node, "Visible") ~= false then
			local sz = rd(node, "AbsoluteSize")
			local big = typeof(sz) == "Vector2" and sz.X >= minX and sz.Y >= minY
			local descend = true
			if big then
				local label = relPath(node, PlayerGui)
				if string.find(label, "ActivePage", 1, true) and #label > #ctxBest then ctxBest = label; ctxLabel = label end
				if not covered[node] then
					descend = false
					local t0 = pending[node]
					if (labelCount[label] or 0) >= 2 then
						covered[node] = true -- same path already measured twice (transient clones): do not spam
					elseif not t0 then
						pending[node] = now
					elseif now - t0 >= CFG.UI_SETTLE then
						pending[node] = nil
						labelCount[label] = (labelCount[label] or 0) + 1
						capturePanel(node)
					end
				end
			end
			if descend then
				local kids = node:GetChildren()
				for i = #kids, 1, -1 do stack[#stack + 1] = kids[i] end
			end
		else
			pending[node] = nil
		end
		slice()
	end
	if ctxLabel then
		local short = string.gsub(ctxLabel, "^MainScreen%.Center%.", "")
		if labelChild[ctxLabel] then short = short .. "/" .. labelChild[ctxLabel] end
		Core.state.ctx = short
	else
		Core.state.ctx = nil
	end
end

------------------------------------------------------------------------------------------------- boxes
local boxes, boxCount, boxTotal, destroyedCount = setmetatable({}, { __mode = "k" }), 0, 0, 0
local guiSeen = setmetatable({}, { __mode = "k" })
local scanNo = 0
local function boxEvent(b, kind, data)
	if boxTotal >= CFG.BOX_TOTAL_CAP then return end
	if #b.events >= CFG.BOX_EVENT_CAP then b.dropped = (b.dropped or 0) + 1; return end
	boxTotal = boxTotal + 1
	local e = { c = num(Core.clock()), k = kind }
	if data then for k, v in pairs(data) do e[k] = v end end
	b.events[#b.events + 1] = e
end
local function dist3(a, b)
	if not a or not b then return nil end
	local dx, dy, dz = a[1] - b[1], a[2] - b[2], a[3] - b[3]
	return math.sqrt(dx * dx + dy * dy + dz * dz)
end
local function instPos(inst)
	if inst:IsA("BasePart") then return inst.Position end
	if inst:IsA("Model") then
		local ok, pv = pcall(function() return inst:GetPivot() end)
		if ok then return pv.Position end
	end
	return nil
end
local function closeBox(b, how)
	if b.ended then return end
	b.ended = num(Core.clock())
	b.end_how = how
	local d = dist3(rootPos(), b.pos)
	if d and d > CFG.BOX_RADIUS * 1.15 then
		boxEvent(b, "gone_far", { dist = num(d), how = how }) -- streamed out / player walked away: not a break
	else
		destroyedCount = destroyedCount + 1
		boxEvent(b, "destroyed", { dist = d and num(d) or nil, how = how })
		Ledger.openWindow(b.reward)
	end
end
-- the game keeps live boxes as nameless MeshParts in a nameless Folder under Workspace, tagged with attributes BoxType/Currency/Size
local function watchBox(inst, kind)
	if boxes[inst] then return end
	boxCount = boxCount + 1
	local b = { id = boxCount, name = inst.Name, kind = kind, path = relPath(inst, Workspace), first = num(Core.clock()), events = {}, reward = {}, nwatch = 0,
		area = Core.state.area, ctx = Core.state.ctx }
	local pos = instPos(inst)
	if pos then b.pos = U.v3(pos) end
	if inst:IsA("BasePart") then
		b.cf = U.cf6(inst.CFrame); b.size = U.v3(inst.Size); b.transparency = U.num(inst.Transparency)
		b.class = inst.ClassName
	end
	b.attrs = U.attributes(inst)
	b.tool = equipped(); b.player_pos = rootPos(); b.player_attrs = U.attributes(LocalPlayer)
	boxes[inst] = b
	D.boxes[#D.boxes + 1] = b
	-- the game's own FrozenBox bookkeeping and the spawn tween (size/position) are noise: counted per box, only the first few are stored
	b.counts = {}
	local function counted(kind, keep, data)
		local n = (b.counts[kind] or 0) + 1
		b.counts[kind] = n
		if n <= keep then boxEvent(b, kind, data) end
	end
	connect(inst.AttributeChanged, function(name)
		if name == "FrozenBoxUid" or name == "FrozenAt" then
			counted("attr:" .. name, 2, { name = name, v = U.encodeSimple(inst:GetAttribute(name)) })
		else
			boxEvent(b, "attr", { name = name, v = U.encodeSimple(inst:GetAttribute(name)) })
		end
	end)
	if inst:IsA("BasePart") then
		connect(inst:GetPropertyChangedSignal("Transparency"), function() boxEvent(b, "transparency", { v = U.num(rd(inst, "Transparency")) }) end)
		connect(inst:GetPropertyChangedSignal("Size"), function() counted("size", 6, { v = U.v3(rd(inst, "Size")) }) end)
		connect(inst:GetPropertyChangedSignal("Position"), function() counted("moved", 6, { v = U.v3(rd(inst, "Position")) }) end)
	end
	for _, d in ipairs(inst:GetDescendants()) do
		if b.nwatch >= CFG.BOX_WATCH_PER then break end
		if d:IsA("ValueBase") then
			b.nwatch = b.nwatch + 1
			connect(d:GetPropertyChangedSignal("Value"), function() boxEvent(b, "value", { name = d.Name, v = U.encodeSimple(rd(d, "Value")) }) end)
		elseif d:IsA("Humanoid") then
			b.nwatch = b.nwatch + 1
			connect(d:GetPropertyChangedSignal("Health"), function() boxEvent(b, "health", { v = num(rd(d, "Health")), max = num(rd(d, "MaxHealth")) }) end)
		end
	end
	connect(inst.AncestryChanged, function(_, parent)
		if parent == nil then closeBox(b, "removed") end
	end)
	boxEvent(b, "watching", { pos = b.pos })
end
-- health bars / labels of a box are BillboardGui or SurfaceGui under PlayerGui whose Adornee is the box
local function attachGui(gui, b)
	if guiSeen[gui] then return end
	guiSeen[gui] = true
	b.gui = relPath(gui, PlayerGui)
	b.gui_initial = {}
	for _, d in ipairs(gui:GetDescendants()) do
		if b.nwatch >= CFG.BOX_WATCH_PER then break end
		local rel = relPath(d, gui)
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			b.nwatch = b.nwatch + 1
			b.gui_initial[rel] = U.clean(rd(d, "Text"))
			connect(d:GetPropertyChangedSignal("Text"), function()
				local tx = rd(d, "Text")
				local pr = U.parseDisplay(tx, Stats.suffix_seen)
				boxEvent(b, "gtext", { label = rel, text = U.clean(tx), a = pr and pr.approx })
			end)
		elseif d:IsA("GuiObject") then
			b.nwatch = b.nwatch + 1
			b.gui_initial[rel] = U.ud2(rd(d, "Size"))
			connect(d:GetPropertyChangedSignal("Size"), function() boxEvent(b, "gbar", { name = rel, us = U.ud2(rd(d, "Size")) }) end)
		end
	end
	boxEvent(b, "gui", { path = b.gui })
end
evalGui = function(gui)
	local ad = rd(gui, "Adornee")
	if ad and boxes[ad] then attachGui(gui, boxes[ad]) end
end
local function scanGuis()
	for _, d in ipairs(PlayerGui:GetDescendants()) do
		if (d:IsA("BillboardGui") or d:IsA("SurfaceGui")) and not guiSeen[d] and not isMine(d) then evalGui(d) end
		slice()
	end
end
local function considerBox(inst, rpos)
	if boxes[inst] then return end
	local ok, bt = pcall(function() return inst:GetAttribute("BoxType") end)
	if not ok or bt == nil then return end
	local pos = instPos(inst)
	if not pos or (pos - rpos).Magnitude > CFG.BOX_RADIUS then return end
	watchBox(inst, tostring(bt))
end
local function scanBoxes()
	local root = rootPart()
	if not root then return end
	local rpos = root.Position
	scanNo = scanNo + 1
	-- 1) cheap: every Folder directly under Workspace, one level down (live boxes are kept there)
	for _, f in ipairs(Workspace:GetChildren()) do
		if f:IsA("Folder") then
			for _, c in ipairs(f:GetChildren()) do considerBox(c, rpos) end
			slice()
		end
	end
	-- 2) fallback every 5th scan: spatial query, in case boxes also exist elsewhere
	if scanNo % 5 == 1 then
		local params = OverlapParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { LocalPlayer.Character }
		params.MaxParts = 1500
		local ok, parts = pcall(function() return Workspace:GetPartBoundsInRadius(rpos, CFG.BOX_RADIUS, params) end)
		if ok then
			for _, p in ipairs(parts) do
				considerBox(p, rpos)
				local m = p.Parent
				if m and m:IsA("Model") then considerBox(m, rpos) end
			end
		end
	end
	Stats.scans.box = Stats.scans.box + 1
	if scanNo % 4 == 2 and #D.boxes > 0 then scanGuis() end
end

------------------------------------------------------------------------------------------------- map (automatic when you move far or change area)
local Map = D.map
local pathIdx, modelSeen, seenPart, boardSeen = {}, {}, {}, {}
local mapBusy = false
local function pathId(p)
	local i = pathIdx[p]
	if not i then
		i = #Map.paths + 1
		Map.paths[i] = p
		pathIdx[p] = i
	end
	return i
end
local function addPrompt(pr, path)
	if #Map.prompts >= 5000 then return end
	Map.prompts[#Map.prompts + 1] = { m = pathId(path), obj = U.clean(rd(pr, "ObjectText")), act = U.clean(rd(pr, "ActionText")), hold = U.num(rd(pr, "HoldDuration")),
		dist = U.num(rd(pr, "MaxActivationDistance")), key = U.enumName(rd(pr, "KeyboardKeyCode")), enabled = rd(pr, "Enabled") }
end
local function addPart(p)
	if Map.count >= CFG.MAP_MAX then Map.capHit = true; return 0 end
	if not p:IsA("BasePart") then return 0 end
	local holder = p:FindFirstAncestorOfClass("Model") or p.Parent
	local path = relPath(holder, Workspace)
	local cf = U.cf6(p.CFrame)
	if not cf then return 0 end
	local key = path .. "|" .. p.Name .. "|" .. string.format("%.1f,%.1f,%.1f", cf[1], cf[2], cf[3])
	if seenPart[key] then return 0 end
	seenPart[key] = true
	local label = Core.areaLabel(path)
	local rec = { m = pathId(path), n = p.Name, c = p.ClassName, cf = cf, sz = U.v3(p.Size), col = U.c3(p.Color), mat = U.enumName(p.Material) }
	local tr = U.num(p.Transparency)
	if tr and tr ~= 0 then rec.tr = tr end
	if p.CanCollide == false then rec.cc = false end
	if p:IsA("MeshPart") then rec.mesh = true; rec.ms = U.v3(rd(p, "MeshSize")) end -- mesh id never read
	if p:IsA("Part") then rec.shape = U.enumName(rd(p, "Shape")) end
	local at = U.attributes(p)
	if at then rec.attr = at end
	local list = Map.byArea[label]
	if not list then list = {}; Map.byArea[label] = list end
	list[#list + 1] = rec
	Map.count = Map.count + 1
	if not modelSeen[path] then
		modelSeen[path] = true
		local mt = { m = pathId(path), attrs = U.attributes(holder) }
		local okT, tags = pcall(function() return CollectionService:GetTags(holder) end)
		if okT and type(tags) == "table" and #tags > 0 then mt.tags = tags end
		if mt.attrs or mt.tags then Map.meta[#Map.meta + 1] = mt end
	end
	for _, ch in ipairs(p:GetChildren()) do
		if ch:IsA("ProximityPrompt") then
			addPrompt(ch, path)
		elseif ch:IsA("Attachment") then
			for _, g in ipairs(ch:GetChildren()) do
				if g:IsA("ProximityPrompt") then addPrompt(g, path) end
			end
		end
	end
	return 1
end
local function harvestBoards()
	local oa = PlayerGui:FindFirstChild("OtherApps")
	if not oa then return 0 end
	local n = 0
	for _, d in ipairs(oa:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			local tx = rd(d, "Text")
			if type(tx) == "string" and tx ~= "" then
				local p = relPath(d, PlayerGui)
				local k = p .. "|" .. tx
				if not boardSeen[k] and #D.board < 20000 then
					boardSeen[k] = true
					D.board[#D.board + 1] = { p = p, text = U.clean(tx), vis = rd(d, "Visible"), area = Core.state.area }
					n = n + 1
				end
			end
		end
		slice()
	end
	return n
end
local function scanMap()
	if mapBusy then return end
	local root = rootPart()
	if not root then return end
	mapBusy = true
	local ok, err = pcall(function()
		local params = OverlapParams.new()
		local worlds = Workspace:FindFirstChild("Worlds")
		if worlds then
			params.FilterType = Enum.RaycastFilterType.Include
			params.FilterDescendantsInstances = { worlds }
		else
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { LocalPlayer.Character }
		end
		params.MaxParts = 4000
		local c = root.Position
		local R, cell = CFG.MAP_RADIUS, CFG.MAP_CELL
		local added, saturated, qerr = 0, 0, nil
		local x = -R
		while x <= R do
			local z = -R
			while z <= R do
				if alive and (x * x + z * z) <= (R + cell) * (R + cell) then
					local okq, parts = pcall(function()
						return Workspace:GetPartBoundsInBox(CFrame.new(c.X + x + cell / 2, c.Y, c.Z + z + cell / 2), Vector3.new(cell, 6000, cell), params)
					end)
					if okq then
						if #parts >= params.MaxParts then saturated = saturated + 1 end
						for _, p in ipairs(parts) do added = added + addPart(p); slice() end
					else
						qerr = qerr or tostring(parts)
					end
					twait()
				end
				z = z + cell
			end
			x = x + cell
		end
		Stats.scans.map = Stats.scans.map + 1
		Stats.map_saturated_cells = (Stats.map_saturated_cells or 0) + saturated
		local nb = harvestBoards()
		log("mapa: +" .. added .. " pecas, +" .. nb .. " textos (total " .. Map.count .. ")" .. (qerr and (" | erro de consulta: " .. qerr) or ""))
	end)
	if not ok then log("mapa erro: " .. tostring(err)) end
	mapBusy = false
	refreshGui()
end


function Main.resume() Core.control.paused = false Core.info("continuando") end
function Main.cancel() Core.control.cancelled = true Core.control.paused = false Core.info("cancelamento pedido") end

return Main
end

Modules["ModelCollector"] = function(...)
-- ModelCollector: one record per Model with its direct parts measured relative to the model pivot (hierarchy preserved through parent ids).
-- Visual properties only: no mesh ids, texture ids, sounds, animations or scripts are read.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local M = {}

M.stack = {}          -- models currently open during a depth-first scan
M.recs = {}           -- model instance -> record under construction
M.truncated = {}      -- { id, path, parts_total, parts_recorded, parts_skipped }
M.noParts = {}
M.stats = { models = 0, full = 0, partial = 0, container = 0, no_parts = 0, parts = 0, skipped_parts = 0 }
M.limitHit = false
M.occ = {}             -- base key -> how many models with the same path+pivot were seen in this scan (siblings are NOT merged)

local Area -- resolved lazily (AreaCollector requires ModelCollector indirectly through GeometryCollector)

local function sequenceInfo(seq)
	if typeof(seq) == "NumberSequence" then
		local out = {}
		for _, k in ipairs(seq.Keypoints) do out[#out + 1] = { U.num(k.Time), U.num(k.Value), U.num(k.Envelope) } end
		return out
	elseif typeof(seq) == "ColorSequence" then
		local out = {}
		for _, k in ipairs(seq.Keypoints) do out[#out + 1] = { U.num(k.Time), U.c3(k.Value) } end
		return out
	elseif typeof(seq) == "NumberRange" then
		return { U.num(seq.Min), U.num(seq.Max) }
	end
	return nil
end

local EFFECT_PROPS = {
	ParticleEmitter = { "Enabled", "Rate", "Lifetime", "Speed", "SpreadAngle", "LightEmission", "LightInfluence", "Rotation", "RotSpeed", "Acceleration", "Drag", "EmissionDirection", "Shape", "ShapeStyle", "Size", "Color", "Transparency", "Squash" },
	Trail = { "Enabled", "Lifetime", "MinLength", "LightEmission", "Color", "Transparency", "WidthScale", "FaceCamera" },
	Beam = { "Enabled", "Width0", "Width1", "LightEmission", "Color", "Transparency", "Segments", "CurveSize0", "CurveSize1", "FaceCamera" },
	PointLight = { "Enabled", "Brightness", "Range", "Color", "Shadows" },
	SpotLight = { "Enabled", "Brightness", "Range", "Angle", "Color", "Face", "Shadows" },
	SurfaceLight = { "Enabled", "Brightness", "Range", "Angle", "Color", "Face", "Shadows" },
	Fire = { "Enabled", "Heat", "Size", "Color", "SecondaryColor" },
	Smoke = { "Enabled", "Opacity", "RiseVelocity", "Size", "Color" },
	Sparkles = { "Enabled", "SparkleColor" },
	ProximityPrompt = { "Enabled", "ObjectText", "ActionText", "HoldDuration", "MaxActivationDistance", "KeyboardKeyCode", "GamepadKeyCode", "RequiresLineOfSight", "Style", "UIOffset", "Exclusivity" },
	ClickDetector = { "MaxActivationDistance" },
	Decal = { "Face", "Transparency", "Color3", "ZIndex" },
	Texture = { "Face", "Transparency", "Color3", "StudsPerTileU", "StudsPerTileV", "OffsetStudsU", "OffsetStudsV" },
	SurfaceAppearance = { "AlphaMode", "Color" },
	Highlight = { "Enabled", "FillColor", "FillTransparency", "OutlineColor", "OutlineTransparency" },
}

local function encodeProp(v)
	local t = typeof(v)
	if t == "NumberSequence" or t == "ColorSequence" or t == "NumberRange" then return sequenceInfo(v) end
	return U.encodeValue(v)
end

local function guiTexts(gui)
	local texts = {}
	local ok, desc = pcall(function() return gui:GetDescendants() end)
	if not ok then return texts end
	for _, d in ipairs(desc) do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			local text = U.get(d, "Text")
			if type(text) == "string" and text ~= "" then texts[#texts + 1] = { class = d.ClassName, name = d.Name, text = text } end
		end
	end
	return texts
end

local function effectsOf(part)
	local list = {}
	local ok, kids = pcall(function() return part:GetChildren() end)
	if not ok then return list end
	for _, c in ipairs(kids) do
		local props = EFFECT_PROPS[c.ClassName]
		if props then
			local e = { class = c.ClassName, name = c.Name, props = {} }
			for _, p in ipairs(props) do
				local v = U.get(c, p)
				if v ~= nil then e.props[p] = encodeProp(v) end
			end
			e.attributes = U.attributes(c)
			list[#list + 1] = e
		elseif c:IsA("BillboardGui") or c:IsA("SurfaceGui") then
			list[#list + 1] = { class = c.ClassName, name = c.Name, props = { Enabled = U.get(c, "Enabled"), Size = U.encodeValue(U.get(c, "Size")), StudsOffset = U.encodeValue(U.get(c, "StudsOffset")), Face = U.encodeValue(U.get(c, "Face")) }, texts = guiTexts(c) }
		end
	end
	return list
end

local function partRecord(part, pivot, modelPath)
	local rel = nil
	if pivot then
		local ok, r = pcall(function() return pivot:ToObjectSpace(part.CFrame) end)
		if ok then rel = r end
	end
	local p = {
		name = part.Name, class = part.ClassName,
		path_in_model = (function()
			local full = U.path(part)
			if modelPath and full:sub(1, #modelPath) == modelPath then return full:sub(#modelPath + 2) end
			return full
		end)(),
		cf_abs = U.cf(part.CFrame), cf_rel = rel and U.cf(rel) or nil, size = U.v3(part.Size),
		color = U.c3(part.Color), material = U.enumName(part.Material), material_variant = U.get(part, "MaterialVariant"),
		transparency = U.num(part.Transparency), reflectance = U.num(U.get(part, "Reflectance")),
		anchored = U.get(part, "Anchored"), can_collide = U.get(part, "CanCollide"), can_touch = U.get(part, "CanTouch"), can_query = U.get(part, "CanQuery"),
		massless = U.get(part, "Massless"), cast_shadow = U.get(part, "CastShadow"), collision_group = U.get(part, "CollisionGroup"),
		attributes = U.attributes(part), tags = U.tags(part),
	}
	if part:IsA("Part") then p.shape = U.enumName(part.Shape) end
	if part:IsA("MeshPart") then
		-- metadata only: the mesh and texture ids are deliberately NOT read
		local texture = U.get(part, "TextureID")
		p.mesh = { mesh_size = U.v3(U.get(part, "MeshSize")), render_fidelity = U.enumName(U.get(part, "RenderFidelity")), double_sided = U.get(part, "DoubleSided"), has_texture = (type(texture) == "string" and texture ~= "") }
	end
	if part:IsA("WedgePart") or part:IsA("CornerWedgePart") then p.shape = part.ClassName end
	local fx = effectsOf(part)
	if #fx > 0 then p.children_effects = fx end
	return p
end

local function dirFor(ctx)
	return ctx.dir .. "/models"
end

local function buildRecord(model, ctx)
	local okp, pivot = pcall(function() return model:GetPivot() end)
	local path = U.path(model)
	local posKey = ""
	if okp then
		local p = pivot.Position
		posKey = string.format("%.1f,%.1f,%.1f", p.X, p.Y, p.Z)
	end
	local category, source = U.classify(model.Name, path)
	local baseKey = path .. "|" .. posKey
	M.occ[baseKey] = (M.occ[baseKey] or 0) + 1
	if M.occ[baseKey] > 1 then baseKey = baseKey .. "#" .. M.occ[baseKey] end
	local rec = {
		id = U.stableId("model", baseKey), name = model.Name, class = model.ClassName, path = path,
		parent = model.Parent and model.Parent.Name or nil, parent_class = model.Parent and model.Parent.ClassName or nil,
		world = ctx.world, area = ctx.area, zone = ctx.zone, category = category, category_source = source,
		attributes = U.attributes(model), tags = U.tags(model),
		pivot = okp and U.cf(pivot) or "unknown", parts = {}, parts_direct = 0, parts_skipped = 0, child_models = 0, effects_count = 0,
	}
	local primary = U.get(model, "PrimaryPart")
	rec.primary_part = primary and primary.Name or nil
	local okb, bbCf, bbSize = pcall(function()
		local cf, size = model:GetBoundingBox()
		return cf, size
	end)
	if okb and bbCf then
		rec.bbox = { center = U.v3(bbCf.Position), size = U.v3(bbSize), center_rel_to_pivot = okp and U.v3(pivot:PointToObjectSpace(bbCf.Position)) or nil }
	else
		rec.bbox = "unknown"
	end
	rec._pivot = okp and pivot or nil
	return rec
end

local function finalize(rec, ctx)
	rec._pivot = nil
	local status
	if rec.parts_direct == 0 and rec.child_models == 0 then
		status = "no_parts"
		rec.pivot = "unknown"
		rec.bbox = "unknown"
		rec.position_note = "model has no loaded parts (not streamed in or truly empty): its position is unknown, not (0,0,0)"
		M.stats.no_parts = M.stats.no_parts + 1
		M.noParts[#M.noParts + 1] = { id = rec.id, path = rec.path }
	elseif rec.parts_direct == 0 then
		status = "container"
		M.stats.container = M.stats.container + 1
	elseif rec.parts_skipped > 0 then
		status = "partial"
		M.stats.partial = M.stats.partial + 1
		M.truncated[#M.truncated + 1] = { id = rec.id, path = rec.path, parts_total = rec.parts_direct, parts_recorded = #rec.parts, parts_skipped = rec.parts_skipped }
	else
		status = "full"
		M.stats.full = M.stats.full + 1
	end
	rec.measured_status = status
	rec.parts_recorded = #rec.parts
	M.stats.models = M.stats.models + 1
	local added = Store.add("models", rec, dirFor(ctx))
	if added then
		local row = { id = rec.id, name = rec.name, path = rec.path, category = rec.category, world = rec.world, area = rec.area, zone = rec.zone, status = status,
			pos = rec.pivot ~= "unknown" and rec.pivot.pos or nil, size = (rec.bbox ~= "unknown") and rec.bbox.size or nil, bbox_center = (rec.bbox ~= "unknown") and rec.bbox.center or nil,
			attributes = rec.attributes, parts = #rec.parts, gui_texts = nil }
		-- texts shown above objects (prices, names) are kept in the summary row for the catalog builders
		local texts = {}
		for _, part in ipairs(rec.parts) do
			if part.children_effects then
				for _, fx in ipairs(part.children_effects) do
					if fx.texts then for _, t in ipairs(fx.texts) do texts[#texts + 1] = t.text end end
					if fx.class == "ProximityPrompt" then row.prompt = { object = fx.props.ObjectText, action = fx.props.ActionText } end
				end
			end
		end
		if #texts > 0 then row.gui_texts = texts end
		Store.summary("models", row)
		Area = Area or R("AreaCollector")
		Area.addObject(row, ctx)
	end
end

function M.reset()
	M.stack, M.recs = {}, {}
	M.truncated, M.noParts = {}, {}
	M.stats = { models = 0, full = 0, partial = 0, container = 0, no_parts = 0, parts = 0, skipped_parts = 0 }
	M.limitHit = false
	M.occ = {}
end

-- close every open model that does not contain `inst`
local function closeUntil(inst)
	while #M.stack > 0 do
		local top = M.stack[#M.stack]
		local inside = false
		if inst then
			local ok, v = pcall(function() return inst:IsDescendantOf(top.model) end)
			inside = ok and v
		end
		if inside then return end
		M.stack[#M.stack] = nil
		M.recs[top.model] = nil
		finalize(top.rec, top.ctx)
	end
end

function M.closeFor(inst) closeUntil(inst) end

function M.visit(d, ctx)
	closeUntil(d)
	if d:IsA("Model") then
		local ok, rec = pcall(buildRecord, d, ctx)
		if ok then
			local top = M.stack[#M.stack]
			if top then top.rec.child_models = top.rec.child_models + 1 end
			rec.parent_model_id = top and top.rec.id or nil
			local entry = { model = d, rec = rec, ctx = ctx }
			M.stack[#M.stack + 1] = entry
			M.recs[d] = entry
		else
			Core.warn("modelo nao medido: " .. U.path(d) .. " (" .. tostring(rec) .. ")")
			Store.bump("model_errors")
		end
		return "model"
	end
	return nil
end

-- attaches a BasePart to its nearest open model; returns true when a model owned it (otherwise it is a loose part)
function M.addPart(part, ctx)
	local top = M.stack[#M.stack]
	if not top then return false end
	local ok, inside = pcall(function() return part:IsDescendantOf(top.model) end)
	if not ok or not inside then return false end
	-- the nearest model must be `top` (open models are strictly nested)
	local rec = top.rec
	rec.parts_direct = rec.parts_direct + 1
	M.stats.parts = M.stats.parts + 1
	if #rec.parts >= Core.Config.MaxPartsPerModel then
		rec.parts_skipped = rec.parts_skipped + 1
		M.stats.skipped_parts = M.stats.skipped_parts + 1
		return true
	end
	local okr, pr = pcall(partRecord, part, rec._pivot, rec.path)
	if okr then
		rec.parts[#rec.parts + 1] = pr
		if pr.children_effects then rec.effects_count = rec.effects_count + #pr.children_effects end
	else
		rec.parts_skipped = rec.parts_skipped + 1
		Store.bump("part_errors")
	end
	return true
end

function M.finish()
	closeUntil(nil)
end

-- a standalone part (not inside any model): recorded as a loose part
function M.looseRecord(part, ctx)
	local path = U.path(part)
	local p = partRecord(part, nil, nil)
	local key = "part|" .. path .. "|" .. string.format("%.1f,%.1f,%.1f", part.Position.X, part.Position.Y, part.Position.Z)
	M.occ[key] = (M.occ[key] or 0) + 1
	if M.occ[key] > 1 then key = key .. "#" .. M.occ[key] end
	p.id = U.stableId("part", key)
	p.path = path
	p.parent = part.Parent and part.Parent.Name or nil
	p.world, p.area, p.zone = ctx.world, ctx.area, ctx.zone
	p.category, p.category_source = U.classify(part.Name, path)
	return p
end

return M

end


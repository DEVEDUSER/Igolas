function Store.reset()
	Store.lists, Store.index, Store.ids, Store.dropped = {}, {}, {}, {}
	for _, c in ipairs(DATA_CATS) do
		Store.lists[c] = {}
		Store.index[c] = {}
		Store.ids[c] = 0
		Store.dropped[c] = 0
	end
	Store.byInstance = setmetatable({}, { __mode = "k" })
	Store.seen = setmetatable({}, { __mode = "k" })
	Store.aux = setmetatable({}, { __mode = "k" })
	Store.notes = {}
	Store.noteOrder = {}
	Store.noiseCounts = {}
end
Store.reset()

function Store.note(key, text)
	if not Store.notes[key] then
		Store.notes[key] = text
		Store.noteOrder[#Store.noteOrder + 1] = key
	end
end

function Store.upsert(cat, key, name, props, source, conf)
	local idx = Store.index[cat]
	local rec = idx[key]
	if rec then
		local p = rec.properties
		for k, v in pairs(props) do
			if v ~= nil then
				if not (v == NO and p[k] ~= nil and p[k] ~= NO) then p[k] = v end
			end
		end
		rec.last_updated_unix = os.time()
		if conf and CONF_RANK[conf] > (CONF_RANK[rec.confidence] or 0) then rec.confidence = conf end
		return rec, false
	end
	local list = Store.lists[cat]
	if #list >= (CONFIG.MAX_RECORDS[cat] or 2000) then
		Store.dropped[cat] = Store.dropped[cat] + 1
		return nil, false
	end
	local n = Store.ids[cat] + 1
	Store.ids[cat] = n
	rec = {
		id = string.format("%s_%05d", PREFIX[cat], n),
		name = trunc(tostring(name)),
		category = cat,
		properties = props,
		source = source,
		collected_at = Util.iso(),
		collected_at_unix = os.time(),
		last_updated_unix = os.time(),
		confidence = conf or "medium",
	}
	list[#list + 1] = rec
	idx[key] = rec
	if typeof(key) == "Instance" then
		local b = Store.byInstance[key]
		if not b then b = {}; Store.byInstance[key] = b end
		b[cat] = rec
	end
	return rec, true
end

function Store.add(cat, rec) -- append-only (events)
	local list = Store.lists[cat]
	if #list >= (CONFIG.MAX_RECORDS[cat] or 2000) then
		Store.dropped[cat] = Store.dropped[cat] + 1
		return nil
	end
	list[#list + 1] = rec
	return rec
end

function Store.total()
	local n = 0
	for _, c in ipairs(DATA_CATS) do n = n + #Store.lists[c] end
	return n
end
function Store.filled()
	local n = 0
	for _, c in ipairs(DATA_CATS) do
		if #Store.lists[c] > 0 then n = n + 1 end
	end
	return n
end


local function textEconomyFacts(inst, text)
	if #text == 0 or #text > 90 or not text:find("%d") then return nil end
	local tok, names = ancestorTokens(inst, 3)
	local low = text:lower()
	local ctxCur = hit(tok, KW.currency)
	local word = hasCurrencyWord(low)
	local isPrice = text:find("%$") ~= nil or hit(tok, KW.price) ~= nil
	local mult = text:match("%f[%a][xX]%s*(%d[%d%.,]*)") or text:match("(%d[%d%.,]*)%s*[xX]%f[%A]")
	if not (ctxCur or word or isPrice or (mult and hit(tok, KW.mult))) then return nil end
	local kind = (mult and hit(tok, KW.mult)) and "multiplier_text" or (isPrice and "price_text" or "currency_text")
	return {
		kind = kind, text = trunc(text), parsed_number = parseNumber(text) or NO,
		multiplier = mult and tonumber((mult:gsub(",", ""))) or NO,
		currency_hint = word or ctxCur or NO, path = path(inst), ui_context = L(names),
	}
end

function Economy.onText(inst, text)
	local P = textEconomyFacts(inst, text)
	if P then Store.upsert("economy", inst, inst.Name, P, "gui_text:" .. P.path, "medium") end
end

-- Attribute records are capped per attribute NAME (60 instances) so one attribute repeated on thousands of
-- copies (e.g. "Currency" on every box mesh) cannot flood the category. Skipped copies are still summarized
-- (distinct values + counts) and exported inside `limitations`.
local ATTR_QUOTA = 60
local function newAttrTracker() return { keyCount = {}, keySkipped = {}, values = {}, seenKey = {} } end
Economy.tr, Progression.tr = newAttrTracker(), newAttrTracker()
local function attrAllowed(tr, key, k, v)
	local prev = tr.seenKey[key]
	if prev ~= nil then return prev end
	local vs = tr.values[k]
	if not vs then vs = { n = 0, d = {} }; tr.values[k] = vs end
	local sv = tostring(v)
	if vs.d[sv] ~= nil then vs.d[sv] = vs.d[sv] + 1 elseif vs.n < 40 then vs.n = vs.n + 1; vs.d[sv] = 1 end
	local c = (tr.keyCount[k] or 0) + 1
	tr.keyCount[k] = c
	local ok = c <= ATTR_QUOTA
	if not ok then tr.keySkipped[k] = (tr.keySkipped[k] or 0) + 1 end
	tr.seenKey[key] = ok
	return ok
end


--[[
  ReferenceMeasurer.lua  -  MEASURES (does not copy) the interface and the models you can see in a Roblox place.
  Writes JSON files to the workspace folder "UnboxingMeasure/".
  Saves numbers only: UI position/size/colours/corner/stroke/gradient/layout/text/font, and for models the bounding box and
  per part position/rotation/size/colour/material/shape. NEVER saves scripts, asset ids (images, meshes, textures, sounds) or animations.
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local OUT = "UnboxingMeasure"
local MAX_UI_NODES = 12000
local MAX_PARTS_PER_MODEL = 120
local MAX_MODELS = 400

local MODEL_NAME_PATTERNS = { "^Box%d+$", "^Gift%d+$", "^HalloweenBox$", "^HalloweenGift$", "^Static", "^Ghost", "^Egg", "^Stand$", "^Tree$", "^Fence$",
    "^Wall$", "^Barrel$", "^Banner$", "^Pumpkin$", "^DeadTree$", "^Building$", "^UFO$", "^Kelp$", "^Portal", "^Chest", "^TicketWheel$", "^Crab$" }
local MODEL_FOLDERS = { "Workspace.Worlds.World1.Lobby", "Workspace.Worlds.World1.Areas" }

local function r(n) return math.floor(n * 100 + 0.5) / 100 end
local function c3(c) if typeof(c) ~= "Color3" then return nil end return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) } end
local function ud(u) return { r(u.Scale), u.Offset } end
local function ud2(v) return { ud(v.X), ud(v.Y) } end
local function v3(v) return { r(v.X), r(v.Y), r(v.Z) } end
local function enumName(e) return e and tostring(e):match("%.([^%.]+)$") or nil end

if not (writefile and makefolder) then
    warn("This executor has no writefile/makefolder: cannot save.")
    return
end
if isfolder and not isfolder(OUT) then makefolder(OUT) end
local function save(name, data)
    writefile(OUT .. "/" .. name .. ".json", HttpService:JSONEncode(data))
end

-- ---------------------------------------------------------------- UI
local nodes = 0
local function dumpGui(inst, depth)
    nodes += 1
    if nodes > MAX_UI_NODES or depth > 14 then return nil end
    local n = { n = inst.Name, c = inst.ClassName }
    if inst:IsA("GuiObject") then
        n.vis = inst.Visible
        n.pos = ud2(inst.Position)
        n.size = ud2(inst.Size)
        n.anchor = { r(inst.AnchorPoint.X), r(inst.AnchorPoint.Y) }
        n.absPos = { r(inst.AbsolutePosition.X), r(inst.AbsolutePosition.Y) }
        n.absSize = { r(inst.AbsoluteSize.X), r(inst.AbsoluteSize.Y) }
        n.bg = c3(inst.BackgroundColor3)
        n.bgT = r(inst.BackgroundTransparency)
        n.z = inst.ZIndex
        n.order = inst.LayoutOrder
        if inst.ClipsDescendants then n.clip = true end
        if inst.Rotation ~= 0 then n.rot = r(inst.Rotation) end
    end
    if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
        n.text = inst.Text
        n.font = enumName(inst.Font)
        n.textSize = inst.TextSize
        n.textColor = c3(inst.TextColor3)
        n.textStrokeT = r(inst.TextStrokeTransparency)
        n.textStroke = c3(inst.TextStrokeColor3)
        n.scaled = inst.TextScaled or nil
        n.xAlign = enumName(inst.TextXAlignment)
        n.yAlign = enumName(inst.TextYAlignment)
        n.rich = inst.RichText or nil
    end
    if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
        n.hasImage = inst.Image ~= ""      -- the asset id itself is NOT saved
        n.imageColor = c3(inst.ImageColor3)
        n.imageT = r(inst.ImageTransparency)
        n.scaleType = enumName(inst.ScaleType)
        n.sliceCenter = (inst.ScaleType == Enum.ScaleType.Slice) and { inst.SliceCenter.Min.X, inst.SliceCenter.Min.Y, inst.SliceCenter.Max.X, inst.SliceCenter.Max.Y } or nil
    end
    if inst:IsA("ScrollingFrame") then
        n.canvas = ud2(inst.CanvasSize)
        n.scrollBar = inst.ScrollBarThickness
    end
    if inst:IsA("UICorner") then n.radius = ud(inst.CornerRadius) end
    if inst:IsA("UIStroke") then n.stroke = { c3(inst.Color), inst.Thickness, r(inst.Transparency), enumName(inst.ApplyStrokeMode) } end
    if inst:IsA("UIGradient") then
        local ks = {}
        for _, k in ipairs(inst.Color.Keypoints) do table.insert(ks, { r(k.Time), c3(k.Value) }) end
        n.gradient = { ks, r(inst.Rotation) }
    end
    if inst:IsA("UIListLayout") then n.list = { enumName(inst.FillDirection), ud(inst.Padding), enumName(inst.HorizontalAlignment), enumName(inst.VerticalAlignment), enumName(inst.SortOrder) } end
    if inst:IsA("UIGridLayout") then n.grid = { ud2(inst.CellSize), ud2(inst.CellPadding), enumName(inst.FillDirection) } end
    if inst:IsA("UIPadding") then n.padding = { ud(inst.PaddingTop), ud(inst.PaddingBottom), ud(inst.PaddingLeft), ud(inst.PaddingRight) } end
    if inst:IsA("UIAspectRatioConstraint") then n.aspect = r(inst.AspectRatio) end
    if inst:IsA("UISizeConstraint") then n.sizeLimit = { v3(Vector3.new(inst.MinSize.X, inst.MinSize.Y, 0)), v3(Vector3.new(inst.MaxSize.X, inst.MaxSize.Y, 0)) } end
    if inst:IsA("UIScale") then n.scale = r(inst.Scale) end
    local kids = {}
    for _, child in ipairs(inst:GetChildren()) do
        if child:IsA("GuiBase2d") or child:IsA("UIBase") or child:IsA("LayerCollector") then
            local k = dumpGui(child, depth + 1)
            if k then table.insert(kids, k) end
        end
    end
    if #kids > 0 then n.k = kids end
    return n
end

local camera = Workspace.CurrentCamera
local meta = { viewport = camera and { camera.ViewportSize.X, camera.ViewportSize.Y } or nil, touch = game:GetService("UserInputService").TouchEnabled }
save("meta", meta)

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
for _, gui in ipairs(playerGui:GetChildren()) do
    if gui:IsA("ScreenGui") then
        nodes = 0
        local ok, tree = pcall(dumpGui, gui, 0)
        if ok and tree then save("ui_" .. gui.Name:gsub("[^%w]", "_"), tree) end
    end
end
local uiTemplates = ReplicatedStorage:FindFirstChild("UI")
if uiTemplates then
    for _, child in ipairs(uiTemplates:GetChildren()) do
        nodes = 0
        local ok, tree = pcall(dumpGui, child, 0)
        if ok and tree then save("uitemplate_" .. child.Name:gsub("[^%w]", "_"), tree) end
    end
end

-- ---------------------------------------------------------------- models
local function dumpModel(m)
    local parts = {}
    for _, d in ipairs(m:GetDescendants()) do
        if d:IsA("BasePart") then table.insert(parts, d) end
    end
    if #parts == 0 then return nil end
    local pivot = m:IsA("BasePart") and m.CFrame or m:GetPivot()
    local box, size = m:GetBoundingBox()
    local out = { n = m.Name, c = m.ClassName, path = m:GetFullName(), box = { v3(pivot:PointToObjectSpace(box.Position)), v3(size) }, count = #parts, parts = {} }
    table.sort(parts, function(a, b) return a.Size.X * a.Size.Y * a.Size.Z > b.Size.X * b.Size.Y * b.Size.Z end)
    for i = 1, math.min(#parts, MAX_PARTS_PER_MODEL) do
        local p = parts[i]
        local rel = pivot:ToObjectSpace(p.CFrame)
        local rx, ry, rz = rel:ToOrientation()
        table.insert(out.parts, {
            n = p.Name, c = p.ClassName, pos = v3(rel.Position), rot = { r(math.deg(rx)), r(math.deg(ry)), r(math.deg(rz)) }, size = v3(p.Size),
            color = c3(p.Color), mat = enumName(p.Material), t = r(p.Transparency), shape = p:IsA("Part") and enumName(p.Shape) or nil,
            mesh = p:IsA("MeshPart") or nil, -- only "this is a mesh part"; the mesh id is NOT saved
        })
    end
    return out
end

local found, seenModels = {}, {}
local function consider(inst)
    if #found >= MAX_MODELS or seenModels[inst] then return end
    if inst:IsA("Model") or inst:IsA("BasePart") or inst:IsA("Folder") then
        seenModels[inst] = true
        local ok, data = pcall(dumpModel, inst)
        if ok and data then table.insert(found, data) end
    end
end
for _, root in ipairs({ ReplicatedStorage, Workspace }) do
    for _, d in ipairs(root:GetDescendants()) do
        for _, pat in ipairs(MODEL_NAME_PATTERNS) do
            if string.match(d.Name, pat) and (d:IsA("Model") or d:IsA("BasePart")) then consider(d) break end
        end
        if #found >= MAX_MODELS then break end
    end
end
for _, path in ipairs(MODEL_FOLDERS) do
    local node = game
    for part in string.gmatch(path, "[^%.]+") do node = node and node:FindFirstChild(part) end
    if node then
        for _, child in ipairs(node:GetChildren()) do consider(child) end
    end
end
for i = 1, #found, 40 do
    local chunk = {}
    for j = i, math.min(i + 39, #found) do table.insert(chunk, found[j]) end
    save(string.format("models_%02d", (i - 1) // 40 + 1), chunk)
end
print(string.format("DONE: UI trees saved, %d models measured. Zip the folder workspace/%s and send it.", #found, OUT))

local function trackCrateReward(value)
    if type(value) == "string" then
        local lowered = string.lower(value)

        if lowered:find("eggrain") or lowered:find("egg rain") then
            Stats.eggRainGained += 1
        end

        if lowered:find("bombrain") or lowered:find("bomb rain") or lowered:find("bomb%-rain") then
            Stats.bombRainGained += 1
        end

        if lowered:find("ticket") then
            Stats.ticketsGained += 1
        end
    elseif type(value) == "table" then
        for k, v in pairs(value) do
            local key = tostring(k):lower()

            if key:find("ticket") and type(v) == "number" then
                Stats.ticketsGained += v
            end

            trackCrateReward(k)
            trackCrateReward(v)
        end
    end
end

local function openCrateAndTrack(crateId, amount)
    amount = tonumber(amount) or 1

    local ok, result = pcall(function()
        return RF.OpenCrate:InvokeServer(crateId, amount)
    end)

    if ok then
        Stats.cratesOpened += amount
        Stats.cratesByName[crateId] = (Stats.cratesByName[crateId] or 0) + amount
        trackCrateReward(result)
    end

    return ok, result
end

local function getNearestWheelId()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local nearestId
    local nearestDist = math.huge

    for _, inst in ipairs(workspace:GetDescendants()) do
        local ok, wheelId = pcall(function()
            return inst:GetAttribute("WheelId")
        end)

        if ok and wheelId then
            local pos

            if inst:IsA("BasePart") then
                pos = inst.Position
            elseif inst:IsA("Model") then
                pos = inst:GetPivot().Position
            end

            if pos then
                local dist = root and (pos - root.Position).Magnitude or 0

                if dist < nearestDist then
                    nearestDist = dist
                    nearestId = wheelId
                end
            end
        end
    end

    return nearestId
end


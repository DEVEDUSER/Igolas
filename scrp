Modules["CollectionReport"] = function(...)
-- CollectionReport: coverage statuses, missing-data list, truncation / duplicate / unobserved-region reports, manifest and the final export.
-- Statuses: NOT_SCANNED, PARTIALLY_SCANNED, OBSERVED, VALIDATED, UNKNOWN, UNAVAILABLE. Coverage is NEVER reported as 100% while gaps exist.
local Core, R = ...
local U = R("Util")
local Store = R("Store")
local Exporter = R("DataExporter")
local Rep = {}

Rep.truncatedAll = {}
Rep.noPartsAll = {}
Rep.scans = {}
local seenT, seenN = {}, {}

-- called after every scan: the ModelCollector lists are reset on each scan, so they are accumulated here
function Rep.accumulate(summary)
	local M = R("ModelCollector")
	for _, t in ipairs(M.truncated) do
		if not seenT[t.id] then
			seenT[t.id] = true
			Rep.truncatedAll[#Rep.truncatedAll + 1] = t
		end
	end
	for _, t in ipairs(M.noParts) do
		if not seenN[t.id] then
			seenN[t.id] = true
			Rep.noPartsAll[#Rep.noPartsAll + 1] = t
		end
	end
	if summary then Rep.scans[#Rep.scans + 1] = summary end
end

local CATALOGS = { "shops", "weapons", "boxes", "pets", "eggs", "chests_machines" }

local function catalogStatus(name)
	local C = R("CatalogCommon")
	local r = C.results[name]
	if not r then return "NOT_SCANNED", { "ainda nao medido nesta sessao" } end
	if r.total == 0 then return "UNKNOWN", r.missing end
	if #r.missing > 0 then return "PARTIALLY_SCANNED", r.missing end
	return "OBSERVED", {}
end

local function coverage()
	local G = R("GeometryCollector")
	local observed, partial, total = 0, 0, 0
	for _, c in pairs(Store.cells) do
		total = total + 1
		if c.status == "OBSERVED" then observed = observed + 1 elseif c.status == "PARTIALLY_SCANNED" then partial = partial + 1 end
	end
	local gaps = G.unobservedCells()
	local known = observed + partial + #gaps
	local pct = known > 0 and (observed * 100 / known) or 0
	local gapsExist = (partial > 0 or #gaps > 0)
	if gapsExist and pct >= 100 then pct = 99.9 end
	if pct > 99.9 and gapsExist then pct = 99.9 end
	return {
		cell_size_studs = Core.Config.CellSize, cells_touched = total, observed = observed, partially_scanned = partial, known_but_not_observed = #gaps,
		coverage_percent_of_known_universe = U.num(pct), gaps_exist = gapsExist,
		basis = "percent is relative to the cells the client has seen or that fall inside measured area boxes; the true extent of the game is unknown to the client, so this is NOT a percentage of the whole game",
	}, gaps
end

function Rep.categories()
	local out = {}
	local V = R("DataValidator")
	local function put(name, status, notes, validKind)
		if status == "OBSERVED" and validKind and V.validatedKinds[validKind] then status = "VALIDATED" end
		out[#out + 1] = { category = name, status = status, notes = notes or {} }
	end
	local cov = coverage()
	local streaming = false
	pcall(function() streaming = Core.Workspace.StreamingEnabled end)
	local geoStatus = "NOT_SCANNED"
	local geoNotes = {}
	if #Rep.scans > 0 then
		geoStatus = "OBSERVED"
		if cov.gaps_exist then geoStatus = "PARTIALLY_SCANNED" geoNotes[#geoNotes + 1] = "ha celulas parciais / nao observadas" end
		if streaming then geoStatus = "PARTIALLY_SCANNED" geoNotes[#geoNotes + 1] = "streaming ligado: so o que estava carregado foi medido" end
		if #Rep.truncatedAll > 0 then geoStatus = "PARTIALLY_SCANNED" geoNotes[#geoNotes + 1] = #Rep.truncatedAll .. " modelos truncados" end
	end
	put("geometry_and_models", geoStatus, geoNotes, "models")
	for _, name in ipairs(CATALOGS) do
		local st, notes = catalogStatus(name)
		put("catalog_" .. name, st, notes, "catalog_" .. name)
	end
	local UI = R("UICollector")
	local pri = UI.priorityStatus()
	local seen, missing = 0, {}
	for _, p in ipairs(pri) do
		if p.status == "OBSERVED" then seen = seen + 1 else missing[#missing + 1] = "menu '" .. p.menu .. "' nao medido" end
	end
	local uiSt = #UI.snapshots == 0 and "NOT_SCANNED" or (seen == #pri and "OBSERVED" or "PARTIALLY_SCANNED")
	put("ui", uiSt, missing, "ui_snapshot")
	local L = R("LightingCollector")
	local A = R("AreaCollector")
	local areaCount = 0
	for _, s in pairs(A.stats) do if s.zone == "area" then areaCount = areaCount + 1 end end
	local lightSt = #L.labels == 0 and "NOT_SCANNED" or ((areaCount > 0 and #L.labels >= areaCount) and "OBSERVED" or "PARTIALLY_SCANNED")
	put("lighting", lightSt, { #L.labels .. " capturas de iluminacao; areas medidas: " .. areaCount }, "lighting")
	local E = R("EconomyObserver")
	local changes = 0
	for _, s in pairs(E.series) do changes = changes + s.changes end
	put("economy", U.shallowCount(E.series) == 0 and "NOT_SCANNED" or (changes > 0 and "OBSERVED" or "PARTIALLY_SCANNED"), { U.shallowCount(E.series) .. " series, " .. changes .. " mudancas observadas" }, "economy")
	local D = R("DamageObserver")
	put("damage", #D.sessions == 0 and "NOT_SCANNED" or ((D.sessions[1].decreases or 0) > 0 and "OBSERVED" or "PARTIALLY_SCANNED"), { #D.sessions .. " sessoes manuais" }, "damage_session")
	local P = R("ProgressionObserver")
	put("progression", (#P.transitions == 0 and #P.gateTexts() == 0) and "NOT_SCANNED" or "PARTIALLY_SCANNED", { #P.transitions .. " transicoes de area, " .. #P.gateTexts() .. " textos de requisito" }, "progression")
	local An = R("AnimationObserver")
	put("animations_effects", (U.shallowCount(An.tracks) + U.shallowCount(An.effects)) == 0 and "NOT_SCANNED" or "PARTIALLY_SCANNED", { U.shallowCount(An.tracks) .. " animacoes (so do jogador local), " .. U.shallowCount(An.effects) .. " efeitos" }, "animations")
	local I = R("InteractionObserver")
	put("events", #I.events == 0 and "NOT_SCANNED" or "OBSERVED", { #I.events .. " eventos registrados" }, "events")
	local byDesign = { "scripts do jogo", "meshes / texturas / ids de imagem", "arquivos de animacao", "audio", "servidor (regras reais de drop, dano, preco)" }
	for _, name in ipairs(byDesign) do put("unavailable_by_design:" .. name, "UNAVAILABLE", { "nao e lido nem copiado por este coletor" }) end
	return out
end

local function worldStatus()
	local W = R("WorldCollector")
	local A = R("AreaCollector")
	W.identify()
	local out = {}
	for name, info in pairs(W.worlds) do
		local w = { world = name, areas = {}, lobby = info.lobby_present }
		for _, a in ipairs(info.areas) do
			local s = A.stats[name .. "/" .. a.name]
			local status = "NOT_SCANNED"
			local why = "area existe no cliente mas nenhuma peca foi medida (fora do raio de streaming ou nao varrida)"
			if s and s.parts > 0 then
				status = "OBSERVED"
				why = nil
				if s.min[1] ~= math.huge then
					local size = Core.Config.CellSize
					for cx = math.floor(s.min[1] / size), math.floor(s.max[1] / size) do
						for cz = math.floor(s.min[3] / size), math.floor(s.max[3] / size) do
							local c = Store.cells[cx .. "," .. cz]
							if not c or c.status ~= "OBSERVED" then status = "PARTIALLY_SCANNED" why = "parte das celulas da area nao foi observada" end
						end
					end
				end
			end
			w.areas[#w.areas + 1] = { area = a.name, index = a.index, status = status, parts = s and s.parts or 0, models = s and s.models or 0, notes = why }
		end
		out[#out + 1] = w
	end
	table.sort(out, function(a, b) return a.world < b.world end)
	return out
end

function Rep.missing(cats, gaps)
	local list = {}
	local function add(category, what, why, how)
		list[#list + 1] = { category = category, what = what, why = why, how_to_obtain = how }
	end
	for _, c in ipairs(cats) do
		if c.status == "NOT_SCANNED" or c.status == "PARTIALLY_SCANNED" or c.status == "UNKNOWN" then
			if #c.notes == 0 then add(c.category, c.status, "sem detalhes", "execute a operacao correspondente") end
			for _, n in ipairs(c.notes) do add(c.category, c.status, n, "abra o menu / visite a area e repita a operacao") end
		end
	end
	for _, w in ipairs(worldStatus()) do
		for _, a in ipairs(w.areas) do
			if a.status ~= "OBSERVED" then add("area:" .. w.world .. "/" .. a.area, a.status, a.notes, "va ate a area e use MAPEAR AREA ATUAL") end
		end
	end
	if not Exporter.FS.canWrite() then add("storage", "UNAVAILABLE", "executor sem writefile", "use EXPORTAR -> copiar para a area de transferencia") end
	if #gaps > 0 then add("map_cells", "NOT_SCANNED", #gaps .. " celulas dentro de areas medidas nunca foram observadas", "consulte Reports/unobserved_regions.json") end
	return list
end

-- writes everything. Returns a summary table.
function Rep.exportAll()
	local Session = R("SessionManager")
	local V = R("DataValidator")
	-- 1 observer files
	local function try(name, fn) local ok, e = pcall(fn) if not ok then Core.warn(name .. ": " .. tostring(e)) end end
	try("eventos", function() R("InteractionObserver").write() end)
	try("economia", function() R("EconomyObserver").write() end)
	try("progressao", function() R("ProgressionObserver").write() end)
	try("animacoes", function() R("AnimationObserver").write() end)
	try("menus", function() R("UICollector").writeMenuLog() end)
	try("ovos", function() R("EggCollector").sampled() end)
	-- 2 pending records
	Exporter.flush()
	Session.saveState()
	-- 3 validation of what exists so far
	local validation = V.run()
	-- 4 reports
	local cats = Rep.categories()
	local cov, gaps = coverage()
	local missing = Rep.missing(cats, gaps)
	local dupRows, dupTotal = {}, 0
	for cat, n in pairs(Store.dups) do dupRows[#dupRows + 1] = { category = cat, skipped_this_session = n, restored_from_previous = Store.restored[cat] or 0 } dupTotal = dupTotal + n end
	local head = { collector_version = Core.Config.Version, session = Exporter.session, generated_at = U.nowIso() }
	local function put(rel, doc, kind)
		for k, v in pairs(head) do doc[k] = doc[k] or v end
		Exporter.writeJson(rel, doc, { versioned = true, kind = kind })
	end
	put("Reports/missing_data.json", { count = #missing, items = missing }, "report_missing")
	put("Reports/truncated_objects.json", { count = #Rep.truncatedAll, max_parts_per_model = Core.Config.MaxPartsPerModel, items = Rep.truncatedAll, note = "pecas alem do limite foram CONTADAS aqui, nunca descartadas em silencio" }, "report_truncated")
	put("Reports/unobserved_regions.json", { count = #gaps, cell_size_studs = Core.Config.CellSize, cells = gaps }, "report_unobserved")
	local noPartsListed = {}
	for i = 1, math.min(200, #Rep.noPartsAll) do noPartsListed[i] = Rep.noPartsAll[i] end
	put("Reports/duplicates.json", { duplicates_skipped = dupTotal, by_category = dupRows, models_without_parts_total = #Rep.noPartsAll, models_without_parts_listed = #noPartsListed, models_without_parts_omitted = #Rep.noPartsAll - #noPartsListed, models_without_parts = noPartsListed, note = "models without loaded parts are recorded in the models files with measured_status = no_parts; the list here is capped and the omitted count is explicit" }, "report_duplicates")
	local statusDoc = { categories = cats, worlds = worldStatus(), coverage = cov, never_100_percent_rule = "coverage is capped below 100 while any gap exists" }
	put("collection_status.json", statusDoc, "status")
	local counts = {}
	for cat, n in pairs(Store.counts) do counts[cat] = n end
	local report = {
		summary = { records_added_this_session = counts, duplicates_skipped = dupTotal, truncated_models = #Rep.truncatedAll, models_without_parts = #Rep.noPartsAll, scans = #Rep.scans,
			validation = { failures = validation.failures, warnings = validation.warnings, passed_overall = validation.passed_overall }, coverage = cov, missing_items = #missing, scan_errors = Store.stats.scan_errors or 0 },
		scans = Rep.scans, stats = Store.stats,
		honesty = { "values not observed are 'unknown' or absent; nothing was estimated unless it is under an 'estimated' key", "the game's server rules (real drop rates, damage formulas, prices) cannot be read from the client" },
	}
	put("collection_report.json", report, "report")
	put("session_info.json", Session.info(), "session_info")
	-- 5 manifest (merged with the one from earlier sessions)
	local rel = "manifest.json"
	local old = nil
	local text = Exporter.FS.read(Core.Config.Root .. "/" .. rel)
	if text then
		local ok, doc = pcall(function() return Core.HttpService:JSONDecode(text) end)
		if ok then old = doc end
	end
	local files, seen = {}, {}
	if old and type(old.files) == "table" then
		for _, f in ipairs(old.files) do
			files[#files + 1] = f
			seen[f.path] = true
		end
	end
	for _, f in ipairs(Exporter.files) do
		local path = f.path
		if not seen[path] then
			seen[path] = true
			files[#files + 1] = { path = path, kind = f.kind, records = f.records, bytes = f.bytes, session = f.session, time = f.time, stored = f.stored }
		end
	end
	local sessions = (old and old.sessions) or {}
	local found = false
	for _, s in ipairs(sessions) do if s == Exporter.session then found = true end end
	if not found then sessions[#sessions + 1] = Exporter.session end
	Exporter.writeJson(rel, { collector_version = Core.Config.Version, updated_at = U.nowIso(), sessions = sessions, file_count = #files, files = files, root = Core.Config.Root }, { versioned = true, kind = "manifest" })
	local summary = { files_written_this_session = #Exporter.files, manifest_files = #files, stored_on_disk = Exporter.FS.canWrite(), validation_failures = validation.failures, missing_items = #missing, coverage = cov.coverage_percent_of_known_universe }
	if not Exporter.FS.canWrite() then
		Core.warn("sem writefile: nada foi gravado em disco. Use o botao COPIAR RELATORIO.")
	end
	Core.info(string.format("exportado: %d arquivos nesta sessao, %d no manifesto, %d falhas de validacao, %d itens faltando", #Exporter.files, #files, validation.failures, #missing))
	return summary
end

-- clipboard fallback (executors without writefile): the compact report as JSON text
function Rep.clipboardText()
	local cats = Rep.categories()
	local cov = coverage()
	local ok, json = pcall(function() return Core.HttpService:JSONEncode({ session = Exporter.session, categories = cats, coverage = cov, counts = Store.counts }) end)
	return ok and json or nil
end

Rep.worldStatus = worldStatus
Rep.coverage = coverage
return Rep

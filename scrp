Events.lim = {}
Events.limCount = 0
Events.muted = 0
Events.skipped = 0
-- Lifecycle events are cheap to produce and flood the 4000-event cap (boxes spawn/despawn constantly);
-- they get their own budgets so text/value/world changes keep room.
local EVENT_BUDGET = { object_added = 1200, object_removed = 1200, world_changed = 300 }
local DETAIL_KW = set({ "shop", "stat", "weapon", "pet", "egg", "index", "detail", "info", "upgrade", "rebirth", "inventory" })
Events.kindCount, Events.budgetSkipped = {}, {}
function Events.reset()
	Events.lim, Events.limCount, Events.muted, Events.skipped = {}, 0, 0, 0
	Events.kindCount, Events.budgetSkipped = {}, {}
end

function Events.push(kind, inst, rec, prop, old, new, extra)
	if not active() then
		Session.missed = Session.missed + 1
		return
	end
	local t = clock()
	local budget = EVENT_BUDGET[kind]
	if budget then
		local n = Events.kindCount[kind] or 0
		if n >= budget then
			Events.budgetSkipped[kind] = (Events.budgetSkipped[kind] or 0) + 1
			return
		end
		Events.kindCount[kind] = n + 1
	end
	if not (extra and extra.noLimit) then
		local key = kind .. ":" .. (inst and Util.uid(inst) or 0) .. ":" .. tostring(prop)
		local lim = Events.lim[key]
		local minInt = extra and extra.minInterval or CONFIG.EVENT_MIN_INTERVAL
		local maxPer = extra and extra.maxPerKey or CONFIG.EVENT_MAX_PER_KEY
		if lim then
			if lim.muted then return end
			if t - lim.t < minInt then
				Events.skipped = Events.skipped + 1
				return
			end
			lim.n = lim.n + 1
			if lim.n > maxPer then
				lim.muted = true
				Events.muted = Events.muted + 1
				return
			end
			lim.t = t
		else
			Events.limCount = Events.limCount + 1
			if Events.limCount > 5000 then Events.lim = {}; Events.limCount = 0 end
			Events.lim[key] = { t = t, n = 1 }
		end
	end
	local related = {}
	if inst then
		local b = Store.byInstance[inst]
		if b then
			for cat, r in pairs(b) do related[cat] = r.id end
		end
	end
	local n = Store.ids.observed_events + 1
	Store.ids.observed_events = n
	local P = {
		event = kind,
		target_id = rec and rec.id or NO,
		target_category = rec and rec.category or NO,
		target_name = rec and rec.name or (inst and inst.Name) or NO,
		target_path = inst and path(inst) or NO,
		property = prop ~= nil and tostring(prop) or NO,
		old_value = old ~= nil and plain(old) or NULL,
		new_value = new ~= nil and plain(new) or NULL,
		related_records = related,
		session_seconds = r2(t - Session.t0),
		world_hint = World.current or NO,
	}
	if extra then
		for k, v in pairs(extra) do
			if k ~= "noLimit" and k ~= "maxPerKey" and k ~= "minInterval" then P[k] = plain(v) end
		end
	end
	Store.add("observed_events", {
		id = string.format("%s_%05d", PREFIX.observed_events, n),
		name = kind,
		category = "observed_events",
		properties = P,
		source = "event:" .. kind,
		collected_at = Util.iso(),
		collected_at_unix = os.time(),
		last_updated_unix = os.time(),
		confidence = "high",
	})
end

Watch.conns = {}
Watch.count = 0
Watch.capHit = false

function Watch.add(inst, key, signal, fn)
	local bucket = Watch.conns[inst]
	if bucket and bucket[key] then return false end
	if Watch.count >= CONFIG.MAX_WATCHERS then
		Watch.capHit = true
		return false
	end
	local g = Session.gen
	local ok, c = pcall(function()
		return signal:Connect(function(...)
			if g ~= Session.gen or not Session.alive then return end
			local okc, err = pcall(fn, ...)
			if not okc then Log.errOnce("watch:" .. key, "watcher " .. key .. ": " .. tostring(err)) end
		end)
	end)
	if not ok then return false end
	if not bucket then bucket = {}; Watch.conns[inst] = bucket end
	bucket[key] = c
	Watch.count = Watch.count + 1
	return true
end

function Watch.drop(inst)
	local bucket = Watch.conns[inst]
	if not bucket then return end
	for _, c in pairs(bucket) do
		pcall(function() c:Disconnect() end)
		Watch.count = Watch.count - 1
	end
	Watch.conns[inst] = nil
end

function Watch.dropAll()
	for inst in pairs(Watch.conns) do Watch.drop(inst) end
	Watch.conns = {}
	Watch.count = 0
	Watch.capHit = false
end

local ITEM_CATS = { "worlds", "boxes", "weapons", "pets", "eggs" }

function Watch.ensureAttr(inst)
	Watch.add(inst, "attr", inst.AttributeChanged, function(name) Watch.onAttr(inst, name) end)
end

function Watch.ensureValue(inst)
	Watch.add(inst, "value", inst.Changed, function() Watch.onValue(inst) end)
end

-- Item category records react to attribute/value changes by re-reading the instance (read-only).
function Watch.itemChanged(inst, cat, rec, what, old, new)
	local oldHealth = rec.properties.health_current
	Items.refresh(inst, cat)
	if cat == "boxes" then Boxes.onChange(rec, oldHealth, what, old, new) end
	Events.push("property_changed", inst, rec, what, old, new)
end

function Watch.onAttr(inst, name)
	local okv, raw = pcall(inst.GetAttribute, inst, name)
	local newv = okv and plain(raw) or NULL
	local recs = Store.byInstance[inst]
	if recs then
		for _, cat in ipairs(ITEM_CATS) do
			local rec = recs[cat]
			if rec then
				local old = rec.properties.attributes and rec.properties.attributes[name]
				if old ~= newv then Watch.itemChanged(inst, cat, rec, "attribute:" .. name, old, newv) end
			end
		end
	end
	local key = "a:" .. Util.uid(inst) .. ":" .. name
	for _, cat in ipairs({ "economy", "progression" }) do
		local r = Store.index[cat][key]
		if r then
			local old = r.properties.value
			if old ~= newv then
				r.properties.value = newv
				local kind = hit(Tok.of(name), KW.world) and "world_changed" or "value_changed"
				Events.push(kind, inst, r, name, old, newv)
			end
		end
	end
	-- attribute may be new: let the economy/progression modules pick it up
	if okv then
		Economy.scanAttrs(inst, nil, name)
		Progression.scanAttrs(inst, nil, name)
	end
end

function Watch.onValue(inst)
	local recs = Store.byInstance[inst]
	if not recs then return end
	local newv = plain(get(inst, "Value"))
	for _, cat in ipairs({ "economy", "progression", "inventory" }) do
		local r = recs[cat]
		if r then
			local old = r.properties.value
			if old ~= newv then
				r.properties.value = newv
				local kind = hit(Tok.of(inst.Name), KW.world) and "world_changed" or (cat == "inventory" and "inventory_changed" or "value_changed")
				Events.push(kind, inst, r, "Value", old, newv)
			end
		end
	end
end

-- Item (3D) specific watchers: Humanoid health, ValueBase children, Transparency (box state).
function Watch.attachItem(inst, rec, cat)
	Watch.ensureAttr(inst)
	local ok, ch = pcall(inst.GetChildren, inst)
	if ok then
		local nv = 0
		for _, c in ipairs(ch) do
			if nv >= 15 then break end
			if c:IsA("ValueBase") then
				nv = nv + 1
				Watch.add(c, "ivalue", c.Changed, function()
					local old = rec.properties.value_children and rec.properties.value_children[c.Name]
					local new = plain(get(c, "Value"))
					if old ~= new then Watch.itemChanged(inst, cat, rec, "value_object:" .. c.Name, old, new) end
				end)
			elseif c:IsA("Humanoid") and cat == "boxes" then
				nv = nv + 1
				Watch.add(c, "hum", c.HealthChanged, function(h)
					Watch.itemChanged(inst, cat, rec, "Humanoid.Health", rec.properties.health_current, h)
				end)
			end
		end
	end
	if cat == "boxes" and inst:IsA("BasePart") then
		Watch.add(inst, "transp", inst:GetPropertyChangedSignal("Transparency"), function()
			Watch.itemChanged(inst, cat, rec, "Transparency", nil, get(inst, "Transparency"))
		end)
	end
end

-- UI watchers: text and visibility.
function Watch.ui(inst, rec, ctx)
	if ctx.isText then
		local t = get(inst, "Text")
		if type(t) == "string" and t:find("%d") then
			Watch.add(inst, "text", inst:GetPropertyChangedSignal("Text"), function() Watch.onText(inst, rec) end)
		end
	end
	if inst:IsA("LayerCollector") then
		Watch.add(inst, "vis", inst:GetPropertyChangedSignal("Enabled"), function()
			local v = get(inst, "Enabled")
			local old = rec.properties.enabled
			if old ~= v then
				rec.properties.enabled = v
				Events.push("ui_enabled_changed", inst, rec, "Enabled", old, v)
			end
		end)
	elseif ctx.isGuiObj and ctx.parent and (ctx.parent:IsA("LayerCollector") or (ctx.parent.Parent and ctx.parent.Parent:IsA("LayerCollector"))) then
		Watch.add(inst, "vis", inst:GetPropertyChangedSignal("Visible"), function()
			local v = get(inst, "Visible")
			local old = rec.properties.visible
			if old ~= v then
				rec.properties.visible = v
				rec.properties.effective_visible = Hooks.effectiveVisible(inst)
				Events.push("ui_visibility_changed", inst, rec, "Visible", old, v)
			end
		end)
	end
end

function Watch.onText(inst, rec)
	local t = get(inst, "Text")
	if type(t) ~= "string" then return end
	local tt = trunc(t)
	local old = rec.properties.text
	if old == tt then return end
	if not active() then
		Session.missed = Session.missed + 1
		return
	end
	rec.properties.text = tt
	rec.properties.last_changed_unix = os.time()
	-- detail panels (shop stats, pet/egg info...) show ONE selected item at a time: store the neighbouring
	-- texts (item name, price, stats) with the change so each stats text can be paired with its item.
	local extra
	if tt:find("%d") and hit(ancestorTokens(inst, 5), DETAIL_KW) then
		local panel = inst
		for _ = 1, 3 do
			if panel.Parent and panel.Parent ~= PlayerGui then panel = panel.Parent end
		end
		extra = { panel_texts = L(collectTexts(panel, 14)), maxPerKey = 400, minInterval = 0.3 }
	end
	Events.push("text_changed", inst, rec, "Text", old, tt, extra)
	-- propagate to modules that derive facts from texts
	Economy.onText(inst, t)
	Progression.onText(inst, t)
	local cur = inst
	for _ = 1, 6 do
		cur = cur.Parent
		if not cur then break end
		local recs = Store.byInstance[cur]
		if recs then
			for _, cat in ipairs(ITEM_CATS) do
				if recs[cat] then Items.refresh(cur, cat) end
			end
		end
	end
end

function Hooks.effectiveVisible(inst)
	local cur = inst
	local n = 0
	while cur and cur ~= PlayerGui and n < 40 do
		if cur:IsA("GuiObject") then
			if get(cur, "Visible") == false then return false end
		elseif cur:IsA("LayerCollector") then
			if get(cur, "Enabled") == false then return false end
		end
		cur = cur.Parent
		n = n + 1
	end
	return true
end

Queue.items, Queue.head, Queue.tail, Queue.dropped = {}, 1, 0, 0
Queue.set = setmetatable({}, { __mode = "k" })
Queue.removed = {}
function Queue.reset()
	Queue.items, Queue.head, Queue.tail = {}, 1, 0
	Queue.set = setmetatable({}, { __mode = "k" })
	Queue.removed = {}
end
function Queue.push(inst)
	if Queue.set[inst] or Store.seen[inst] then return end
	local cls = inst.ClassName
	if NOISE[cls] then
		Store.noiseCounts[cls] = (Store.noiseCounts[cls] or 0) + 1
		return
	end
	if inst.Parent and inst.Parent.ClassName == "Model" and inst:IsA("BasePart") then
		local key = "BasePart in Model (" .. cls .. ")"
		Store.noiseCounts[key] = (Store.noiseCounts[key] or 0) + 1
		return
	end
	if Queue.tail - Queue.head + 1 >= CONFIG.MAX_QUEUE then
		Queue.dropped = Queue.dropped + 1
		return
	end
	Queue.tail = Queue.tail + 1
	Queue.items[Queue.tail] = { inst, clock() }
	Queue.set[inst] = true
end
function Queue.process(budget)
	local t0 = clock()
	local n = 0
	while Queue.head <= Queue.tail and n < CONFIG.QUEUE_PER_STEP do
		local it = Queue.items[Queue.head]
		if t0 - it[2] < 0.2 then break end -- let children/attributes replicate first
		Queue.items[Queue.head] = nil
		Queue.head = Queue.head + 1
		local inst = it[1]
		Queue.set[inst] = nil
		local own = Session.ownGui
		if inst.Parent and not Store.seen[inst] and not (own and inst:IsDescendantOf(own)) and not insideExcluded(inst) then
			local ok, err = pcall(Visit.dynamic, inst)
			if not ok then Log.errOnce("queue", "dynamic visit: " .. tostring(err)) end
		end
		n = n + 1
		if clock() - t0 > budget then break end
	end
	if Queue.head > Queue.tail then Queue.head, Queue.tail = 1, 0 end
end


		local cut = #s - CONFIG.MAX_STRING
		s = s:sub(1, CONFIG.MAX_STRING)
		s = s:gsub("[\192-\255][\128-\191]*$", "")
		s = s .. "...[+" .. cut .. " bytes]"
	end
	return s
end

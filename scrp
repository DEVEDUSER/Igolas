local function sendWebhook(message)
    if webhookUrl == "" then
        notify("Webhook", "Coloque a URL primeiro.", 3)
        return
    end

    local req = http_request or request or syn and syn.request or fluxus and fluxus.request

    if not req then
        warn("Webhook nao suportado nesse executor.")
        notify("Webhook", "Seu executor nao suporta request/http_request.", 4)
        return
    end

    pcall(function()
        req({
            Url = webhookUrl,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
            },
            Body = HttpService:JSONEncode({
                content = tostring(message),
            }),
        })
    end)
end


local function countDict(tbl)
    local count = 0
    for _ in pairs(tbl or {}) do
        count += 1
    end
    return count
end

local function formatTime(seconds)
    seconds = math.floor(seconds)
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function normalizeRarity(name)
    return rarityAliases[name] or name
end

local function getItemData(invItem)
    if not invItem or not invItem.ItemId then return nil end

    local ok, data = pcall(function()
        return ItemData.Get(invItem.ItemId)
    end)

    return ok and data or nil
end

local function getRarityName(itemData)
    if not itemData or not itemData.Rarity then return nil end

    local ok, rarityName = pcall(function()
        return ItemData.GetRawRarityName(itemData.Rarity)
    end)

    return ok and normalizeRarity(rarityName) or nil
end

local function getBestPerkStat(invItem)
    local best = 0

    local function scan(value)
        if type(value) == "number" then
            if value > best then
                best = value
            end
        elseif type(value) == "table" then
            for _, v in pairs(value) do
                scan(v)
            end
        end
    end

    scan(invItem.Stats)
    scan(invItem.Stat)
    scan(invItem.Modifiers)
    scan(invItem.Boosts)
    scan(invItem.Multiplier)
    scan(invItem.Power)
    scan(invItem.Value)

    return best
end

local function isRareDrop(invItem)
    if not invItem then return false end

    local raw = tostring(invItem.ItemId or invItem.Id or invItem.Name or "")
    local lowered = string.lower(raw)

    return lowered:find("eggrain") ~= nil
        or lowered:find("egg rain") ~= nil
        or lowered:find("bombrain") ~= nil
        or lowered:find("bomb rain") ~= nil
        or lowered:find("bomb%-rain") ~= nil
end

local function favoriteOrLockItem(category, uniqueId)
    pcall(function()
        if RE:FindFirstChild("FavoriteItem") then
            RE.FavoriteItem:FireServer(category, uniqueId, true)
        elseif RE:FindFirstChild("LockItem") then
            RE.LockItem:FireServer(category, uniqueId, true)
        elseif RE:FindFirstChild("ToggleFavorite") then
            RE.ToggleFavorite:FireServer(category, uniqueId)
        elseif RF:FindFirstChild("FavoriteItem") then
            RF.FavoriteItem:InvokeServer(category, uniqueId, true)
        elseif RF:FindFirstChild("LockItem") then
            RF.LockItem:InvokeServer(category, uniqueId, true)
        elseif RF:FindFirstChild("ToggleFavorite") then
            RF.ToggleFavorite:InvokeServer(category, uniqueId)
        end
    end)
end

local function shouldSellItem(invItem, category)
    if not invItem then return false end
    if invItem.IsEquipped or invItem.IsFavorite or invItem.Locked then return false end

    local data = getItemData(invItem)
    local rarityName = getRarityName(data)

    return rarityName and sellRarities[category] and sellRarities[category][rarityName] == true
end

local function protectSpecialItems()
    local data = PlayerData.data
    if not data then return end

    for _, category in ipairs({ "Hats", "Pets", "Perks" }) do
        local storage = data[category]

        if storage then
            for uniqueId, invItem in pairs(storage) do
                if autoFavoriteRareDrops and isRareDrop(invItem) then
                    favoriteOrLockItem(category, uniqueId)
                    invItem.IsFavorite = true
                    invItem.Locked = true
                end

                if category == "Perks" and autoFavoriteGoodPerks then
                    local bestStat = getBestPerkStat(invItem)

                    if bestStat >= perkFavoriteMinStat then
                        favoriteOrLockItem(category, uniqueId)
                        invItem.IsFavorite = true
                        invItem.Locked = true
                    end
                end
            end
        end
    end
end

local function sellInventoryCategory(category)
    local data = PlayerData.data
    if not data then return end

    local storage = data[category]
    if not storage then return end

    local list = {}

    for uniqueId, invItem in pairs(storage) do
        if autoFavoriteRareDrops and isRareDrop(invItem) then
            favoriteOrLockItem(category, uniqueId)
            invItem.IsFavorite = true
            invItem.Locked = true
            continue
        end

        if category == "Perks" and autoFavoriteGoodPerks then
            local bestStat = getBestPerkStat(invItem)

            if bestStat >= perkFavoriteMinStat then
                favoriteOrLockItem(category, uniqueId)
                invItem.IsFavorite = true
                invItem.Locked = true
                continue
            end
        end

        if shouldSellItem(invItem, category) then
            table.insert(list, uniqueId)
        end
    end

    if (category == "Hats" or category == "Pets") and #list >= countDict(storage) then
        table.remove(list)
    end

    if #list <= 0 then return end

    local ok, result = pcall(function()
        return RF.SellItems:InvokeServer(list, category)
    end)

    if ok and result then
        Stats.itemsSold += #list

        if category == "Hats" then
            Stats.hatsSold += #list
        elseif category == "Pets" then
            Stats.petsSold += #list
        elseif category == "Perks" then
            Stats.perksSold += #list
        end

        notify("Auto Sell", "Vendeu " .. tostring(#list) .. " " .. tostring(category), 2)
    end
end

local function getNearestBox()
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end

    local field = BoxController.GetCurrentField(root.Position)
    if not field then return nil end

    local nearest
    local nearestDist = autoAttackRange
    local boxes = field.VisibleBoxes or field.Boxes or {}

    for _, box in pairs(boxes) do
        if box and box.CFrame and box.Health and box.Damage then
            if box.Health > box.Damage and not box.IsOpen then
                local dist = (box.CFrame.Position - root.Position).Magnitude

                if dist < nearestDist then
                    nearest = box
                    nearestDist = dist
                end
            end
        end
    end

    return nearest
end

local function getCameraBoxTarget()
    local camera = workspace.CurrentCamera
    local viewport = camera.ViewportSize
    local center = Vector2.new(viewport.X / 2, viewport.Y / 2)

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local field = root and BoxController.GetCurrentField(root.Position)
    if not field then return nil end

    local bestBox
    local bestScore = cameraScanRadius

    for _, box in pairs(field.VisibleBoxes or field.Boxes or {}) do
        if box and box.CFrame and box.Health and box.Damage then
            if box.Health > box.Damage and not box.IsOpen then
                local screenPos, onScreen = camera:WorldToViewportPoint(box.CFrame.Position)

                if onScreen and screenPos.Z > 0 then
                    local score = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude

                    if score < bestScore then
                        bestScore = score
                        bestBox = box
                    end
                end
            end
        end
    end

    return bestBox
end

local function buildRoutePoints(center, radius, step)
    local points = {}

    for x = -radius, radius, step do
        local row = {}

        for z = -radius, radius, step do
            if Vector3.new(x, 0, z).Magnitude <= radius then
                table.insert(row, center + Vector3.new(x, 0, z))
            end
        end

        if math.floor((x + radius) / step) % 2 == 1 then
            local reversed = {}

            for i = #row, 1, -1 do
                table.insert(reversed, row[i])
            end

            row = reversed
        end

        for _, point in ipairs(row) do
            table.insert(points, point)
        end
    end

    return points
end

local function startTPCameraRoute()
    if tpCameraRouteConn then
        tpCameraRouteConn:Disconnect()
        tpCameraRouteConn = nil
    end

    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    lockedCameraCenter = lockedCameraCenter or root.Position
    routePoints = buildRoutePoints(lockedCameraCenter, routeRadius, routeStep)
    currentRouteIndex = 1
    routeStuckSince = nil

    tpCameraRouteConn = RunService.Heartbeat:Connect(function()
        if not State.tpCamera then return end

        local charNow = player.Character
        local rootNow = charNow and charNow:FindFirstChild("HumanoidRootPart")
        local humanoidNow = charNow and charNow:FindFirstChildOfClass("Humanoid")
        if not rootNow or not humanoidNow or #routePoints == 0 then return end

        local target = routePoints[currentRouteIndex]
        local flatRoot = Vector3.new(rootNow.Position.X, lockedCameraCenter.Y, rootNow.Position.Z)
        local flatTarget = Vector3.new(target.X, lockedCameraCenter.Y, target.Z)
        local distToTarget = (flatRoot - flatTarget).Magnitude

        if distToTarget <= routeReachDistance then
            currentRouteIndex += 1

            if currentRouteIndex > #routePoints then
                currentRouteIndex = 1
            end

            target = routePoints[currentRouteIndex]
        end

        humanoidNow:MoveTo(target)

        local distFromCenter = (flatRoot - lockedCameraCenter).Magnitude
        local outsideArea = distFromCenter > routeRadius + 12
        local tooFarFromTarget = distToTarget > routeOffDistance

        if outsideArea or tooFarFromTarget then
            routeStuckSince = routeStuckSince or os.clock()

            if os.clock() - routeStuckSince >= 5 then
                rootNow.CFrame = CFrame.new(target + Vector3.new(0, 3, 0))
                routeStuckSince = nil
            end
        else
            routeStuckSince = nil
        end
    end)
end

local function stopTPCameraRoute()
    if tpCameraRouteConn then
        tpCameraRouteConn:Disconnect()
        tpCameraRouteConn = nil
    end

    routeStuckSince = nil
end

local function getAreaModel(index)
    local areas = workspace:FindFirstChild("Areas")
    if not areas then return nil end

    local prefix = tostring(index) .. "_"

    for _, area in ipairs(areas:GetChildren()) do
        if tostring(area.Name):sub(1, #prefix) == prefix then
            return area
        end
    end

    return areas:FindFirstChild(tostring(index))
end

local function getModelCenter(model)
    if not model then return nil end

    local ok, cf = pcall(function()
        return model:GetPivot()
    end)

    if ok and cf then
        return cf.Position
    end

    local part = model:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function startFarmAreaRoute()
    if farmAreaRouteConn then
        farmAreaRouteConn:Disconnect()
        farmAreaRouteConn = nil
    end

    local area = getAreaModel(farmAreaIndex)
    farmAreaCenter = getModelCenter(area)

    if not farmAreaCenter then
        notify("Area Farm", "Area nao encontrada: " .. tostring(farmAreaIndex), 3)
        return
    end

    local char = player.Character or player.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")

    root.CFrame = CFrame.new(farmAreaCenter + Vector3.new(0, 4, 0))

    farmAreaPoints = buildRoutePoints(farmAreaCenter, farmAreaRadius, farmAreaStep)
    farmAreaPointIndex = 1
    farmAreaStuckSince = nil
    State.autoAttackBoxes = true

    farmAreaRouteConn = RunService.Heartbeat:Connect(function()
        if not autoFarmArea then return end

        local charNow = player.Character
        local rootNow = charNow and charNow:FindFirstChild("HumanoidRootPart")
        local humanoidNow = charNow and charNow:FindFirstChildOfClass("Humanoid")
        if not rootNow or not humanoidNow or #farmAreaPoints == 0 then return end

        local target = farmAreaPoints[farmAreaPointIndex]
        local flatRoot = Vector3.new(rootNow.Position.X, farmAreaCenter.Y, rootNow.Position.Z)
        local flatTarget = Vector3.new(target.X, farmAreaCenter.Y, target.Z)
        local dist = (flatRoot - flatTarget).Magnitude

        if dist <= farmAreaReachDistance then
            farmAreaPointIndex += 1

            if farmAreaPointIndex > #farmAreaPoints then
                farmAreaPointIndex = 1
            end

            target = farmAreaPoints[farmAreaPointIndex]
        end

        humanoidNow:MoveTo(target)

        local distFromCenter = (flatRoot - farmAreaCenter).Magnitude

        if distFromCenter > farmAreaRadius + farmAreaTeleportBackDistance then
            farmAreaStuckSince = farmAreaStuckSince or os.clock()

            if os.clock() - farmAreaStuckSince >= 5 then
                rootNow.CFrame = CFrame.new(target + Vector3.new(0, 4, 0))
                farmAreaStuckSince = nil
            end
        else
            farmAreaStuckSince = nil
        end
    end)

    notify("Area Farm", "Farmando area " .. tostring(farmAreaIndex), 3)
end

local function stopFarmAreaRoute()
    if farmAreaRouteConn then

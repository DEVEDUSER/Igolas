AutoAttackTab:CreateToggle({
    Name = "Auto Attack Camera Lock",
    CurrentValue = false,
    Flag = "AutoAttackCameraLock",
    Callback = function(v)
        State.autoAttackCameraLock = v
        local camera = workspace.CurrentCamera

        if v then
            local char = player.Character or player.CharacterAdded:Wait()
            local root = char:WaitForChild("HumanoidRootPart")
            lockedCameraCenter = lockedCameraCenter or root.Position
            root.CFrame = CFrame.new(lockedCameraCenter + Vector3.new(0, 3, 0))
            camera.CameraType = Enum.CameraType.Scriptable

            if camAttackConn then camAttackConn:Disconnect() end
            local angle = 0

            camAttackConn = RunService.RenderStepped:Connect(function(dt)
                if not State.autoAttackCameraLock then return end
                angle = angle + dt * cameraSpinSpeed
                local x = math.cos(angle) * 10
                local z = math.sin(angle) * 10
                camera.CFrame = CFrame.new(lockedCameraCenter + Vector3.new(x, 4, z), lockedCameraCenter)
            end)

            State.tpCamera = true
            startTPCameraRoute()
        else
            if camAttackConn then camAttackConn:Disconnect() camAttackConn = nil end
            camera.CameraType = Enum.CameraType.Custom
            State.tpCamera = false
            stopTPCameraRoute()
        end
    end
})


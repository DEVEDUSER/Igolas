    return count
end

local function getItemData(invItem)
    if not invItem or not invItem.ItemId then return nil end

    local ok, data = pcall(function()
        return ItemData.Get(invItem.ItemId)
    end)

    if ok then return data end
    return nil
end

local function getRarityName(itemData)
    if not itemData or not itemData.Rarity then return nil end

    local ok, rarityName = pcall(function()
        return ItemData.GetRawRarityName(itemData.Rarity)
    end)

    if ok then
        return rarityAliases[rarityName] or rarityName
    end

    return nil
end

local function getBestPerkStat(invItem)
    local best = 0

    local allowedKeys = {
        stat = true,
        stats = true,
        boost = true,
        boosts = true,
        multiplier = true,
        multipliers = true,
        amount = true,
        value = true,
        values = true,
        percent = true,
        percentage = true,
        modifier = true,
        modifiers = true,
    }

    local blockedKeys = {
        id = true,
        uid = true,
        uniqueid = true,
        itemid = true,
        level = true,
        xp = true,
        exp = true,
        time = true,
        timestamp = true,
        created = true,
        equipped = true,
        slot = true,
        price = true,
        cost = true,
        seed = true,
    }

    local function keyAllowed(key)
        key = string.lower(tostring(key or ""))

        for blocked in pairs(blockedKeys) do
            if key:find(blocked) then
                return false
            end
        end

        for allowed in pairs(allowedKeys) do
            if key:find(allowed) then
                return true
            end
        end

        return false
    end

    local function scan(value, key)
        if type(value) == "number" then
            if keyAllowed(key) and value >= perkFavoriteMinStat and value <= 100 then
                if value > best then best = value end
            end
        elseif type(value) == "table" then
            for k, v in pairs(value) do
                scan(v, k)
            end
        end
    end

    scan(invItem, "root")
    return best
end

local function isRareDrop(invItem)
    if not invItem then return false end
    local txt = string.lower(tostring(invItem.ItemId or invItem.Id or invItem.Name or ""))

    return txt:find("eggrain")
        or txt:find("egg rain")
        or txt:find("bombrain")
        or txt:find("bomb rain")
        or txt:find("bomb%-rain")
end


-- LER ITENS: every ModuleScript under ReplicatedStorage.Items (Weapon/Pet/Hat/Misc/Perk...) read as a TABLE,
-- exactly like the data modules above: no game function is called. One file per category (split every ~3 MB).
function ModuleReader._runItems()
	local root = ReplicatedStorage:FindFirstChild("Items")
	if not root then
		Log.warn("ReplicatedStorage.Items n\u{E3}o encontrado.")
		return
	end
	local stamp = os.date("!%Y%m%d_%H%M%S")
	local dir = FSapi.ensureDir(CONFIG.EXPORT_DIR)
	local sub = FSapi.ensureDir(CONFIG.EXPORT_DIR .. "/items_" .. stamp)
	if sub ~= "" then dir = sub end
	local index = { kind = "items_modules_dump", created = Util.iso(), place_id = tostring(game.PlaceId), categories = {},
		rules = "read-only: module tables only, no game function called, no remote touched" }
	local totalEntries, GLOBAL_MAX = 0, 3000000
	local t0 = clock()
	for _, cat in ipairs(root:GetChildren()) do
		local mods = {}
		if cat:IsA("ModuleScript") then mods[1] = cat end
		for _, d in ipairs(cat:GetDescendants()) do
			if d:IsA("ModuleScript") then mods[#mods + 1] = d end
		end
		table.sort(mods, function(a, b) return path(a) < path(b) end)
		local row = { category = cat.Name, modules = #mods, read_ok = 0, failed = {}, functions_only = {}, files = {} }
		local parts, size, partN = {}, 0, 0
		local safeName = tostring(cat.Name):gsub("[^%w_%-]", "_")
		local function flush()
			if #parts == 0 then return end
			partN = partN + 1
			local fname = string.format("%sItems_%s_p%02d.json", dir, safeName, partN)
			local data = '{"category":' .. Json.encode(cat.Name) .. ',"part":' .. partN .. ',"modules":{' .. table.concat(parts, ",") .. "}}"
			local okW, status = FSapi.write(fname, data)
			row.files[#row.files + 1] = { file = fname, chars = #data, write = okW and status or ("FAILED: " .. tostring(status)) }
			parts, size = {}, 0
			task.wait()
		end
		for _, m in ipairs(mods) do
			if totalEntries >= GLOBAL_MAX then
				row.stopped = "global entry budget reached"
				break
			end
			local rel = path(m)
			rel = rel:gsub("^ReplicatedStorage%.Items%.", "")
			local ok, res = safeRequire(m)
			if not ok then
				row.failed[#row.failed + 1] = { module = rel, error = tostring(res) }
			elseif type(res) ~= "table" then
				row.failed[#row.failed + 1] = { module = rel, error = "returned " .. typeof(res) }
			else
				local st = { n = 0, functions = 0, over = false, stack = {} }
				local okS, snap = pcall(snapshot, res, st, 0)
				if okS then
					row.read_ok = row.read_ok + 1
					totalEntries = totalEntries + st.n
					if st.n - st.functions <= 0 then row.functions_only[#row.functions_only + 1] = rel end
					local enc = Json.encode({ entries = st.n, functions_not_called = st.functions, truncated = st.over, data = snap })
					parts[#parts + 1] = Json.encode(rel) .. ":" .. enc
					size = size + #enc + #rel + 4
					if size >= 3000000 then flush() end
				else
					row.failed[#row.failed + 1] = { module = rel, error = tostring(snap) }
				end
			end
			if clock() - t0 > CONFIG.FRAME_BUDGET then
				task.wait()
				t0 = clock()
			end
		end
		flush()
		index.categories[#index.categories + 1] = row
		Log.info(string.format("Itens/%s: %d/%d m\u{F3}dulos lidos, %d falha(s), %d s\u{F3} com fun\u{E7}\u{F5}es.", cat.Name, row.read_ok, row.modules, #row.failed, #row.functions_only))
	end
	FSapi.write(dir .. "_index.json", Json.encode(index))
	Log.info("Itens: conclu\u{ED}do. Pasta: " .. dir)
end

function ModuleReader.runItems()
	if ModuleReader.busy then
		Log.warn("Leitura de m\u{F3}dulos j\u{E1} em andamento.")
		return
	end
	if type(writefile) ~= "function" then
		Log.err("LER ITENS precisa de writefile, indispon\u{ED}vel neste executor.")
